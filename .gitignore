# ==========================================================
# 溜来（stock-agent）· Git 忽略规则
#
# 技术栈：微信小程序（原生 + TDesign）/ Python（FastAPI 网关 + LangGraph agent + ingest）/ Docker Compose
# 原则：只忽略「生成物」与「本机私有配置」；源码、SQL 迁移、依赖清单一律入库
# ==========================================================

# ===== 一、环境变量 / 密钥 =====
# 本地环境变量：含真实密钥，且每台机器不同，不入库。
# 本地 .env 由 server/config.py 兜底加载（真实环境变量优先、文件缺失不算错误）
.env
.env.*
!.env.example
!.env.production.example
server/.env
server/.env.local

# ===== 二、微信小程序 =====
# npm 依赖
node_modules/
stock-agent-miniapp/node_modules/
# 「构建 npm」产物：开发者工具生成，每次构建都会重写
stock-agent-miniapp/miniprogram_npm/
# 开发者工具个人配置（编译选项、断点等，每人不同）
project.private.config.json
stock-agent-miniapp/project.private.config.json
# 误生成在仓库根的 project.config.json：真正的那份在 stock-agent-miniapp/ 下且已入库
/project.config.json

# ===== 三、后端运行时产物 =====
# 头像等用户数据，随运行生成，不入库（仓库根与 server/ 两处历史位置都兜住）
/uploads/
server/uploads/
# 临时目录与冒烟产物（混进向量库会污染 RAG 检索）
server/tmp/
server/tmp_smoke/

# ===== 四、Python =====
# 字节码
__pycache__/
*.py[cod]
*.pyo
# 虚拟环境
.venv/
venv/
env/
# 工具缓存
.ruff_cache/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/
# 打包产物
*.egg-info/
dist/
build/
# ingest 的本地文档监听目录（放待入库的原始文档，是数据不是源码）
ingest/data/
# 联调与评测产物：测试每次运行生成（原始事件流 + 可读报告，含真实回答与卡片载荷）
tests/benchmark/runs/
tests/**/agent_out_*.txt
tests/**/e2e_report.md
agent/agent_out_*.txt
agent/e2e_report.md

# ===== 五、日志与临时文件 =====
*.log
# 后台任务（dev.sh bg / bench.sh 手册）写的 pid 文件，本机状态，不入库
*.pid
logs/
*.tmp
*.bak
*.swp
*~
# 设计稿截图（Ardot 导出的临时产物，不属于源码）
.ardot-shots/
.screenshots/
# Playwright CLI 产物（快照/截图/视频，一次性调试产物）
# 注：浏览器自动化统一走 agent-browser，这里只是防止误用 playwright-cli 时污染仓库
.playwright-cli/

# ===== 六、Serena（代码索引 / 项目记忆）=====
# memories/ 与 project.yml 建议入库：跨机器共享 onboarding 结论。
# 下面是缓存与本机配置，Serena 自带的 .serena/.gitignore 已忽略，这里再兜一层
.serena/cache/
.serena/logs/
.serena/project.local.yml

# ===== 七、系统 / 编辑器 =====
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/

# UI 重构过程截图（本地产物，不入库）
stock-agent-miniapp/.restyle-shots/

.codebuddy
