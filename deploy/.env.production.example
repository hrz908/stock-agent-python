# 生产环境变量模板：cp .env.production.example .env 后填值
# 真实的 .env 不进仓库，只存在于服务器 /opt/stock-agent/deploy/.env
# 必填项留空待填；下面有默认值的选填项别清空（空字符串会原样注入容器，Python 端不回落默认值）

# ===== 必填 =====
ENV=prod
# 三个密码用 openssl rand -hex 生成，只用十六进制（特殊字符会破坏数据库 DSN）
JWT_SECRET=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# mp.weixin.qq.com → 开发管理 → 开发设置
WECHAT_APPID=
WECHAT_SECRET=
# 硅基流动，LLM 与 ASR 共用
OPENAI_API_KEY=

# ===== 数据库位置 =====
# 留空 = 用 compose 自带的 postgres 容器（postgres:5432，sslmode=disable），行为与迁移前一致。
# 迁腾讯云 PG 时填内网连接串（控制台 → 实例 → 内网地址），例如：
#   DATABASE_DSN=postgres://postgres:<云账号密码>@10.0.0.12:5432/stock_agent?sslmode=require
# 注意：密码只用十六进制/URL 安全字符；云上必须开 TLS（sslmode=require），
# 且实例安全组要放行业务服务器的内网 IP。连接串带 & 参数（如 sslrootcert）时，
# 整串要用单引号包起来，否则 backup.sh 读 .env 时会被 shell 当成后台执行符。
# 填错回滚：清空本项 + deploy.sh restart 即回到自带容器。
DATABASE_DSN=

# ===== 选填（保持默认值）=====
# 注意：OPENAI_API_BASE / OPENAI_API_KEY 同时服务 LLM、Embedding、Rerank 三类 API。
# 4核4G 服务器不装本地 torch（4B 模型单 FP16 权重就 8GB），三处 embedding 全走 API。
OPENAI_API_BASE=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
SMALL_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
# agent 检索用（在线）/ ingest 写库用（离线）；两者必须同模型同维度，否则向量空间不一致
ONLINE_EMBED_MODEL=Qwen/Qwen3-Embedding-4B
OFFLINE_EMBED_MODEL=Qwen/Qwen3-Embedding-4B
# 4B 默认 2560，显式降到 1536：>2000 的 vector 列建不了 HNSW 索引
EMBED_DIM=1536
# 入库后淘汰原始 PDF：全市场年报一年 60~120GB，库里向量 + 解析副本每块才 ~20KB。
# 淘汰前会把解析出的 Markdown 落到 PARSED_DIR，reembed 优先用原件、其次用副本；
# 设 false 保留原件（调试期建议 false）。
DELETE_RAW_AFTER_INGEST=true
# 解析副本目录，与 compose 的 parseddata 卷挂载点一致，改动需同步
PARSED_DIR=/data/parsed
RAG_THRESHOLD=0.2
# 重排：交叉编码器给 query↔chunk 打分，命中闸用它而不是余弦（余弦地板值太高，切不开）
RERANK_ENABLED=true
RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
RERANK_CANDIDATES=20
RERANK_THRESHOLD=0.5
# 进上下文的片段数（上线数量）；取值用 tests/benchmark/sweep_retrieval.py 实测决定
# 2026-10-26 sweep（120 正/20 负，N=100）：k=8 的 Hit 比 k=6 高 2.5pt
RAG_TOP_K=8
# 同时进行中的重排请求上限：N=100 时 4 路并发会被上游 429，失败后静默回退 RRF
RERANK_CONCURRENCY=2
# 同一文档最多进几块（按 doc_id 限流；年报/公告标题重复，按标题限流会误伤）
RAG_PER_DOC=3
# true 时按 RERANK_THRESHOLD 再裁一次上下文（低分片段不进 prompt/sources）
RAG_RERANK_FILTER=false
# 工具结果进程内缓存（秒）：取数工具只读、按日更新，命中即省掉一次 akshare 网络往返；
# 0 关闭。同一轮并发执行几个工具，akshare 走线程池，别开太大
TOOL_CACHE_TTL=300
# 盘口类（行情/估值/资金流/同业快照）单独一档，30s 与 Go 侧行情缓存对齐；
# 套用 300s 会让用户看到旧价
TOOL_CACHE_TTL_REALTIME=30
TOOL_CONCURRENCY=4
# 单轮工具总预算（秒）：超过即按超时降级，用已完成的结果作答。
# 默认 8 与单工具超时对齐，只砍「失败后重试」造成的翻倍长尾；压到 5~6 会更快，
# 代价是慢速历史行情可能被截断。0 关闭（恢复等全部完成）
TOOL_ROUND_BUDGET=8
# 连接池上限：云 PG 的 max_connections 是实例全局上限，这几个池 × 容器副本数不能超过它。
# agent：只读取数池 + checkpointer 池；Go server：GORM 池。小规格云实例按默认值即可
DB_RO_POOL_MAX=4
CHECKPOINT_POOL_MAX=4
DB_MAX_OPEN_CONNS=25
# 决策类小模型（改写/分类/判读/澄清/摘要）是否开启思考。生产小模型同为 DeepSeek，
# 开着推理会让每次判读多等几百毫秒到数秒；置 true 可回滚为上游默认
SMALL_LLM_ENABLE_THINKING=false
JWT_TTL=168h
ALLOW_ORIGINS=*

# 企业微信提醒推送：三项齐全才生效
WECOM_CORP_ID=
WECOM_SECRET=
WECOM_AGENT_ID=

# 群机器人 Webhook（群设置 → 群机器人 → 添加）；不需要可信 IP，可与应用消息并存
WECOM_WEBHOOK=

# ===== A股文本语料（可选 profile ashare）=====
# 1 = 构建带 torch 的镜像（本地跑 embedding）；纯 API 模式设 0，镜像小几百 MB、构建也快
ASHARE_INSTALL_EMBED=0
# 纯 API 模式下以下三项均不需要（ashare embedder 直接走 API 分支）
# ASHARE_MODEL_DIR=../models
# ASHARE_MODEL_NAME=Qwen3-Embedding-4B
# whitelist：只抓重要公告正文；all：全部；none：只入库标题（不建议）
ASHARE_ANNOUNCEMENT_PDF_MODE=whitelist
ASHARE_FETCH_REPORT_PDF=true
# 单次运行 PDF 解析上限（定期报告不计入），按 CPU 能力调
ASHARE_PDF_MAX_PER_RUN=300
# 个股新闻必须显式给代码，留空则只跑市场级快讯
ASHARE_NEWS_CODES=
# 国务院政策文件库：gw=国务院文件，bm=部门文件
ASHARE_GOV_TYPES=gw,bm
