@import "../_card.wxss";

/* 卡片标题居中：与 _card.wxss 的共享规则同源；写在组件自身 wxss 里，
   避免修改 @import 进来的文件时开发者工具不热更新导致不生效 */
.fcard-title-col,
.fcard-name,
.fcard-code {
  text-align: left;
}

/* 底部说明（事件来源）左对齐 */
.fnote {
  text-align: left;
}

/* 时间轴行：圆点 + 内容。
   ::before 画一条贯穿到下一行的竖线，把孤立圆点连成真正的时间轴；
   末条不画（:last-child 是结构伪类，非 WXSS 禁用项） */
.evt {
  position: relative;
  display: flex;
  gap: var(--gap-grid);
  margin-top: var(--sp-3);
}

.evt::before {
  content: '';
  position: absolute;
  left: 7rpx;
  top: 24rpx;
  bottom: calc(-1 * var(--sp-3));
  width: 2rpx;
  background: var(--line);
}

.evt:last-child::before {
  display: none;
}

/* 圆点：金色=需关注，蓝色=常规（视觉稿规格） */
.evt-dot {
  flex: none;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-top: var(--sp-1);
}

/* 需关注：琥珀色（金色在白底上对比度不足，降一档到琥珀仍保留「提醒」语义）；
   常规：浅蓝。两者都不与涨跌红绿冲突 */
.evt-dot--gold {
  background: var(--warn);
  box-shadow: 0 0 0 6rpx var(--warn-tint);
}

.evt-dot--blue {
  /* 常规事件：中性灰。与「需关注=琥珀」配对，默认态用中性色，
     不再占用强调蓝（shadcn 状态表达：默认中性 + 单状态色） */
  background: var(--ink-3);
}

.evt-body {
  flex: 1;
  min-width: 0;
}

.evt-t {
  font-size: var(--fs-body);
  line-height: 1.5;
  color: var(--ink);
}

/* 事件标题：与类型标签同字号但字重略高，撑起层次 */
.evt-title {
  font-weight: 500;
  color: var(--ink);
}

/* 事件类型小标签（财报 / 解禁 / 回购…） */
.evt-type {
  display: inline-block;
  margin-right: var(--sp-1);
  padding: 4rpx 12rpx;
  border-radius: var(--r-tag);
  border: var(--hairline);
  background: var(--surface-2);
  font-size: var(--fs-min);
  color: var(--ink-2);
  vertical-align: middle;
}

.evt-s {
  margin-top: var(--sp-1);
  font-size: var(--fs-aux);
  line-height: 1.6;
  color: var(--ink-3);
}

.evt-foot {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  margin-top: var(--sp-1);
}

.evt-date {
  font-size: var(--fs-min);
  color: var(--ink-3);
}

/* 原文链接：复制 */
.evt-src {
  font-size: var(--fs-min);
  color: var(--accent);
  text-decoration: underline;
  display: inline-flex; align-items: center; min-height: 88rpx;
}

/* 时间轴内容全部左对齐（标题 / 描述 / 正文），日期与原文链接靠左成组 */
.evt-body {
  text-align: left;
}

.evt-foot {
  justify-content: flex-start;
}
