/* 金融卡共享外壳：8 张卡共用（各卡 wxss 用 @import 引入，
   避免每张卡重复一遍基础样式）。
   视觉规格对齐设计稿与 HTML 预览：--surface 卡面 / --line 描边 /
   16px 圆角 / 14px 内边距；数字一律配 .num 等宽（styles/base.wxss）。 */
.fcard {
  width: 100%;
  box-sizing: border-box;
  padding: var(--pad-card);
  background: var(--surface);
  border: var(--hairline);
  border-radius: var(--r-card);
  /* shadcn：卡片默认无阴影（--shadow-card 已置 none），层次靠发丝边框 */
  box-shadow: var(--shadow-card);
}

.fcard-hd {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--gap-grid);
}

/* 头部左侧标题列（名称 + 代码）：占满剩余宽度并允许收缩，
   避免长名称把右侧标签挤出可视区；8 张卡共用 */
.fcard-title-col {
  flex: 1;
  min-width: 0;
}

/* 等宽数字：全局 .num 定义在 styles/base.wxss，组件样式隔离下 class 不透传，
   8 张卡里 33 处 class="num" 此前全部失效（数值仍会跳动），按隔离规则在此复写。
   .up/.down/.flat 下面那份同理 */
.num {
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum" 1;
}

/* 主标题：不裁剪不截断（需求：卡片信息不要 overflow）——超长名称换行完整显示 */
.fcard-name {
  font-size: var(--fs-title);
  font-weight: 600;
  line-height: 1.2;
  color: var(--ink);
  word-break: break-word;
}

.fcard-code {
  margin-top: var(--sp-1);
  font-size: var(--fs-aux);
  color: var(--ink-3);
  word-break: break-word;
}

/* 数据栅格：一条顶部分隔线 + 两行三列（设计稿 3 列 × 2 行） */
.fgrid {
  display: flex;
  flex-direction: column;
  margin-top: var(--sp-card);
  padding-top: var(--sp-3);
  border-top: var(--hairline);
}

/* 无顶线的变体（卡片头部下方直接跟栅格时用） */
.fgrid--flat {
  border-top: none;
  padding-top: 0;
}

.fgrid-row {
  display: flex;
  gap: var(--gap-grid);

/* 行间距用显式类名，不用兄弟选择器（WXSS 禁用） */}
.fgrid-row--gap {
  margin-top: var(--gap-grid);
}

.fcell {
  flex: 1;
  min-width: 0;
  }

.fcell-k {
  font-size: var(--fs-min);
  color: var(--ink-3);
}

.fcell-v {
  margin-top: var(--sp-1);
  font-size: var(--fs-body);
  color: var(--ink);
}

/* 底部说明：数据日期 / 来源 / 备注（口径类文案已按需求全部移除） */
.fnote {
  margin-top: var(--sp-3);
  padding-top: var(--sp-2);
  border-top: var(--hairline-dashed);
  font-size: var(--fs-min);
  line-height: 1.75;
  color: var(--ink-3);
}

/* 来源机构名 / 原文链接入口 */
.fnote-src {
  color: var(--ink-2);
}

/* 红涨绿跌（国内习惯）：组件内样式隔离，不会渗到页面 */
.up {
  color: var(--up);
}

.down {
  color: var(--down);
}

.flat {
  color: var(--flat);
}

/* ---- 卡内信息统一「等距居中」（8 张卡共用） ----
   居中：所有指标栅格（行情两行、K 线区间涨幅行、估值两行、财报毛利率行、
        研报机构评级行）一律每格居中。
   等距：横向由 .fcell 的 flex:1 + .fgrid-row 的 gap 均分；
        纵向沿用各块既有 margin 与 .fnote 的 line-height。
   注：上一版做过「首格左 / 末格右」，用户看过后收回——栅格统一居中，
        只有价格行、支撑压力行这类「整行文案」才用左右 / 靠左对齐。 */
.fcell-k,
.fcell-v {
  text-align: center;
}

/* 底部说明（数据日期 / 来源等）左对齐 */
.fnote {
  text-align: left;
}

/* ---- 卡片标题对齐（8 张卡共用）----
   标题与副标题统一左对齐（默认呈现）；右上角 tag 已移除，头部只剩标题列，
   故 .fcard-hd 的 justify-content 回到 flex-start；
   两者间距沿用 .fcard-code 的 --sp-1，保持等距。 */
.fcard-hd {
  justify-content: flex-start;
}

.fcard-title-col {
  text-align: left;
}

.fcard-name,
.fcard-code {
  text-align: left;
}
