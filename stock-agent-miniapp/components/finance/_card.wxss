/* 金融卡共享外壳：8 张卡共用（各卡 wxss 用 @import 引入，
   避免每张卡重复一遍基础样式）。
   无边框 / 无底色 / 无内边距：卡片内容与 AI 正文共用同一条左边缘，
   层次由浅底数据栅格与出血的走势线分段，不再靠「框」切块。
   数字一律配 .num 等宽（组件隔离下不透传，见下方 .num 复写）。 */
.fcard {
  width: 100%;
  box-sizing: border-box;
}

.fcard-hd {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--gap-grid);
}

/* 头部左侧标题列（名称 + 代码）：占满剩余宽度并允许收缩，
   避免长名称把右侧标签挤出可视区；8 张卡共用 */
.fcard-title-col {
  flex: 1;
  min-width: 0;
}

/* 等宽数字：全局 .num 定义在 styles/base.wxss，组件样式隔离下 class 不透传，
   8 张卡里 33 处 class="num" 此前全部失效（数值仍会跳动），按隔离规则在此复写。
   .up/.down/.flat 下面那份同理 */
.num {
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum" 1;
}

/* 主标题：不裁剪不截断（需求：卡片信息不要 overflow）——超长名称换行完整显示 */
.fcard-name {
  font-size: var(--fs-title);
  font-weight: 600;
  line-height: 1.2;
  color: var(--ink);
  word-break: break-word;
}

.fcard-code {
  margin-top: var(--sp-1);
  font-size: var(--fs-aux);
  color: var(--ink-3);
  word-break: break-word;
}

/* 数据栅格：浅底块包住两行三列（设计稿 3 列 × 2 行）。
   浅底是卡片唯一的「面」：卡片外壳已去边框，靠它把一组指标收成一块。 */
.fgrid {
  display: flex;
  flex-direction: column;
  margin-top: var(--sp-3);
  padding: var(--sp-3);
  background: var(--surface-2);
  border-radius: var(--r-tag);
}

/* 头部下方直接跟栅格时（估值卡）收紧一档 */
.fgrid--flat {
  margin-top: var(--sp-2);
}

.fgrid-row {
  display: flex;
  gap: var(--gap-grid);
}

/* 行间距用显式类名，不用兄弟选择器（WXSS 禁用） */
.fgrid-row--gap {
  margin-top: var(--gap-grid);
}

.fcell {
  flex: 1;
  min-width: 0;
}

.fcell-k {
  font-size: var(--fs-min);
  color: var(--ink-3);
}

.fcell-v {
  margin-top: var(--sp-1);
  font-size: var(--fs-body);
  color: var(--ink);
}

/* 底部说明：数据日期 / 来源 / 备注（口径类文案已按需求全部移除） */
.fnote {
  margin-top: var(--sp-3);
  padding-top: var(--sp-2);
  border-top: var(--hairline-dashed);
  font-size: var(--fs-min);
  line-height: 1.75;
  color: var(--ink-3);
}

/* 来源机构名 / 原文链接入口 */
.fnote-src {
  color: var(--ink-2);
}

/* 红涨绿跌（国内习惯）：组件内样式隔离，不会渗到页面 */
.up {
  color: var(--up);
}

.down {
  color: var(--down);
}

.flat {
  color: var(--flat);
}

/* ---- 卡内栅格统一左对齐（8 张卡共用） ----
   标签与数值都贴本格左边缘：同一列的上下两格共用一条竖线，
   数字才能顺着列往下读；居中会让每格自成一坨，横竖都不成线。 */
.fcell-k,
.fcell-v {
  text-align: left;
}

/* 底部说明（数据日期 / 来源等）左对齐 */
.fnote {
  text-align: left;
}

/* ---- 卡片标题对齐（8 张卡共用）----
   标题与副标题统一左对齐（默认呈现）；右上角 tag 已移除，头部只剩标题列，
   故 .fcard-hd 的 justify-content 回到 flex-start；
   两者间距沿用 .fcard-code 的 --sp-1，保持等距。 */
.fcard-hd {
  justify-content: flex-start;
}

.fcard-title-col {
  text-align: left;
}

.fcard-name,
.fcard-code {
  text-align: left;
}
