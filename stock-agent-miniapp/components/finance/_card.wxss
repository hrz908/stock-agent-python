/* 金融卡共享外壳：8 张卡共用（各卡 wxss 用 @import 引入，
   避免每张卡重复一遍基础样式）。
   视觉规格对齐设计稿与 HTML 预览：--bg-card 卡面 / --border 描边 /
   --shadow-sm 投影 / --radius-card 圆角 / --space-lg 内边距；
   数字一律配 .num 等宽（styles/base.wxss）。
   页面底同为纯白，卡面靠「描边 + 最轻投影」这一套浮起（DESIGN.md · 形状） */
.fcard {
  width: 100%;
  box-sizing: border-box;
  padding: var(--space-lg);
  background: var(--bg-card);
  border: var(--hairline);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-sm);
}

.fcard-hd {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-md);
}

/* 头部左侧标题列（名称 + 代码）：占满剩余宽度并允许收缩，
   避免长名称把右侧标签挤出可视区；8 张卡共用 */
.fcard-title-col {
  flex: 1;
  min-width: 0;
}

/* 等宽数字：全局 .num 定义在 styles/base.wxss，组件样式隔离下 class 不透传，
   8 张卡里 33 处 class="num" 此前全部失效（数值仍会跳动），按隔离规则在此复写。
   .up/.down/.flat 下面那份同理 */
.num {
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum" 1;
}

/* 卡主标题（左上角）：大号 --font-lg（36rpx）+ 700 加黑，8 张卡统一。
   字号封顶 --font-xl（40rpx）：卡内焦点数字才用上限档，标题靠 700 与 --text-primary 主色拿权重，
   不靠字号（2026-10-26 令牌收敛，display 档已取消）。
   不裁剪不截断（需求：卡片信息不要 overflow）——超长名称换行完整显示 */
.fcard-name {
  font-size: var(--font-lg);
  font-weight: var(--fw-medium);
  line-height: 1.2;
  color: var(--text-primary);
  word-break: break-word;
}

/* 副标题 / 别名行（代码、日期·类型、口径）：全局标准（2026-10-26 用户指定，
   由小号抬一档：标题抬到超大号后，代码行留在小号会显得脱节）。
   8 张卡共用，不要再各卡改档 */
.fcard-code {
  margin-top: var(--space-xs);
  font-size: var(--font-base);
  color: var(--text-secondary);
  word-break: break-word;
}

/* 数据栅格：一条顶部分隔线 + 两行三列（设计稿 3 列 × 2 行）。
   卡内纵向节奏比页面紧一档：栅格与上方数据只隔 sp-2，不再用 --space-lg */
.fgrid {
  display: flex;
  flex-direction: column;
  margin-top: var(--space-md);
  padding-top: var(--space-md);
  border-top: var(--hairline);
}

/* 无顶线的变体（卡片头部下方直接跟栅格时用） */
.fgrid--flat {
  border-top: none;
  padding-top: 0;
}

.fgrid-row {
  display: flex;
  gap: var(--space-md);
}

/* 行间距用显式类名，不用兄弟选择器（WXSS 禁用） */
.fgrid-row--gap {
  margin-top: var(--space-md);
}

.fcell {
  flex: 1;
  min-width: 0;
}

/* 指标键：标准（8 张卡统一，口径同 K 线卡的区间涨幅 / 振幅 / MA5 / 量比） */
.fcell-k {
  font-size: var(--font-base);
  color: var(--text-secondary);
}

.fcell-v {
  margin-top: var(--space-xs);
  font-size: var(--font-base);
  color: var(--text-primary);
}

/* 底部说明：数据日期 / 来源 / 备注（口径类文案已按需求全部移除）。
   行高收到 1.5：说明多为单行，1.75 只是把每行撑开 */
.fnote {
  margin-top: var(--space-md);
  padding-top: var(--space-xs);
  border-top: var(--hairline-dashed);
  font-size: var(--font-sm);
  line-height: 1.5;
  color: var(--text-secondary);
}

/* 来源机构名 / 原文链接入口 */
.fnote-src {
  color: var(--text-secondary);
}

/* 红涨绿跌（国内习惯）：组件内样式隔离，不会渗到页面 */
.up {
  color: var(--up);
}

.down {
  color: var(--down);
}

.flat {
  color: var(--flat);
}

/* ---- 卡内信息统一「等距居中」（8 张卡共用） ----
   居中：所有指标栅格（行情两行、K 线区间涨幅行、估值两行、财报毛利率行、
        研报机构评级行）一律每格居中。
   等距：横向由 .fcell 的 flex:1 + .fgrid-row 的 gap 均分；
        纵向沿用各块既有 margin 与 .fnote 的 line-height。
   注：上一版做过「首格左 / 末格右」，用户看过后收回——栅格统一居中，
        只有价格行、支撑压力行这类「整行文案」才用左右 / 靠左对齐。 */
.fcell-k,
.fcell-v {
  text-align: center;
}

/* 底部说明（数据日期 / 来源等）左对齐 */
.fnote {
  text-align: left;
}

/* ---- 卡片标题对齐（8 张卡共用）----
   标题与副标题统一左对齐（默认呈现）；右上角 tag 已移除，头部只剩标题列，
   故 .fcard-hd 的 justify-content 回到 flex-start；
   两者间距沿用 .fcard-code 的 --space-xs，保持等距。 */
.fcard-hd {
  justify-content: flex-start;
}

.fcard-title-col {
  text-align: left;
}

.fcard-name,
.fcard-code {
  text-align: left;
}
