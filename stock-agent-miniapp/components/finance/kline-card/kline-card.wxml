<!-- 走势与 K 线卡：K 线区高度 ≥180rpx，下方四列指标栅格；
     支撑 / 压力位左右对齐（支撑靠左、压力靠右），底部注释只留外部传入的 note。
     注：周期切换 chips（分时/5日/日K/周K/月K）已按需求移除，
     组件内 periods / activePeriod 与 onChipTap 逻辑保留但不再有入口触发。 -->
<view class="fcard card-class">
  <view class="fcard-hd">
    <view class="fcard-title-col">
      <!-- 标题优先级：外部指定 > 股票名 + 走势 > 兜底「K 线走势」 -->
      <view class="fcard-name">{{title || (name ? name + ' 走势' : 'K 线走势')}}</view>
      <view class="fcard-code num">{{code || subtitle}}</view>
    </view>

  </view>

  <!-- K 线图：SVG data-URI 背景（蜡烛 + MA + 成交量）；数据不足时不占位。
       带了 placeholder 的页面（自选K线）用空态占位顶住图区高度 -->
  <view wx:if="{{chartSrc}}" class="chart" style="background-image: url({{chartSrc}});"></view>
  <view wx:elif="{{placeholder}}" class="chart chart--empty">{{placeholder}}</view>

  <view class="fgrid">
    <view class="fgrid-row">
      <view class="fcell">
        <view class="fcell-k">区间涨幅</view>
        <view class="fcell-v num {{pctDir}}">{{pctText}}</view>
      </view>
      <view class="fcell">
        <view class="fcell-k">振幅</view>
        <view class="fcell-v num">{{amplitudeText}}</view>
      </view>
      <view class="fcell">
        <view class="fcell-k">MA5</view>
        <view class="fcell-v num">{{ma5Text}}</view>
      </view>
      <view class="fcell">
        <view class="fcell-k">量比</view>
        <view class="fcell-v num">{{volumeRatioText}}</view>
      </view>
    </view>
  </view>

  <!-- 支撑 / 压力：整行靠左，两项之间用「·」隔开（同行情卡底部「代码 · 状态」口径） -->
  <view class="sr-row">
    <text>支撑 <text class="num">{{supportText}}</text> · 压力 <text class="num">{{resistanceText}}</text></text>
  </view>

  <view wx:if="{{note}}" class="fnote">{{note}}</view>
</view>
