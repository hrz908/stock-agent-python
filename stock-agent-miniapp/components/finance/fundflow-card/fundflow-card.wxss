@import "../_card.wxss";

/* 卡片标题居中：与 _card.wxss 的共享规则同源；写在组件自身 wxss 里，
   避免修改 @import 进来的文件时开发者工具不热更新导致不生效 */
.fcard-title-col,
.fcard-name,
.fcard-code {
  text-align: left;
}

/* 底部说明（数据日期）左对齐 */
.fnote {
  text-align: left;
}

/* 主数字行：大号净流入 + 占成交额比 */
.flow-hd {
  display: flex;
  align-items: baseline; /* 第1条例外：标题与数值按文字基线排是有意选择（小数点对齐），非 line-height 撑居中 */
  justify-content: space-between;
  gap: var(--sp-2);
  margin-top: var(--sp-3);
}

/* 主数字 22px 级（--fs-value） */
.flow-big {
  font-size: var(--fs-value);
  font-weight: 700;
  line-height: 1.1;
}

.flow-pct {
  font-size: var(--fs-aux);
  color: var(--ink-3);
}

/* 四档列表：顶部分隔线，逐行展开 */
.flow-list {
  margin-top: var(--sp-3);
  border-top: var(--hairline);
}

/* 行高 72rpx：单行「标签 + 金额」，48px 一行会把四档拆得太开 */
.flow-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-2);
  min-height: 72rpx;
  border-bottom: var(--hairline);
  font-size: var(--fs-aux);
}

/* 最后一行不带分隔线（:last-child 是结构伪类，非 WXSS 禁用项） */
.flow-item:last-child {
  border-bottom: none;
}

.flow-k {
  color: var(--ink-2);
}

/* 数值不写 color：金额按正负着色（.up / .down 来自 _card.wxss），
   在这里写死 --ink 会以「后定义者胜」把着色整片盖掉。
   字号比标签大一档——金额才是这一行的信息 */
.flow-v {
  font-size: var(--fs-body);
}

.flow-spark {
  margin-top: var(--sp-3);
  height: 64rpx;
}

/* 龙虎榜 */
.lhb {
  margin-top: var(--sp-3);
}

.lhb-title {
  font-size: var(--fs-aux);
  color: var(--ink-3);
}

.lhb-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-2);
  margin-top: var(--sp-1);
  font-size: var(--fs-aux);
}

.lhb-seat {
  flex: 1;
  min-width: 0;
  color: var(--ink-2);
  word-break: break-word;        /* 不裁剪：长席位名（如「中信证券上海分公司」）完整换行显示 */
}

.lhb-vals {
  flex: none;
  display: flex;
  gap: var(--sp-2);
  width: 320rpx; text-align: right;
}

/* 资金流向数据改成「左右对齐」：名称 / 主数字靠左，数值 / 占比靠右。
   撤销此前的等宽居中（flex:1 + center）——容器 .flow-hd / .flow-item 本就是
   space-between，这里只需让子项恢复自适应宽度并按左右对齐。 */
.flow-big {
  flex: none;
  text-align: left;              /* 主力净流入靠左 */
}

.flow-pct {
  flex: none;
  text-align: right;             /* 占成交额比靠右 */
}

.flow-k {
  flex: none;
  text-align: left;              /* 超大单 / 大单 / 中单 / 小单 / 北向持股 靠左 */
}

.flow-v {
  flex: none;
  text-align: right;             /* 对应金额靠右 */
}

/* 「龙虎榜」标题：居中 */
.lhb-title {
  text-align: center;
}

/* 龙虎榜行（表格格式）：席位占 1/2 靠左，买 / 卖合计占另外 1/2，各列文字居中。
   .lhb-vals 与 .lhb-seat 同为 flex:1 → 各半；内部买、卖再各 flex:1 → 各占 1/4、格内居中。 */
.lhb-seat {
  flex: 1;                       /* 席位：整行 1/2 */
  text-align: left;              /* 席位名左对齐（表头「席位」同步左对齐） */
}

.lhb-vals {
  flex: 1;                       /* 买卖合计：整行 1/2（取消原固定 320rpx） */
  width: auto;
  gap: var(--gap-grid);
  text-align: center;
}

.lhb-vals text {
  flex: 1;                       /* +买入、-卖出 各占整行 1/4 */
  text-align: center;            /* 买入/卖出等距居中：各居其格中央（同数据栅格口径） */
}

/* 纵向等距：各块顶部间距统一为一档（卡内比页面紧一档） */
.flow-hd,
.flow-list,
.flow-spark,
.lhb {
  margin-top: var(--sp-2);
}

/* ===== 龙虎榜表格化 ===== */
/* 表头：复用列宽类，与数据行自动对齐；弱文字 + 发丝底线 */
.lhb-head {
  display: flex;
  align-items: center;
  gap: var(--sp-2);              /* 与 .lhb-row 的 gap 一致，保证列对齐 */
  margin-top: var(--sp-1);       /* 与「龙虎榜」标题的间距 */
  padding-bottom: var(--sp-1);
  border-bottom: var(--hairline);
  font-size: var(--fs-min);
  color: var(--ink-3);
}

/* 表头对齐与数据行一致：
   「席位」跟随 .lhb-seat 的左对齐；「买入 / 卖出」跟随 .lhb-vals text 的居中对齐。
   这里不再覆盖 text-align。 */
.lhb-head .lhb-seat {
  color: var(--ink-3);           /* 覆盖 .lhb-seat 的 --ink-2，表头用弱文字 */
  font-weight: 400;
}

/* 数据行：行间发丝分隔线，最后一行不画底线 */
.lhb-row {
  margin-top: 0;
  padding: var(--sp-1) 0;        /* 行距改由 padding 给，分隔线之间等距 */
  border-bottom: var(--hairline);
}

.lhb-row:last-child {
  border-bottom: none;
}
