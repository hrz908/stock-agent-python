@import "../_card.wxss";

/* 卡片标题对齐：与 _card.wxss 的共享规则同源；写在组件自身 wxss 里，
   避免修改 @import 进来的文件时开发者工具不热更新导致不生效 */
.fcard-title-col,
.fcard-name,
.fcard-code {
  text-align: left;
}

.fnote {
  text-align: left;
}

/* 主数字行：大号净流入 + 占成交额比 */
.flow-hd {
  display: flex;
  align-items: baseline; /* 第1条例外：标题与数值按文字基线排是有意选择（小数点对齐），非 line-height 撑居中 */
  justify-content: space-between;
  gap: var(--space-md);
  margin-top: var(--space-lg);
}

/* 主力净流入 = --font-xl（40rpx，字号上限）+ 700：本卡唯一的大数字。
   与行情卡主价同一口径（2026-10-26 令牌收敛：display 档取消，焦点数字封顶 40rpx）。
   「1.29亿」字数少，和右侧「占成交额 +4.20%」同排不会挤（最大档已验算） */
.flow-big {
  font-size: var(--font-xl);
  font-weight: 600;
  line-height: 1.1;
}

.flow-pct {
  font-size: var(--font-base);
  color: var(--ink-3);
}

/* 四档列表：顶部分隔线，逐行展开 */
.flow-list {
  margin-top: var(--space-lg);
  border-top: var(--hairline);
}

/* 行高 72rpx：单行「标签 + 金额」，48px 一行会把四档拆得太开 */
.flow-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-md);
  min-height: 72rpx;
  border-bottom: var(--hairline);
  font-size: var(--font-base);   /* 四档标签与金额同为标准 */
}

/* 最后一行不带分隔线（:last-child 是结构伪类，非 WXSS 禁用项） */
.flow-item:last-child {
  border-bottom: none;
}

.flow-k {
  color: var(--ink-2);
}

/* 数值不写 color：金额按正负着色（.up / .down 来自 _card.wxss），
   在这里写死 --ink 会以「后定义者胜」把着色整片盖掉。
   字号与标签同档（标准），着色承担主次 */
.flow-v {
  font-size: var(--font-base);
}

.flow-spark {
  margin-top: var(--space-lg);
  height: 64rpx;
}

/* 龙虎榜 */
.lhb {
  margin-top: var(--space-lg);
}

.lhb-title {
  font-size: var(--font-base);
  color: var(--ink-3);
}

.lhb-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-md);
  margin-top: var(--space-xs);
  font-size: var(--font-base);
}

.lhb-seat {
  flex: 1;
  min-width: 0;
  color: var(--ink-2);
  word-break: break-word;        /* 不裁剪：长席位名（如「中信证券上海分公司」）完整换行显示 */
}

.lhb-vals {
  flex: none;
  display: flex;
  gap: var(--space-md);
  /* 不再写固定 width：列宽由两个 .lhb-val 的 min-width 决定，
     写死 320rpx 会把内容顶出卡片右边（2026-10-26 修） */
}

/* 资金流向数据改成「左右对齐」：名称 / 主数字靠左，数值 / 占比靠右。
   撤销此前的等宽居中（flex:1 + center）——容器 .flow-hd / .flow-item 本就是
   space-between，这里只需让子项恢复自适应宽度并按左右对齐。 */
.flow-big {
  flex: none;
  text-align: left;              /* 主力净流入靠左 */
}

.flow-pct {
  flex: none;
  text-align: right;             /* 占成交额比靠右 */
}

.flow-k {
  flex: none;
  text-align: left;              /* 超大单 / 大单 / 中单 / 小单 / 北向持股 靠左 */
}

.flow-v {
  flex: none;
  text-align: right;             /* 对应金额靠右 */
}

/* 「龙虎榜」标题：居中 */
.lhb-title {
  text-align: center;
}

/* 龙虎榜行（等距居中，2026-10-26 用户指定）：
   三列各占 1/3、每格内容居中——席位 `.lhb-seat` 占 1 份，
   买卖容器 `.lhb-vals` 占 2 份（内含两列各 1 份）≈ 每列 200rpx。
   每列 200rpx 才放得下 "-9,800.00万" 这种 10 字符金额（旧版每列 147rpx，
   「万」会被挤到第二行）；nowrap 再兜一层，金额永不折行。 */
.lhb-seat {
  flex: 1;
  text-align: center;
}

.lhb-vals {
  flex: 2;
  gap: var(--space-md);
}

/* 组件 wxss 里不能用标签选择器（`text` 会被工具判非法并整条失效），
   所以列宽/不折行这组规则挂在 .lhb-val 上，由 WXML 显式加类。 */
.lhb-val {
  flex: 1;
  min-width: 0;
  white-space: nowrap;           /* 金额不折行，单位不单独掉行 */
  text-align: center;
}

/* 纵向等距：各块顶部间距统一为一档（卡内比页面紧一档） */
.flow-hd,
.flow-list,
.flow-spark,
.lhb {
  margin-top: var(--space-md);
}

/* ===== 龙虎榜表格化 ===== */
/* 表头：复用列宽类，与数据行自动对齐；弱文字 + 发丝底线 */
.lhb-head {
  display: flex;
  align-items: center;
  gap: var(--space-md);              /* 与 .lhb-row 的 gap 一致，保证列对齐 */
  margin-top: var(--space-xs);       /* 与「龙虎榜」标题的间距 */
  padding-bottom: var(--space-xs);
  border-bottom: var(--hairline);
  font-size: var(--font-base);
  color: var(--ink-3);
}

/* 表头对齐与数据行一致：三列居中（席位 / 买入 / 卖出），
   列宽也复用 .lhb-seat / .lhb-vals 的 1:2 分配，所以表头与数据上下对齐。
   这里不覆盖 text-align。 */
.lhb-head .lhb-seat {
  color: var(--ink-3);           /* 覆盖 .lhb-seat 的 --ink-2，表头用弱文字 */
  font-weight: 400;
}

/* 数据行：行间发丝分隔线，最后一行不画底线 */
.lhb-row {
  margin-top: 0;
  padding: var(--space-xs) 0;        /* 行距改由 padding 给，分隔线之间等距 */
  border-bottom: var(--hairline);
}

.lhb-row:last-child {
  border-bottom: none;
}
