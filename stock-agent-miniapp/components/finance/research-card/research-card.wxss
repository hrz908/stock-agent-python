@import "../_card.wxss";

/* 卡片标题居中：与 _card.wxss 的共享规则同源；写在组件自身 wxss 里，
   避免修改 @import 进来的文件时开发者工具不热更新导致不生效 */
.fcard-title-col,
.fcard-name,
.fcard-code {
  text-align: left;
}

/* 底部说明（盈利预测 / 来源）左对齐（字级走 _card.wxss 的小号） */
.fnote {
  text-align: left;
}

/* 结论位：评级 + 目标价，右对齐；买入红 / 中性灰 / 减持绿（视觉稿 .rating） */
.rating {
  flex: none;
  display: inline-flex;
  align-items: baseline;
  gap: var(--space-xs);
  font-size: var(--font-sm);
  font-weight: 600;
  white-space: nowrap;
  max-width: 200rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

/* 核心观点：左竖线 + 次级文字（视觉稿 .quote）。
   行高 1.5：摘要多行，1.7 读起来松散 */
.quote {
  margin-top: var(--space-md);
  padding-left: var(--space-md);
  border-left: 4rpx solid var(--line); /* 第8条例外：摘要引用竖线，不适用 --hairline */
  font-size: var(--font-base);     /* 卡内正文：标准 */
  line-height: 1.5;
  color: var(--ink-2);
  word-break: break-word;        /* 不裁剪：完整显示核心观点（去掉 2 行 clamp） */
}

/* 原文链接：可点，复制到剪贴板。
   min-height 从 88rpx 收到 56rpx：它写在说明行里，撑到 88rpx 会把整行顶开 */
.src-link {
  margin-left: var(--space-md);
  color: var(--accent);
  text-decoration: underline;
  display: inline-flex; align-items: center; min-height: 56rpx;
}

/* 核心观点：标题下方这一整块信息左对齐（取消居中） */
.quote {
  text-align: left;
}
