@import "../_card.wxss";

/* 卡片标题左对齐：与 _card.wxss 的共享规则同源；写在组件自身 wxss 里，
   避免修改 @import 进来的文件时开发者工具不热更新导致不生效 */
.fcard-title-col,
.fcard-name,
.fcard-code {
  text-align: left;
}

/* 底部说明（数据日期 / 股票代码）左对齐 */
.fnote {
  text-align: left;
}

/* ===== 三项主数据：与资金流向卡「龙虎榜」数据行完全同规格 =====
   列宽：名称 .rep-k 占 1/2，右侧 .rep-v 占 1/2（内部金额 / 同比各 1/4）；
   对齐：名称靠左，金额与同比右对齐（数位竖向对齐，金融表格习惯）；
   行间发丝线、末行不画线；没有「龙虎榜」那样的小标题。
   原横向条形图（.bar-track / .bar-fill）按需求移除。 */
.rep-list {
  margin-top: var(--sp-2);
}

/* 行距只留 sp-1：三项数据是同一张表，行与行之间不需要留呼吸感 */
.rep-row {
  display: flex;
  align-items: center;
  gap: var(--gap-grid);
  padding: var(--sp-1) 0;
  border-bottom: var(--hairline);
}

.rep-row:last-child {
  border-bottom: none;
}

.rep-k {
  flex: 1;                       /* 名称：整行 1/2 */
  min-width: 0;
  font-size: var(--fs-aux);
  color: var(--ink-2);
  text-align: left;
  word-break: break-word;        /* 不裁剪：超长标签换行完整显示 */
}

.rep-v {
  flex: 1;                       /* 金额 + 同比：合计整行 1/2 */
  display: flex;
  gap: var(--gap-grid);
  font-size: var(--fs-aux);
  color: var(--ink);
}

/* 金额与同比各占整行 1/4，统一右对齐 */
.rep-amt,
.rep-yoy {
  flex: 1;
  text-align: right;
  white-space: nowrap;           /* 兜底：数值不跳行 */
}

/* 金额是本行主信息，比同比大一档；同比保持 caption，靠颜色表达方向 */
.rep-amt {
  font-size: var(--fs-body);
}
