@import "../_card.wxss";

/* 卡片标题左对齐：与 _card.wxss 的共享规则同源；写在组件自身 wxss 里，
   避免修改 @import 进来的文件时开发者工具不热更新导致不生效 */
.fcard-title-col,
.fcard-name,
.fcard-code {
  text-align: left;
}

.fnote {
  text-align: left;
}

/* ===== 三项主数据：与资金流向卡「龙虎榜」数据行完全同规格 =====
   列宽：名称 .rep-k 占 1/2，右侧 .rep-v 占 1/2（内部金额 / 同比各 1/4）；
   对齐：名称靠左，金额与同比右对齐（数位竖向对齐，金融表格习惯）；
   行间发丝线、末行不画线；没有「龙虎榜」那样的小标题。 */
.rep-list {
  margin-top: var(--space-md);
}

/* 行距只留 sp-1：三项数据是同一张表，行与行之间不需要留呼吸感 */
.rep-row {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  padding: var(--space-xs) 0;
  border-bottom: var(--hairline);
}

.rep-row:last-child {
  border-bottom: none;
}

.rep-k {
  flex: 1;                       /* 名称：整行 1/2 */
  min-width: 0;
  font-size: var(--font-base);     /* 指标键：标准（8 张卡统一） */
  color: var(--text-secondary);
  text-align: left;
  word-break: break-word;        /* 不裁剪：超长标签换行完整显示 */
}

.rep-v {
  flex: 1;                       /* 金额 + 同比：合计整行 1/2 */
  display: flex;
  gap: var(--space-md);
  font-size: var(--font-base);     /* 金额与同比：标准 */
  color: var(--text-primary);
}

/* 金额与同比各占整行 1/4，统一右对齐 */
.rep-amt,
.rep-yoy {
  flex: 1;
  text-align: right;
  white-space: nowrap;           /* 兜底：数值不跳行 */
}

/* 金额与同比同为标准，主次只靠颜色（红涨绿跌）表达方向 */
.rep-amt {
  font-size: var(--font-base);
}
