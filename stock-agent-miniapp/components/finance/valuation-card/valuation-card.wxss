@import "../_card.wxss";

/* 卡片标题左对齐：与 _card.wxss 的共享规则同源；写在组件自身 wxss 里，
   避免修改 @import 进来的文件时开发者工具不热更新导致不生效 */
.fcard-title-col,
.fcard-name,
.fcard-code {
  text-align: left;
}

/* 底部说明（数据日期）左对齐 */
.fnote {
  text-align: left;
}

/* ===== 卡内信息：等距 + 居中 =====
   等距：两块指标栅格统一 24rpx 顶距，每行各格由共享样式的 flex:1 + gap 均分；
   居中：每格标签与数值居中（规则在 _card.wxss，本卡不另写对齐）。
   注：PE 分位进度条（.pct-row / .pct-track / .pct-fill / .pct-label / .pct-value）
   已随分位信息一并移除，样式同步删掉，不留死代码。 */
.fgrid {
  margin-top: var(--sp-3);
}

.fgrid-row--gap {
  margin-top: var(--sp-3);       /* 与 .fgrid 取同值，保证两块栅格间距一致 */
}
