@import "../_card.wxss";

/* 卡片标题左对齐：与 _card.wxss 的共享规则同源；写在组件自身 wxss 里，
   避免修改 @import 进来的文件时开发者工具不热更新导致不生效 */
.fcard-title-col,
.fcard-name,
.fcard-code {
  text-align: left;
}

.fnote {
  text-align: left;
}

/* ===== 卡内信息：等距 + 居中 =====
   等距：两块指标栅格取同一顶距（--space-md），每行各格由共享样式的 flex:1 + gap 均分；
   居中：每格标签与数值居中（规则在 _card.wxss，本卡不另写对齐）。 */
.fgrid {
  margin-top: var(--space-md);
}

.fgrid-row--gap {
  margin-top: var(--space-md);       /* 与 .fgrid 取同值，保证两块栅格间距一致 */
}
