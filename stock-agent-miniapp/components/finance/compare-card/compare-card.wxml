<!-- 同业对比卡：只对比两家同行（本股 + 2 家，共 3 列），标题 A vs B vs C；
     涨跌幅按正负着色（加号红 / 减号绿），PE/PB 标更低者优。数值居中对齐 -->
<view class="fcard card-class">
  <view class="fcard-hd">
    <view class="fcard-title-col">
      <view class="fcard-name">{{title}}</view>
      <view class="fcard-code">{{subtitle}}</view>
    </view>

  </view>

  <!-- 表格：横向滚动（固定列宽 + flex-shrink: 0，执行指南 4.4） -->
  <scroll-view class="cmp-scroll" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
    <view class="cmp-table">
      <view class="cmp-row cmp-row--head">
        <view class="cmp-cell cmp-cell--label">指标</view>
        <!-- 表头只列实际参与对比的标的（cols 已按 MAX_ITEMS 截断），与数据行列数一致 -->
        <view class="cmp-cell" wx:for="{{cols}}" wx:for-item="it" wx:key="name">{{it.name}}</view>
      </view>
      <view class="cmp-row {{ri > 0 ? 'cmp-row--sep' : ''}}" wx:for="{{rows}}" wx:for-item="row" wx:for-index="ri" wx:key="label">
        <view class="cmp-cell cmp-cell--label">{{row.label}}</view>
        <view class="cmp-cell num {{c.tone}}" wx:for="{{row.cells}}" wx:for-item="c" wx:key="index">{{c.text}}</view>
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{note}}" class="fnote">{{note}}</view>
</view>
