@import "../_card.wxss";

/* 卡片标题居中：与 _card.wxss 的共享规则同源；写在组件自身 wxss 里，
   避免修改 @import 进来的文件时开发者工具不热更新导致不生效 */
.fcard-title-col,
.fcard-name,
.fcard-code {
  text-align: left;
}

/* 底部说明（数据日期）左对齐 */
.fnote {
  text-align: left;
}

/* 表格：横向滚动容器，内部表格按列数撑开 */
.cmp-scroll {
  margin-top: var(--sp-2);
  width: 100%;
}

.cmp-table {
  display: flex;
  flex-direction: column;
  min-width: 100%;
}

/* 行高由 96rpx 收到 72rpx：单行小字表格，48px 一行会显得散 */
.cmp-row {
  display: flex;
  align-items: center;
  min-height: 72rpx;
}

/* 行间分隔线：sep 由 WXML 行号计算（WXSS 禁兄弟选择器） */
.cmp-row--sep {
  border-top: var(--hairline);
}

.cmp-row--head {
  border-bottom: var(--hairline);
}

/* 指标列固定宽度，数值列均分且不收缩（横向滚动由外层 scroll-view 负责）。
   这里不写 color：写死 --ink 会盖掉 _card.wxss 的 .up/.down，
   涨跌幅与「更优者」的着色全部失效（同名优先级，后定义者胜） */
.cmp-cell {
  flex: 1;
  flex-shrink: 0;
  min-width: 140rpx;
  padding: var(--sp-2) var(--sp-2);
  font-size: var(--fs-aux);
  text-align: right;
  white-space: nowrap;
}

.cmp-cell--label {
  flex: none;
  width: 128rpx;
  text-align: left;
  color: var(--ink-3);
  font-size: var(--fs-min);
  word-break: break-word;        /* 不裁剪：指标名换行完整显示 */
}

.cmp-row--head .cmp-cell {
  color: var(--ink-3);
  font-size: var(--fs-min);
  font-weight: 500;
  white-space: nowrap;
}

.cmp-row--head .cmp-cell--label {
  color: var(--ink-3);
  word-break: break-word;        /* 不裁剪：表头指标名换行完整显示 */
}

/* 表格排版：指标列靠左（行首），数值列等分居中。
   末列不再单独右对齐——3 个标的等距时，只有末列贴右会让整张表看起来是歪的 */
.cmp-cell {
  text-align: center;
}

.cmp-cell--label {
  text-align: left;
}
