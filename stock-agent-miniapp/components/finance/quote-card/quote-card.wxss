@import "../_card.wxss";

/* 卡片标题左对齐：与 _card.wxss 的共享规则同源；写在组件自身 wxss 里，
   避免修改 @import 进来的文件时开发者工具不热更新导致不生效 */
.fcard-title-col,
.fcard-name,
.fcard-code {
  text-align: left;
}

/* 底部说明（行情时间 / 数据日期）左对齐（字级走 _card.wxss 的小号） */
.fnote {
  text-align: left;
}

/* 价格行（名称下方这一行）：三个数字等距居中——flex:1 均分一行，
   每格文字居中（与数据栅格同一口径）；基线对齐保留：价格与涨跌数字
   字号不同，按文字基线排是有意选择。 */
.price-row {
  display: flex;
  align-items: baseline;
  gap: var(--space-md);
  margin-top: var(--space-md);
}

/* 三个数字同排：涨跌额 / 涨跌幅各占一等份、格内居中 */
.price,
.chg,
.pct {
  flex: 1;
  min-width: 0;
  text-align: center;
}

/* 主价格 = 字号上限 --font-xl（40rpx）+ 700（2026-10-26 令牌收敛，display 档取消）：
   卡主标题是 --font-lg（36rpx），价格高出一档即可读出主导权。
   价格不参与三等分：flex:none 吃自然宽度，涨跌额 / 涨跌幅按剩余空间等分，
   否则 40rpx 的「1,523.66」塞进 1/3 格（约 196rpx）会折行。最大档（字体缩放）已验算不溢出。 */
.price {
  flex: none;
  font-size: var(--font-xl);
  font-weight: 600;
  line-height: 1.1;
  letter-spacing: -0.01em;
}

/* 涨跌额/涨跌幅：与现价同排，低一档到标准（--font-base）。
   同级同号会让三个数字一样重，价格失去主导 */
.chg,
.pct {
  font-size: var(--font-base);
  font-weight: 600;
}

/* 迷你走势线：与栅格之间留一档 */
.spark {
  margin-top: var(--space-md);
  height: 88rpx;
}

/* ===== 两行数据栅格：等距 + 居中 =====
   等距：行间距统一由 .fgrid 的 gap 给，关掉第二行自带的 margin-top 防叠加；
   居中：每格标签与数值居中（规则在 _card.wxss，本卡不另写对齐）。 */
.fgrid {
  gap: var(--space-md);              /* 两行之间垂直等距 */
}
.fgrid-row--gap {
  margin-top: 0;                 /* 行间距交给 .fgrid 的 gap，避免与 gap 叠加 */
}
