@import "../_card.wxss";

/* 卡片标题左对齐：与 _card.wxss 的共享规则同源；写在组件自身 wxss 里，
   避免修改 @import 进来的文件时开发者工具不热更新导致不生效 */
.fcard-title-col,
.fcard-name,
.fcard-code {
  text-align: left;
}

/* 底部说明（行情时间 / 数据日期）左对齐 */
.fnote {
  text-align: left;
}

/* 价格行：左主价、右涨跌两行。底对齐让两块数字坐在同一基线上 */
.price-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: var(--sp-2);
  margin-top: var(--sp-2);
}

/* 主价格：全站唯一的 display 档，一屏只此一个数字 */
.price {
  font-size: var(--fs-display);
  font-weight: 700;
  line-height: 1;
  letter-spacing: -1rpx;
}

/* 涨跌额 / 涨跌幅：竖排贴右，与价格同基线 */
.price-chg {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

/* 次级数字走 hero 档：与主价 64 形成 1.6 倍关系，再小就只剩「标签」味了 */
.chg,
.pct {
  font-size: var(--fs-price);
  font-weight: 600;
  line-height: 1.3;
}

/* 迷你走势线：左右出血到列边缘——它是这张卡唯一的手迹，
   与栅格之间只留一档，下面交给浅底块收尾 */
.spark {
  margin-top: var(--sp-2);
  height: 96rpx;
}

/* ===== 两行数据栅格：等距 + 左对齐 =====
   等距：行间距统一由 .fgrid 的 gap 给，关掉第二行自带的 margin-top 防叠加；
   对齐：每格标签与数值贴本格左边缘（规则在 _card.wxss，本卡不另写对齐）。 */
.fgrid {
  gap: var(--gap-grid);          /* 两行之间垂直等距 */
}
.fgrid-row--gap {
  margin-top: 0;                 /* 行间距交给 .fgrid 的 gap，避免与 gap 叠加 */
}
