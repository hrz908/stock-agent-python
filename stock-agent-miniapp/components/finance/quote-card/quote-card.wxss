@import "../_card.wxss";

/* 卡片标题左对齐：与 _card.wxss 的共享规则同源；写在组件自身 wxss 里，
   避免修改 @import 进来的文件时开发者工具不热更新导致不生效 */
.fcard-title-col,
.fcard-name,
.fcard-code {
  text-align: left;
}

/* 底部说明（行情时间 / 数据日期）左对齐 */
.fnote {
  text-align: left;
}

/* 价格行（名称下方这一行）：三个数字等距居中——flex:1 均分一行，
   每格文字居中（与数据栅格同一口径）；基线对齐保留：价格与涨跌数字
   字号不同，按文字基线排是有意选择。 */
.price-row {
  display: flex;
  align-items: baseline;
  gap: var(--gap-grid);
  margin-top: var(--sp-3);
}

/* 三个数字各占一等份、格内居中 */
.price,
.chg,
.pct {
  flex: 1;
  min-width: 0;
  text-align: center;
}

/* 价格 32px 级（--fs-price = 64rpx） */
.price {
  font-size: var(--fs-price);
  font-weight: 700;
  line-height: 1.1;
  letter-spacing: -0.5rpx;
}

/* 涨跌额/涨跌幅：与现价同排，比辅助级大一档——它们是卡片上
   第二重要的数字，用 --fs-aux（11px）会小到读不出来 */
.chg,
.pct {
  font-size: var(--fs-title);
  font-weight: 600;
}

/* 迷你走势线：与栅格之间留一档 */
.spark {
  margin-top: var(--sp-3);
  height: 88rpx;
}

/* ===== 两行数据栅格：等距 + 居中 =====
   等距：行间距统一由 .fgrid 的 gap 给，关掉第二行自带的 margin-top 防叠加；
   居中：每格标签与数值居中（规则在 _card.wxss，本卡不另写对齐）。 */
.fgrid {
  gap: var(--gap-grid);          /* 两行之间垂直等距 */
}
.fgrid-row--gap {
  margin-top: 0;                 /* 行间距交给 .fgrid 的 gap，避免与 gap 叠加 */
}
