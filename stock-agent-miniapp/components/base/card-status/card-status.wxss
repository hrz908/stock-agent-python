/* 卡片占位（loading / 失败）：外壳规格对齐 components/finance/_card.wxss 的 .fcard，
   占位卡换成真卡时位置与尺寸不跳。token 变量经 CSS 自定义属性继承进来，
   工具类 class 不再复写（组件样式隔离，见 styles/token.wxss 顶部说明） */
.cs {
  width: 100%;
  box-sizing: border-box;
  padding: var(--pad-card);
  background: var(--surface);
  border: var(--hairline);
  border-radius: var(--r-card);
  box-shadow: var(--shadow-card);
  /* 微光扫过的高光条在圆角外不可见 */
  overflow: hidden;
}

/* ===== 加载态 ===== */
.cs-hd {
  display: flex;
  flex-direction: column;
  gap: var(--sp-1);
}

/* 骨架块：次级面打底，微光条在 ::after 上横向平移（底色块本身不动） */
.sk {
  position: relative;
  background: var(--surface-2);
  border-radius: var(--r-tag);
  overflow: hidden;
}

.sk::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    90deg,
    rgba(255, 255, 255, 0) 0%,
    rgba(255, 255, 255, 0.85) 50%,
    rgba(255, 255, 255, 0) 100%
  );
  animation: cs-shimmer 1.4s ease-in-out infinite;
}

.sk--title {
  width: 240rpx;
  height: 36rpx;
}

.sk--code {
  width: 160rpx;
  height: 24rpx;
}

/* 数据区：一条顶部分隔线 + 两行三列，与金融卡的 .fgrid 同形 */
.cs-grid {
  margin-top: var(--sp-card);
  padding-top: var(--sp-3);
  border-top: var(--hairline);
}

.cs-row {
  display: flex;
  gap: var(--gap-grid);
}

/* 行间距用显式类名，不用兄弟选择器（WXSS 禁用） */
.cs-row--gap {
  margin-top: var(--gap-grid);
}

.sk--cell {
  flex: 1;
  min-width: 0;
  height: 48rpx;
}

/* 加载提示行：转圈 + 文案左对齐（与金融卡 .fnote 的对齐口径一致） */
.cs-foot {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  margin-top: var(--sp-3);
  padding-top: var(--sp-2);
  border-top: var(--hairline-dashed);
}

.cs-spinner {
  flex: none;
  width: 28rpx;
  height: 28rpx;
  box-sizing: border-box;
  border: 4rpx solid var(--line);
  border-top-color: var(--ink-2);
  border-radius: 50%;
  animation: cs-spin 0.8s linear infinite;
}

.cs-label {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-min);
  color: var(--ink-3);
}

@keyframes cs-shimmer {
  from {
    transform: translateX(-100%);
  }
  to {
    transform: translateX(100%);
  }
}

@keyframes cs-spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

/* ===== 失败态 ===== */
.cs-err {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
}

/* ant-icon 渲染成 <text>，显式 block 化，避免行内基线留白 */
.cs-err-icon {
  flex: none;
  display: block;
  line-height: 1;
}

.cs-err-label {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--ink);
  word-break: break-word;
}

.cs-err-detail {
  display: block;
  margin-top: var(--sp-2);
  font-size: var(--fs-min);
  line-height: 1.6;
  color: var(--ink-3);
}
