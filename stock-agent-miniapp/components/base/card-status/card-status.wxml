<!-- 卡片占位：加载中（骨架屏 + 转圈 + 文案）/ 取数失败（警示图标 + 失败原因）。
     外壳与金融卡同规格（.fcard：白面 + 发丝描边 + 16rpx 圆角 + 28rpx 内边距），
     替换成真卡时卡片位置与尺寸不跳 -->
<view class="cs card-class">
  <block wx:if="{{state === 'loading'}}">
    <!-- 头部：标题 + 副标题两道骨架 -->
    <view class="cs-hd">
      <view class="sk sk--title"></view>
      <view class="sk sk--code"></view>
    </view>

    <!-- 数据区：两行三列，与行情 / 估值 / 财报等卡的栅格同形 -->
    <view class="cs-grid">
      <view class="cs-row">
        <view class="sk sk--cell"></view>
        <view class="sk sk--cell"></view>
        <view class="sk sk--cell"></view>
      </view>
      <view class="cs-row cs-row--gap">
        <view class="sk sk--cell"></view>
        <view class="sk sk--cell"></view>
        <view class="sk sk--cell"></view>
      </view>
    </view>

    <!-- 加载提示：转圈 + 正在做什么（与顶部状态条区分开，说明「这张卡在等数据」） -->
    <view class="cs-foot">
      <view class="cs-spinner"></view>
      <text class="cs-label">{{label}}</text>
    </view>
  </block>

  <block wx:else>
    <view class="cs-err">
      <ant-icon class="cs-err-icon" type="ExclamationCircleFill" style="font-size:44rpx;color:var(--warn);" />
      <text class="cs-err-label">{{label}}</text>
    </view>
    <text wx:if="{{detail}}" class="cs-err-detail">{{detail}}</text>
  </block>
</view>
