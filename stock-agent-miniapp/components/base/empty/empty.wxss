.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--space-lg) var(--space-lg);
  gap: var(--space-xs);}

/* 空态图标：图标组件渲染成 <text>，显式 block 化，避免行内基线留白 */
.empty-icon {
  display: block;
  line-height: 1;
}

/* 主文案比补充说明大一档：空态也要有层级，两行同号等于没说话 */
.empty-text {
  margin-top: var(--space-lg);
  font-size: var(--font-base);
  color: var(--text-primary);
}

/* 补充说明：小号（与标签同档） */
.empty-sub {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  line-height: 1.6;
  text-align: center;
}
