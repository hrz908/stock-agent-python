.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--sp-6) var(--sp-4);
  gap: var(--sp-1);}

/* 空态图标：图标组件渲染成 <text>，显式 block 化，避免行内基线留白 */
.empty-icon {
  display: block;
  line-height: 1;
}

/* 主文案比补充说明大一档：空态也要有层级，两行同号等于没说话 */
.empty-text {
  margin-top: var(--sp-3);
  font-size: var(--fs-body);
  color: var(--ink-2);
}

.empty-sub {
  font-size: var(--fs-min);
  color: var(--ink-3);
  line-height: 1.6;
  text-align: center;
}
