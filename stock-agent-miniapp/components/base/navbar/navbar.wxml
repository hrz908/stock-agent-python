<view class="navbar navbar-class" style="padding-top: {{statusBarHeight}}px; height: {{barHeight + statusBarHeight}}px;">
  <view class="navbar-inner">
    <!-- 左侧：返回箭头（leftArrow）或菜单插槽（slot left），二选一。
         插槽不能挂 wx:else（slot 不支持条件渲染指令），改成常驻渲染：
         用返回箭头的子页面不传 left 插槽内容，这里自然为空 -->
    <!-- 不挂 hover-class：需求取消所有「点一下变暗」的按压特效 -->
    <view
      wx:if="{{leftArrow}}"
      class="nav-btn"
      aria-label="{{leftAriaLabel}}"
      bindtap="onLeftTap"
    >
      <base-icon type="LeftOutline" style="font-size:44rpx;color:var(--ink);" />
    </view>
    <slot name="left" />

    <!-- 标题：铺满整行居中，max-width 避开胶囊，pointer-events 不挡手势。
         只有主页面（chat）传 title，子页面一律不传，此时整块不渲染 -->
    <view wx:if="{{title}}" class="nav-title" style="max-width: {{titleMaxWidth}}px;">
      <text class="nav-title-text">{{title}}</text>
    </view>
  </view>
</view>
