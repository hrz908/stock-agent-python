/* 弹层：fixed 全屏（WebView 渲染，fixed/sticky 正常可用，无 Skyline 顾虑） */
.popup {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: var(--z-popup);
  animation: popup-fade-in 240ms ease both;
}

.popup--leaving {
  animation: popup-fade-out 240ms ease both;
  /* 淡出期间整层不再接收点击，也防止残影层误触 */
  pointer-events: none;
}

.popup-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  /* 浅色主题：遮罩压暗即可，深色主题那套接近纯黑的重遮罩会把浅底压成脏灰 */
  background: var(--mask);
}

/* ===== 居中对话框 ===== */
.popup-panel--center {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 84%;
  max-height: 86%;
  display: flex;
  flex-direction: column;
  background: var(--surface);
  border: var(--hairline);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-lg);
}

/* ===== 左侧抽屉 ===== */
.popup-panel--left {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 520rpx;
  max-width: 78%;
  display: flex;
  flex-direction: column;
  /* 抽屉底与页面同色（#F5F5F5）：里面的按键与会话行靠白卡浮起来 */
  background: var(--bg);
  animation: popup-left-in 240ms cubic-bezier(0.25, 0.8, 0.35, 1) both;
  box-shadow: var(--shadow-lg);
}

.popup--leaving .popup-panel--left {
  animation: popup-left-out 240ms ease both;
}

/* ===== 底部面板 ===== */
.popup-panel--bottom {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  background: var(--surface);
  border-top: var(--hairline);
  border-radius: var(--radius-xl);
  padding-bottom: env(safe-area-inset-bottom);
  animation: popup-bottom-in 240ms cubic-bezier(0.25, 0.8, 0.35, 1) both;
  box-shadow: var(--shadow-lg);
}

.popup--leaving .popup-panel--bottom {
  animation: popup-bottom-out 240ms ease both;
}

/* ===== 头部 / 主体 / 底部 ===== */
.popup-header {
  flex: none;
  padding: var(--space-lg) var(--space-lg) 0;
}

/* 弹窗标题：全局大号（添加自选 / 新增提醒 / 编辑资料 / 二次确认都用这一处） */
.popup-title {
  font-size: var(--font-xl);
  font-weight: var(--fw-semibold);
  color: var(--ink);
  text-align: center;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

.popup-desc {
  margin-top: var(--space-xs);
  font-size: var(--font-sm);
  color: var(--ink-3);
  text-align: center;
  line-height: 1.5;
}

.popup-body {
  flex: 1;
  min-height: 0;
}

.popup-body-inner {
  padding: var(--space-md) var(--space-lg) var(--space-lg);
}

.popup-body--full {
  height: 100%;
  overflow: hidden;
}

.popup-footer {
  flex: none;
  display: flex;
  gap: var(--space-lg);
  padding: var(--space-lg) var(--space-lg) var(--space-lg);
  border-top: var(--hairline);
}

/* 弹窗按钮：与底部主按钮同一套 —— 白底、无描边、黑字，主次只靠字重 */
.popup-btn {
  flex: 1;
  min-height: var(--icon-touch);
  padding: 16rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: var(--lh-base);
  background: var(--color-bg-card);
  color: var(--color-text-primary);
  font-size: var(--font-lg);
  font-weight: var(--fw-medium);
  border-radius: var(--radius-sm);
  /* 数字与中文混排时按钮文案不抖 */
  font-variant-numeric: tabular-nums;
}

.popup-btn--cancel {
  color: var(--color-text-primary);
  font-weight: 400;
}

.popup-btn--confirm {
  color: var(--color-text-primary);
  font-weight: var(--fw-medium);
}

/* 危险确认：不铺色块，只用语义色文字（移出自选 / 退出登录等破坏性操作） */
.popup-btn--danger {
  color: var(--color-error);
}

/* ===== 动画（WXSS 禁写 rem/vh，位移用 translate 百分比） ===== */
@keyframes popup-fade-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes popup-fade-out {
  from {
    opacity: 1;
  }
  to {
    opacity: 0;
    /* 最后一帧强制不可见：即使 wx:if 移除晚于动画一帧，
       WebView 合成层也不会留下静止的弹窗残影 */
    visibility: hidden;
  }
}

@keyframes popup-left-in {
  from {
    transform: translateX(-100%);
  }
  to {
    transform: translateX(0);
  }
}

@keyframes popup-left-out {
  from {
    transform: translateX(0);
  }
  to {
    transform: translateX(-100%);
  }
}

@keyframes popup-bottom-in {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

@keyframes popup-bottom-out {
  from {
    transform: translateY(0);
  }
  to {
    transform: translateY(100%);
  }
}
