/* 轻提示：屏幕居中偏上的深色小药丸，z-index 高于弹层（校验失败要能在弹窗上看到）。
   浅色主题下仍用深色药丸：白底上深色提示对比更强、更像平台原生提示；
   代价是文字必须显式反白——不能再用 var(--ink)（浅色主题下它是近黑） */
.toast {
  position: fixed;
  left: 50%;
  top: 42%;
  transform: translate(-50%, -50%); /* 第2条例外：fixed 浮层的视口居中只能用 left/top 50% + translate，无法用 flex（没有可依赖的父容器）。已核对为全项目唯一例外。 */
  z-index: var(--z-toast);
  max-width: 70%;
  padding: var(--space-md) var(--space-xl);
  background: rgba(23, 27, 33, 0.94);
  border-radius: var(--radius-sm);
  box-shadow: var(--shadow-md);
  animation: toast-in 180ms ease both;
}

.toast-text {
  font-size: var(--font-sm);
  line-height: 1.6;
  color: var(--primary-fg); /* 深色药丸上的浅色文字 */
  text-align: center;
  word-break: break-all;
}

@keyframes toast-in {
  from {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.96);
  }
  to {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
}
