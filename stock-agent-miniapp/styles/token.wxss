/* =============================================================
   设计令牌 · 最终版（唯一风格真相源，被 app.wxss @import）
   750rpx 设计稿 · 正文 32rpx 锚点 · 8 点网格

   规则：
   - 字号六档 24/28/32/36/40/48；行高只用倍率；字重 400/500/600/700
   - 间距八档 4/8/12/16/24/32/48/64；页面左右 32
   - 圆角六档 4/8/12/16/24/999；按钮与输入框 8
   - 阴影三档只给浮起元素，卡片靠描边分层
   - 颜色一律引用变量，业务样式里禁止裸 hex / 裸 rpx 字号
   - 按钮用 flex 居中 + padding 撑高，禁止写死 height

   兼容层：--ink / --surface / --bg 等旧名保留为「指向令牌的别名」，
   供存量样式引用；新增样式请直接用 --color-* 名。
   ============================================================= */
page {
  /* ---- 字号六档：相邻差 4rpx ---- */
  --font-xs: 24rpx;
  --font-sm: 28rpx;
  --font-base: 32rpx;
  --font-lg: 36rpx;
  --font-xl: 40rpx;
  --font-2xl: 48rpx;

  /* ---- 行高：一律倍率，禁止写死 rpx ---- */
  --lh-xs: 1.4;
  --lh-sm: 1.45;
  --lh-base: 1.5;
  --lh-lg: 1.35;
  --lh-xl: 1.25;
  --lh-2xl: 1.2;
  --lh-loose: 1.6;

  /* ---- 字间距：用 em ---- */
  --ls-xs: 0.04em;
  --ls-sm: 0.02em;
  --ls-base: 0;
  --ls-lg: 0.01em;
  --ls-xl: 0.02em;

  /* ---- 字重：随字号反向 ---- */
  --fw-regular: 400;
  --fw-medium: 500;
  --fw-semibold: 600;
  --fw-bold: 700;

  /* ---- 间距八档（8 点网格） ---- */
  --space-xxs: 4rpx;
  --space-xs: 8rpx;
  --space-sm: 12rpx;
  --space-md: 16rpx;
  --space-lg: 24rpx;
  --space-xl: 32rpx;
  --space-2xl: 48rpx;
  --space-3xl: 64rpx;

  /* ---- 内边距组合（垂直 × 水平） ---- */
  --pad-compact: var(--space-xs) var(--space-sm);
  --pad-normal: var(--space-sm) var(--space-md);
  --pad-comfy: 20rpx var(--space-lg);
  --pad-page: 0 var(--space-xl);

  /* ---- 外边距（以 32rpx 正文为锚） ---- */
  --gap-inner: var(--space-md);
  --gap-between: var(--space-lg);
  --gap-section: var(--space-2xl);

  /* ---- 图标五档 + 触控底限 ---- */
  --icon-xs: 28rpx;
  --icon-sm: 36rpx;
  --icon-base: 40rpx;
  --icon-lg: 48rpx;
  --icon-xl: 56rpx;
  --icon-touch: 88rpx;

  /* ---- 圆角六档 ---- */
  --radius-xs: 4rpx;
  --radius-sm: 8rpx;
  --radius-md: 12rpx;
  --radius-lg: 16rpx;
  --radius-xl: 24rpx;
  --radius-round: 999rpx;

  /* ---- 阴影三档：只给浮起元素 ---- */
  --shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  --shadow-md: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  --shadow-lg: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);

  /* ---- 色彩 ---- */
  --color-text-primary: #333333;
  --color-text-secondary: #666666;
  --color-text-hint: #999999;
  --color-text-disabled: rgba(51, 51, 51, 0.38);
  --color-text-inverse: #FFFFFF;
  --color-bg-page: #F5F5F5;
  --color-bg-card: #FFFFFF;
  --color-bg-disabled: #F2F2F2;
  --color-border: #E5E5E5;
  --color-divider: #EEEEEE;
  --color-mask: rgba(0, 0, 0, 0.4);
  --color-brand: #07C160;
  --color-brand-press: #06A352;
  --color-success: #07C160;
  --color-warning: #FF9F18;
  --color-error: #FA5151;
  --color-info: #3A86FF;

  /* ---- 兼容别名（值即令牌，禁止新增引用） ---- */
  --bg: var(--color-bg-page);
  --surface: var(--color-bg-card);
  --surface-2: var(--color-bg-disabled);
  --line: var(--color-border);
  /* 2026-10-26 用户要求：文字一律纯黑，层级靠字号与字重拉开，不再用灰阶区分。
     --color-text-secondary / --color-text-hint 仍保留在令牌表里供将来恢复灰阶 */
  --ink: var(--color-text-primary);
  --ink-2: var(--color-text-primary);
  --ink-3: var(--color-text-primary);
  --primary-fg: var(--color-text-inverse);
  --danger: var(--color-error);
  --mask: var(--color-mask);

  /* ---- 数据语义色：涨跌与状态，不参与 UI 强调 ---- */
  --up: #dc2626;
  --down: #16a34a;
  --flat: #999999;
  --up-tint: rgba(220, 38, 38, 0.08);
  --up-border: rgba(220, 38, 38, 0.28);
  --down-tint: rgba(22, 163, 74, 0.08);
  --down-border: rgba(22, 163, 74, 0.28);
  --warn: var(--color-warning);
  --warn-tint: rgba(255, 159, 24, 0.10);
  --warn-border: rgba(255, 159, 24, 0.30);

  /* ---- 描边：1rpx，卡片与分割线共用一档 ---- */
  --hairline: 1rpx solid var(--color-border);
  --hairline-dashed: 1rpx dashed var(--color-border);

  /* ---- z 层级：四档收敛 ---- */
  --z-mask: 1000;
  --z-sheet: 2000;
  --z-dialog: 3000;
  --z-toast: 4000;

  /* ---- 兼容别名：旧 z 名 ---- */
  --z-base: 0;
  --z-popup: var(--z-sheet);
  --z-modal: var(--z-dialog);

  /* ---- 基线 ---- */
  font-size: var(--font-base);
  line-height: var(--lh-base);
  color: var(--color-text-primary);
  background-color: var(--color-bg-page);
}

/* =============================================================
   字号辅助档位（设置页「字体大小」，系统级可读性开关）
   标准档严格走上面六档；「大 / 超大」整体上移 4 / 8rpx。
   ============================================================= */
.page.font-scale--large {
  --font-xs: 28rpx;
  --font-sm: 32rpx;
  --font-base: 36rpx;
  --font-lg: 40rpx;
  --font-xl: 44rpx;
  --font-2xl: 52rpx;
}

.page.font-scale--xlarge {
  --font-xs: 32rpx;
  --font-sm: 36rpx;
  --font-base: 40rpx;
  --font-lg: 44rpx;
  --font-xl: 48rpx;
  --font-2xl: 56rpx;
}

/* =============================================================
   全局工具类
   注意：@import 进来的是「全局样式」，组件样式隔离下不会穿透进
   components/* 内部节点，组件内需要时在自身 wxss 里再写一遍。
   ============================================================= */

/* 导航栏：88rpx + 安全区 + flex 垂直居中 */
.navbar {
  position: relative;
  display: flex;
  align-items: center;
  height: var(--icon-touch);
  padding-top: env(safe-area-inset-top);
  background: var(--color-bg-card);
}

/* 底部安全区兜底：吸底元素外层统一挂它，别各写 env() */
.safe-area-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

/* 卡片：白面 + 1rpx 描边 + 12rpx 圆角，默认不加阴影 */
.card {
  background: var(--color-bg-card);
  border: var(--hairline);
  border-radius: var(--radius-md);
  padding: var(--pad-normal);
}

.tabs {
  display: flex;
  gap: var(--space-lg);
}

/* 卡片消息外层：chat 主页面与卡片画廊测试页共用 */
.msg-card {
  width: 100%;
}
