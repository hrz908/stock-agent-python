/* =============================================================
   设计 Token · shadcn 风视觉语言（zinc 色阶）
   本项目唯一风格真相源，被 app.wxss @import，全站只允许引用这里的变量。

   变更沿革：
   - 2026-10-22 建立「浅色专业金融」主题（参考图三张），负责浅底 + 蓝强调色。
   - 2026-10-22 重构为 shadcn 风：色板整体换成 zinc 色阶、圆角收紧、
     卡片去投影、主按钮改近黑底白字。变量名沿用旧名，页面无需改名迁移。

   规则：
   - 变量只允许在 page{} 定义；组件通过 CSS 自定义属性继承拿到
     （styleIsolation 默认隔离不影响 custom property 透传，
     但【工具类 class 不透传】，组件内部需要自己写或 apply-shared，见 DESIGN.md）。
   - canvas（uCharts / K 线）不吃 CSS 变量，配色在各自 js 里另配一份；
     改本文件色值时必须同步那批硬编码，否则图表与页面脱色。
   ============================================================= */
page {
  /* ---- 背景与层次（shadcn：纯白底 + 白卡片 + 发丝描边 + 默认无阴影） ---- */
  --bg: #ffffff;        /* 页面背景：纯白 */
  --surface: #ffffff;   /* 卡片面 */
  --surface-2: #f4f4f5; /* 次级面：芯片底、进度槽、标签底（zinc-100） */
  --line: #e4e4e7;      /* 描边 / 分割线（zinc-200） */

  /* ---- 文字（zinc 主阶） ---- */
  --ink: #09090b;       /* 主文字 = 主按钮底（zinc-950）*/
  --ink-2: #71717a;     /* 次文字（zinc-500） */
  --ink-3: #a1a1aa;     /* 弱文字：字段说明 / 免责声明（zinc-400） */

  /* ---- 涨跌平：国内习惯红涨绿跌，与欧美相反，不要搞反 ---- */
  --up: #dc2626;        /* 涨（red-600） */
  --down: #16a34a;      /* 跌（green-600） */
  --flat: #71717a;      /* 平：shadcn 无独立平色，取辅助文字色 */

  /* ---- 强调色：shadcn 只允许「一个」强调色，用途收紧到
        链接 / 选中态 / 焦点 ring；主按钮保持近黑底，不再用蓝做主按钮 ---- */
  --accent: #2559EB;
  --primary-fg: #fafafa; /* 主按钮文字（zinc-50） */
  --ring: var(--ink);    /* 焦点描边 */

  /* ---- 状态语义色（数据/状态专用，不得挪作 UI 强调色）---- 
       以下变量是为补齐 2026-10-22 之前就在用、但从未在 token 里定义过的引用
       而补：settings 的退出登录按钮、event-card 的时间轴圆点、
       report-card 的条形图此前全部处于失效状态（元素不可见/透明）。 */
  --warn: #d97706;                     /* 警示：琥珀 amber-600，白底上对比度足够 */
  --warn-tint: rgba(217, 119, 6, 0.10);
  --warn-border: rgba(217, 119, 6, 0.30);
  --warn-soft: rgba(217, 119, 6, 0.22);
  --accent-deep: #1e40af;              /* 蓝深一档：图表主系列、条形填充 */
  --accent-soft: rgba(37, 89, 235, 0.12);
  --danger: #dc2626;                   /* 危险操作（退出登录等），与涨色同值但语义独立 */
  --danger-strong: #b91c1c;
  --danger-tint: rgba(220, 38, 38, 0.08);
  --danger-border: rgba(220, 38, 38, 0.28);
  --press: rgba(9, 9, 11, 0.05);       /* 通用按压态底色（hover-class 用） */

  /* ---- 状态淡色底与淡色描边（标签 / 药丸 / 图标底） ---- */
  --up-tint: rgba(220, 38, 38, 0.08);
  --up-border: rgba(220, 38, 38, 0.28);
  --down-tint: rgba(22, 163, 74, 0.08);
  --down-border: rgba(22, 163, 74, 0.28);
  --accent-tint: rgba(37, 89, 235, 0.08);
  --accent-border: rgba(37, 89, 235, 0.30);

  /* ---- 投影：shadcn 默认无阴影，层次靠发丝边框与留白表达。
        --shadow-card 置 none 实现「卡片去投影」；仅浮层（弹窗/toast）保留 ---- */
  --shadow-card: none;
  --shadow-pop: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);

  /* ---- 圆角（shadcn 形状规范：卡片/按钮/输入框 16rpx，标签 8rpx） ---- */
  --r-card: 16rpx;
  --r-tag: 8rpx;
  --r-nav-btn: 16rpx;
  --r-pill: 999rpx;               /* 胶囊全圆：chip / 药丸按钮 / 输入框 */

  /* ---- 字号：已向 shadcn 层级收敛（2026-10-22 用户决策）----
       原 8 档（64/56/44/40/32/28/22/20）收敛为 4 个层级值：
       hero 40（行情大数字）/ title 36（页面标题、次级主数字、品牌名）/
       body 30（正文）/ caption 24（辅助与弱辅助）。
       变量名保留不动（全站 300+ 处引用），同档变量互为语义别名：
       price/hero 同值，value/brand/title 同值，aux/min 同值。
       body 30rpx 高于原 28rpx 无障碍底线，方向为放大，无合规风险。 */
  --fs-price: 40rpx;  /* hero：行情卡主价格 */
  --fs-hero: 40rpx;   /* hero：主数字：总浮动金额 / 提醒计数 / 阈值 */
  --fs-value: 36rpx;  /* title 级：次级主数字：资金流主力净额 */
  --fs-brand: 36rpx;  /* title 级：抽屉品牌名 */
  --fs-title: 36rpx;  /* title：卡片标题 / 页面标题 */
  --fs-body: 30rpx;   /* body：正文 */
  --fs-aux: 24rpx;    /* caption：辅助 */
  --fs-min: 24rpx;    /* caption：弱辅助（已并入 caption 档）*/

  /* ---- 间距：只有这五档（8pt 栅格），任何地方不许写裸 rpx ---- */
  --sp-1: 8rpx;   /* 4px  图标与文字、紧密元素之间 */
  --sp-2: 16rpx;  /* 8px  卡片内相邻行 */
  --sp-3: 24rpx;  /* 12px 卡片内区块、行列表左右内边距 */
  --sp-4: 32rpx;  /* 16px 区块标准间距：卡片与卡片、卡片与容器边缘 */
  --sp-5: 48rpx;  /* 24px 大区块之间（如列表与底部操作区） */

  /* ---- 语义别名 ----
     TODO-restyle(阶段1B)：--pad-card(28rpx) / --gap-grid(20rpx) 现值仍非五档，
     阶段 1B 排版修复时再统一收敛到 var(--sp-*) ---- */
  /* ---- 例外档：仍被引用，原值保留，阶段 1B 再评估是否收敛进五档 ---- */
  --sp-6: 96rpx;             /* 仅 components/base/empty 首屏标识区在用 */
  --sp-card: 28rpx;          /* 仅 components/finance/_card.wxss 在用 */

  --pad-card: 28rpx;         /* 卡片内边距：原值保留，确保阶段 0 无布局位移 */
  --pad-page: var(--sp-4);   /* 页面左右留白 */
  --gap-grid: 20rpx;         /* 栅格间距：原值保留，确保阶段 0 无布局位移 */

  /* ---- 发丝线：全站分割线 / 边框统一用它，禁止再自定 border 粗细与颜色 ---- */
  --hairline: 2rpx solid var(--line);
  --hairline-dashed: 2rpx dashed var(--line);  /* 仅口径分隔这类「虚线」场景，需显式豁免 */
}

/* =============================================================
   主题：仅浅色（终局，2026-10-22 晚用户最终决策「太暗了」，回到浅色）。
   当天经历：浅色专业金融 → shadcn 亮色 → 短暂整站深色 → 回浅色，
   以本文件为准，不要再按历史记忆里的深色值改。
   原先这里有一套 page.dark 深色变量，已删除；如将来重做深色，
   从 git 历史取回变量，并先给每个页面根节点注入 theme class，
   同时同步 app.json 窗口底色与 canvas 侧 JS 配色（共 5 个文件）。
   ============================================================= */

/* =============================================================
   全局工具类（阶段 1 排版修复直接用，替代逐页手写）
   注意：这里的 class 由 app.wxss @import 引入，属「全局样式」；
   组件样式隔离（无 apply-shared）下不会穿透进 components/* 内部节点，
   组件内部需要同样写法时，在其自身 wxss 里再写一遍或用 :host 继承。
   命名提醒：components/base/navbar、components/base/tabs 内部有同名
   .navbar / .tabs 私有类，二者各自隔离互不影响，改组件时不要混引。
   ============================================================= */

/* ---- 导航栏：88rpx + 安全区 + flex 垂直居中（第 3 条） ---- */
.navbar {
  position: relative;
  display: flex;
  align-items: center;
  height: 88rpx;
  padding-top: env(safe-area-inset-top);
  background: var(--bg);
}
/* ---- 容器与按钮（shadcn 组件对应物） ---- */
.card {
  background: var(--surface);
  border: var(--hairline);
  border-radius: var(--r-card);
  padding: var(--sp-3);
  box-shadow: var(--shadow-card);
}
/* ---- 标签页：gap 管间距（第 6 条） ---- */
.tabs { display: flex; gap: var(--sp-3); }

/* ---- 卡片消息外层：chat 主页面与卡片画廊测试页共用。
       调卡片间距只改这里，两边自动同步（约定见 DESIGN.md「卡片画廊」节） ---- */
.msg-card {
  width: 100%;
}
