/* =============================================================
   设计令牌 · 最终版（唯一风格真相源，被 app.wxss @import）
   750rpx 设计稿 · 正文 32rpx 锚点 · 8 点网格

   规则：
   - 字号六档 24/28/32/36/40/48；行高只用倍率；字重 400/500/600/700
   - 间距八档 4/8/12/16/24/32/48/64；页面左右 32
   - 圆角六档 4/8/12/16/24/999；按钮与输入框 8
   - 阴影三档只给浮起元素，卡片靠描边分层
   - 颜色一律引用变量，业务样式里禁止裸 hex / 裸 rpx 字号
   - 按钮用 flex 居中 + padding 撑高，禁止写死 height

   颜色变量一律用 --primary / --bg-page / --text-primary 这类语义名，
   不加 --color- 前缀、不建兼容别名：组件只能引用本节列出的令牌。
   ============================================================= */
page {
  /* ---- 字号六档：相邻差 4rpx ---- */
  --font-xs: 24rpx;
  --font-sm: 28rpx;
  --font-base: 32rpx;
  --font-lg: 36rpx;
  --font-xl: 40rpx;
  --font-2xl: 48rpx;

  /* ---- 行高：一律倍率，禁止写死 rpx ---- */
  --lh-xs: 1.4;
  --lh-sm: 1.45;
  --lh-base: 1.5;
  --lh-lg: 1.35;
  --lh-xl: 1.25;
  --lh-2xl: 1.2;
  --lh-loose: 1.6;

  /* ---- 字间距：用 em ---- */
  --ls-xs: 0.04em;
  --ls-sm: 0.02em;
  --ls-base: 0;
  --ls-lg: 0.01em;
  --ls-xl: 0.02em;

  /* ---- 字重：随字号反向 ---- */
  --fw-regular: 400;
  --fw-medium: 500;
  --fw-semibold: 600;
  --fw-bold: 700;

  /* ---- 间距八档（8 点网格） ---- */
  --space-xxs: 4rpx;
  --space-xs: 8rpx;
  --space-sm: 12rpx;
  --space-md: 16rpx;
  --space-lg: 24rpx;
  --space-xl: 32rpx;
  --space-2xl: 48rpx;
  --space-3xl: 64rpx;

  /* ---- 内边距组合（垂直 × 水平） ---- */
  --pad-compact: var(--space-xs) var(--space-sm);
  --pad-normal: var(--space-sm) var(--space-md);
  --pad-comfy: 20rpx var(--space-lg);
  --pad-page: 0 var(--space-xl);

  /* ---- 外边距（以 32rpx 正文为锚） ---- */
  --gap-inner: var(--space-md);
  --gap-between: var(--space-lg);
  --gap-section: var(--space-2xl);

  /* ---- 图标五档：尺寸 = 相邻字号 × 1.2，随「字体大小」设置一起缩放 ----
     规范 §二：图标 = 相邻字号 ×1.2~1.5（线型取上限）。
     这里用 calc 从字号推导，字号档位一变图标自动跟着变；
     触控区 88rpx 是物理尺寸下限，不随字号缩放 */
  --icon-xs: calc(var(--font-xs) * 1.2);
  --icon-sm: calc(var(--font-sm) * 1.2);
  --icon-base: calc(var(--font-base) * 1.2);
  --icon-lg: calc(var(--font-lg) * 1.2);
  --icon-xl: calc(var(--font-xl) * 1.2);
  --icon-touch: 88rpx;

  /* ---- 圆角六档 ---- */
  --radius-xs: 4rpx;
  --radius-sm: 8rpx;
  --radius-md: 12rpx;
  --radius-lg: 16rpx;
  --radius-xl: 24rpx;
  --radius-round: 999rpx;

  /* ---- 阴影三档：只给浮起元素 ----
     阴影取文字深色的 RGB（#09090B），带一点冷调；纯黑阴影在白面上会发脏 */
  --shadow-sm: 0 2rpx 8rpx rgba(9, 9, 11, 0.06);
  --shadow-md: 0 4rpx 16rpx rgba(9, 9, 11, 0.08);
  --shadow-lg: 0 8rpx 32rpx rgba(9, 9, 11, 0.12);

  /* ===========================================================
    色彩 · shadcn zinc 中性色 + 冷蓝主色（唯一色值来源）
    palette：#FFFFFF（页面底）/ #E4E4E7（描边）/ #2363C7（主色·冷蓝）/ #09090B（文字）
    页面与卡面同为纯白，靠 1rpx 描边 + --shadow-sm 分层；
    强调色只给链接与焦点，全站饱和色只留给主色、涨跌与警告。

    分层：① 核心 9（换肤入口）② 扩展角色 ③ 数据语义色。
    铁律：业务样式只写 var(--*)；hex / rgba / 命名色只允许出现在本文件。
    =========================================================== */

  /* ---- ① 核心 9 ---- */
  --primary: #2363C7;
  --success: #16A34A;
  --warning: #F59E0B;
  --danger: #EF4444;
  --text-primary: #09090B;
  --text-secondary: #71717A;
  --text-disabled: #A1A1AA;
  --bg-page: #FFFFFF;
  --border: #E4E4E7;

  /* ---- ② 扩展角色：核心 9 之外的必需面 ---- */
  --text-hint: rgba(9, 9, 11, 0.45);     /* 角标 / 提示，不承载正文 */
  --text-inverse: #FFFFFF;               /* 反白文字（主色底、遮罩上） */
  --bg-card: #FFFFFF;                    /* 卡片 / 导航白面（与页面底同色，靠描边分层） */
  /* 次级表面（快捷提问、用户提问块、禁用按钮）用 zinc-100：
     纯白页上唯一的一层浅灰，且比描边浅一档；
     不要改回 rgba 深色叠白——叠到 0.12 正好和 --border 撞成一个灰 */
  --bg-disabled: #F4F4F5;
  --mask: rgba(9, 9, 11, 0.40);          /* 弹层遮罩 */

  /* ---- ③ 数据语义色：涨跌与状态，不参与 UI 强调 ----
     红涨绿跌是行情预期，换色会被误读：
     涨取红 600：--danger 的红 500 在白底只有 3.8:1，而涨跌数字按正文读，
     压深一档到 4.8:1 才够；
     跌绿 #15803D：白底 5.0:1，且比 --success 的 #16A34A 深一档，两枚绿不混用 */
  --up: #DC2626;
  --down: #15803D;
  --flat: var(--text-hint);
  --up-tint: rgba(220, 38, 38, 0.08);
  --up-border: rgba(220, 38, 38, 0.28);
  --down-tint: rgba(21, 128, 61, 0.08);
  --down-border: rgba(21, 128, 61, 0.28);

  /* ---- 描边：1rpx，卡片与分割线共用一档 ---- */
  --hairline: 1rpx solid var(--border);
  --hairline-dashed: 1rpx dashed var(--border);

  /* ---- z 层级：四档收敛 ---- */
  --z-mask: 1000;
  --z-sheet: 2000;
  --z-dialog: 3000;
  --z-toast: 4000;

  /* ---- 兼容别名：旧 z 名 ---- */
  --z-base: 0;
  --z-popup: var(--z-sheet);
  --z-modal: var(--z-dialog);

  /* ---- 基线 ---- */
  font-size: var(--font-base);
  line-height: var(--lh-base);
  color: var(--text-primary);
  background-color: var(--bg-page);
}

/* =============================================================
   字号辅助档位（设置页「字体大小」，系统级可读性开关）
   标准档严格走上面六档；「大 / 超大」整体上移 4 / 8rpx。
   ============================================================= */
.page.font-scale--large {
  --font-xs: 28rpx;
  --font-sm: 32rpx;
  --font-base: 36rpx;
  --font-lg: 40rpx;
  --font-xl: 44rpx;
  --font-2xl: 52rpx;
}

.page.font-scale--xlarge {
  --font-xs: 32rpx;
  --font-sm: 36rpx;
  --font-base: 40rpx;
  --font-lg: 44rpx;
  --font-xl: 48rpx;
  --font-2xl: 56rpx;
}

/* =============================================================
   全局工具类
   注意：@import 进来的是「全局样式」，组件样式隔离下不会穿透进
   components/* 内部节点，组件内需要时在自身 wxss 里再写一遍。
   ============================================================= */

/* 导航栏：88rpx + 安全区 + flex 垂直居中 */
.navbar {
  position: relative;
  display: flex;
  align-items: center;
  height: var(--icon-touch);
  padding-top: env(safe-area-inset-top);
  background: var(--bg-card);
}

/* 底部安全区兜底：吸底元素外层统一挂它，别各写 env() */
.safe-area-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

/* 卡片：白面 + 1rpx 描边 + 12rpx 圆角 + 最轻一档投影。
   页面底同为纯白，只靠描边划块会显得干，投影是分层的另一半 */
.card {
  background: var(--bg-card);
  border: var(--hairline);
  border-radius: var(--radius-md);
  padding: var(--pad-normal);
  box-shadow: var(--shadow-sm);
}

.tabs {
  display: flex;
  gap: var(--space-lg);
}

/* 卡片消息外层：chat 主页面与卡片画廊测试页共用 */
.msg-card {
  width: 100%;
}
