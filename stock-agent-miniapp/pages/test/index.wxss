/* 卡片画廊（原 K 线详情页）：页面骨架 + 卡片间距。
   卡片自身样式一律在 components/finance/* 与 styles/token.wxss，
   本文件只管骨架，避免与 chat 主页面出现两份卡片样式 */
.page {
  display: flex;
  flex-direction: column;
  height: 100%;
  overflow: hidden;
  background: var(--bg);
  position: relative;
}

.gallery {
  flex: 1;
  min-height: 0;
}

/* 卡片之间的间距：与 chat 消息流同款（--sp-3），用 gap 统一管 */
.gallery {
  display: flex;
  flex-direction: column;
  gap: var(--sp-3);
  padding: var(--sp-3) var(--sp-4) var(--sp-6);
}

/* 开发版水印：这一页全是假数据，必须在第一屏说清楚 */
.gallery-warn {
  padding: var(--sp-2) var(--sp-3);
  border: var(--hairline);
  border-radius: var(--r-tag);
  background: var(--warn-tint);
  border-color: var(--warn-border);
  font-size: var(--fs-min);
  line-height: 1.5;
  color: var(--warn);
}

/* 页眉说明：弱辅助级，不抢卡片 */
.gallery-hd {
  padding: var(--sp-1) 0 var(--sp-2);
}

.gallery-hd-t {
  font-size: var(--fs-aux);
  font-weight: 600;
  color: var(--ink-2);
}

.gallery-hd-d {
  margin-top: var(--sp-1);
  font-size: var(--fs-min);
  line-height: 1.6;
  color: var(--ink-3);
}

.gallery-ft {
  padding: var(--sp-4) 0 var(--sp-2);
  text-align: center;
  font-size: var(--fs-min);
  color: var(--ink-3);
}
