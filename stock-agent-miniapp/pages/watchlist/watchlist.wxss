/* ===== 页面骨架 ===== */
.page {
  display: flex;
  flex-direction: column;
  height: 100%;
  overflow: hidden;
  background: var(--bg-page);
  position: relative;
}

.content {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  padding: 0 var(--space-2xl);
}

/* ===== 总浮动概览卡 ===== */
.overview-card {
  flex: none;
  padding: var(--space-lg);
  background: var(--bg-card);
  border: var(--hairline);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
}

.overview-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-md);
}

/* 「自选总浮动」标题：普通（标准） */
.overview-title {
  font-size: var(--font-base);
  color: var(--text-secondary);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

/* 上涨 / 下跌两枚标签：横向并排，上涨在左、下跌在右（在 overview-head 行内）。
   例外：这两枚是总浮动卡里的计数，与同卡其它文字同为「普通」（2026-10-26 用户指定），
   不走其它 chip 的小号 */
.overview-tags {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--space-xs);
}

/* 小标签：圆角 + 发丝边框 + 浅底（设计稿 .tag 规格）。
   计数用正文字号：再小一档在长数字下读不清 */
.mini-tag {
  padding: var(--space-xs) var(--space-xs);
  border-radius: var(--radius-xs);
  border: var(--hairline);
  font-size: var(--font-base);
  background: var(--bg-disabled);
  color: var(--text-primary);
  white-space: nowrap;
}

/* 浅底上的淡色标签：淡色底 + 同色系淡描边（深色主题那套深描边在浅底发脏） */
.mini-tag--up {
  border-color: var(--up-border);
  color: var(--up);
  background: var(--up-tint);
}

.mini-tag--down {
  border-color: var(--down-border);
  color: var(--down);
  background: var(--down-tint);
}

/* 总浮动金额：全站唯一的超大号数字（--font-xl = 正文 +8rpx），
   本页最大的一处字号，其余文字都压在标准及以下 */
.hero-amount {
  margin-top: var(--space-md);
  font-size: var(--font-xl);
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: -0.5rpx;
}

.hero-amount.is-up {
  color: var(--up);
}

/* 盈亏为 0：中性色（与行情卡主价格同色），既不标红也不标绿 */
.is-flat {
  color: var(--text-secondary);
}

.hero-amount.is-down {
  color: var(--down);
}

.hero-desc {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-md);
  margin-top: var(--space-xs);
  font-size: var(--font-base);   /* 百分比 · 已同步：普通 */
  color: var(--text-secondary);
}

/* 刷新入口：无底色（与背景一致），图标与文字用主色（黑），置于 hero-desc 行右侧 */
.refresh-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-xs);
  flex: none;
}

.refresh-btn-text {
  font-size: var(--font-base);   /* 刷新：普通 */
  color: var(--text-primary);
}

/* 图标组件渲染成 <text>（行内元素），transform 对行内元素不生效，
   要旋转必须先把图标变成 inline-block */
.refresh-icon {
  display: inline-block;
}

/* 刷新中：图标旋转（WXSS 动画可用，禁用的是 hover/active 伪类） */
.refresh-btn--spinning .refresh-icon {
  animation: refresh-spin 800ms linear infinite;
}

@keyframes refresh-spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

/* ===== 筛选：占满整行的段式单选（radio） =====
   无槽底色、无滑动黑块：整条只有一个 8rpx 圆角轮廓，选中项靠字重与字色区分 */
.filter-radio {
  display: flex;
  margin-top: var(--space-lg);
  padding: var(--space-xs);
  background: var(--bg-disabled);
  border-radius: var(--radius-sm);
}
.filter-radio__item {
  flex: 1;
  min-width: 0;
  text-align: center;
  padding: var(--space-xs) 0;
  font-size: var(--font-lg);   /* 全部 / 涨幅榜 / 跌幅榜：大号 */
  color: var(--text-primary);
  border-radius: var(--radius-sm);
  transition: color .2s;
}
.filter-radio__item--on {
  background: var(--bg-card);
  color: var(--text-primary);
  font-weight: var(--fw-semibold);
}

/* ===== 列表滚动区 =====
   底边让开悬浮的「添加股票」按钮：按钮距底 20 + 按钮高 48 + 与按钮间距 16 = 84，再加安全区。
   必须用 margin 而不是 padding：padding 会计入 scroll-view 的滚动内容高度，
   结果只有一只股票也会被撑出可滚动距离（能空拖一段） */
.stock-scroll {
  flex: 1;
  /* height:0 + flex:1 把高度完全交给 flex 分配；
     min-height:0 兜住 flex item 默认的「最小内容尺寸」限制 */
  height: 0;
  min-height: 0;
  margin-top: var(--space-lg);
  margin-bottom: 84px; /* 间距条例外：同上，无安全区时的让位值 */
  margin-bottom: calc(84px + env(safe-area-inset-bottom)); /* 间距条例外：底部按钮让位值，与 JS 的 bottomGap 配套 */
}

.stock-list {
  background: var(--bg-card);
  border: var(--hairline);
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

/* ===== 自绘左滑行（替代 t-swipe-cell） ===== */
.stock-row {
  position: relative;
  overflow: hidden;
}

/* 主行：位移由 WXML 内联 transform 驱动（拖动中瞬移、松手过渡归位） */
.stock-row-main {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-md);
  padding: var(--space-md) var(--space-lg);
  background: var(--bg-card);
  transition: transform 200ms ease;
}

/* 拖动中关掉过渡：否则位移永远慢半拍 */
.stock-row--dragging .stock-row-main {
  transition: none;
}

/* 列表不画线：行间距由 padding 撑开，sep 类保留给 JS 但不再出线 */

.stock-info {
  flex: 1;
  min-width: 0;
}

.stock-name {
  font-size: var(--font-base);
  font-weight: 400;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 代码行（名称的别名）：全局小号 */
.stock-code {
  margin-top: var(--space-xs);
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

.price-note {
  flex: none;
  text-align: right;
  width: 200rpx;
}

.p1 {
  font-size: var(--font-lg);
  font-weight: var(--fw-medium);
  white-space: nowrap;
}

.p2 {
  margin-top: var(--space-xs);
  font-size: var(--font-sm);
  white-space: nowrap;
}

.up {
  color: var(--up);
}

.down {
  color: var(--down);
}

/* 左滑露出的删除区：绝对定位贴在主行之下，宽 64px（与 JS 的 SWIPE_ACTION_W 一致）。
   默认隐藏（opacity:0）：行未滑开时若常驻渲染，transform 取整会让红色
   从卡片边缘漏出 1px 红边；只在滑开/拖动中显示 */
.stock-row-action {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 64px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--space-xs);
  background: var(--danger);
  opacity: 0;
}

.stock-row--action-on .stock-row-action {
  opacity: 1;
}

.stock-row-action-text {
  font-size: var(--font-sm);
  color: var(--text-inverse); /* 深色底上的浅色文字 */
}

/* ===== 底部「添加股票」 ===== */
.bottom-btn {
  position: absolute;
  left: var(--space-2xl);
  right: var(--space-2xl);
}

/* 底部主按钮：无填充、--hairline 描边（与输入框同一套），主次只靠字色与字重 */
.add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-xs);
  min-height: var(--icon-touch);
  padding: 16rpx 32rpx;
  border-radius: var(--radius-sm);
  background: transparent;
  border: var(--hairline);
  line-height: var(--lh-base);
}

.add-btn-text {
  font-size: var(--font-lg);
  font-weight: var(--fw-medium);
  color: var(--text-primary);
}

/* ===== 添加自选表单 ===== */
.add-form {
  padding-bottom: var(--space-xs);
}

.form-field {
  margin-top: var(--space-lg);
}

/* 表单里的字段名（股票代码 / 买入单价 / 持股数量）：小号 */
.form-label {
  margin-bottom: var(--space-xs);
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 var(--space-md);
  box-sizing: border-box;
  font-size: var(--font-base);
  color: var(--text-primary);
  background: transparent;
  border: var(--hairline);
  border-radius: var(--radius-sm);
}

.form-input-placeholder {
  color: var(--text-hint);
  font-size: var(--font-base);
}

.form-error {
  margin-top: var(--space-md);
  font-size: var(--font-sm);
  color: var(--up);
}

/* 代码联想下拉：绝对定位浮在输入框下方，不挤压表单 */
.search-field {
  position: relative;
}

.search-dropdown {
  position: absolute;
  left: 0;
  right: 0;
  top: 100%;
  margin-top: var(--space-xs);
  background: var(--bg-card);
  border: var(--hairline);
  border-radius: var(--radius-md);
  overflow: hidden;
  z-index: 10;
  box-shadow: var(--shadow-md);
}

.search-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-md) var(--space-lg);
  border-bottom: var(--hairline);
  min-height: 88rpx;
}

.search-item:last-child {
  border-bottom: none;
}

.search-item-name {
  font-size: var(--font-base);
  color: var(--text-primary);
  flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

/* 下拉里的代码（名称的别名）：全局小号 */
.search-item-code {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  font-feature-settings: 'tnum';
  flex: none; white-space: nowrap;
}

/* ===== 弹窗里的交易所提示：一行一个交易所 ===== */
.add-note {
  margin-top: var(--space-lg);
  padding-top: var(--space-lg);
  border-top: var(--hairline-dashed);
}

/* 「支持这些交易所的代码前缀」与下面沪市 / 深市 / 北交所三行：小号 */
.note-title {
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

.note-row {
  display: flex;
  align-items: baseline;
  margin-top: var(--space-xs);
  font-size: var(--font-sm);
  line-height: 1.6;
}

/* 标签列固定宽度，代码前缀才能上下对齐 */
.note-label {
  flex: 0 0 96rpx;
  color: var(--text-hint);
}

.note-codes {
  flex: 1;
  color: var(--text-secondary);
}
