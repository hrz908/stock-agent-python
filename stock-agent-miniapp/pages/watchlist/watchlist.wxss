/* ===== 页面骨架 ===== */
.page {
  display: flex;
  flex-direction: column;
  height: 100%;
  overflow: hidden;
  background: var(--bg);
  position: relative;
}

.content {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  padding: 0 var(--sp-4);
}

/* ===== 总浮动概览卡 ===== */
.overview-card {
  flex: none;
  padding: var(--pad-card);
  background: var(--surface);
  border: var(--hairline);
  border-radius: var(--r-card);
}

.overview-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-2);
}

.overview-title {
  font-size: var(--fs-aux);
  color: var(--ink-3);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

/* 上涨 / 下跌两枚标签：横向并排，上涨在左、下跌在右（在 overview-head 行内） */
.overview-tags {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--sp-1);
}

/* 小标签：圆角 6px + 边框 + 浅底（设计稿 .tag 规格）。
   数据计数用辅助级字号（11px），弱辅助级（10px）在小字号下读不清 */
.mini-tag {
  padding: 4rpx 12rpx;
  border-radius: var(--r-tag);
  border: var(--hairline);
  font-size: var(--fs-aux);
  background: var(--surface-2);
  color: var(--ink-2);
  white-space: nowrap;
}

/* 浅底上的淡色标签：淡色底 + 同色系淡描边（深色主题那套深描边在浅底发脏） */
.mini-tag--up {
  border-color: var(--up-border);
  color: var(--up);
  background: var(--up-tint);
}

.mini-tag--down {
  border-color: var(--down-border);
  color: var(--down);
  background: var(--down-tint);
}

/* 总浮动金额：主数字级字号（--fs-hero）+ 等宽 */
.hero-amount {
  margin-top: var(--sp-2);
  font-size: var(--fs-hero);
  font-weight: 700;
  letter-spacing: -0.5rpx;
}

.hero-amount.is-up {
  color: var(--up);
}

/* 盈亏为 0：中性色（与行情卡主价格同色），既不标红也不标绿 */
.is-flat {
  color: var(--ink);
}

.hero-amount.is-down {
  color: var(--down);
}

.hero-desc {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-2);
  margin-top: var(--sp-1);
  font-size: var(--fs-aux);
  color: var(--ink-3);
}

/* 刷新入口：无底色（与背景一致），图标与文字用主色（黑），置于 hero-desc 行右侧 */
.refresh-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--sp-1);
  flex: none;
}

.refresh-btn-text {
  font-size: var(--fs-aux);
  color: var(--ink);
}

/* ant-icon 渲染成 <text>（行内元素），transform 对行内元素不生效，
   要旋转必须先把图标变成 inline-block */
.refresh-icon {
  display: inline-block;
}

/* 刷新中：图标旋转（WXSS 动画可用，禁用的是 hover/active 伪类） */
.refresh-btn--spinning .refresh-icon {
  animation: refresh-spin 800ms linear infinite;
}

@keyframes refresh-spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

/* ===== 筛选：占满整行的段式单选（radio） ===== */
.filter-radio {
  position: relative;            /* 滑块绝对定位基准 */
  display: flex;
  margin-top: var(--sp-3);
  padding: 4rpx;
  background: var(--surface-2);   /* 未选中槽底（zinc-100） */
  border: var(--hairline);
  border-radius: var(--r-pill);   /* 胶囊整体圆角 */
  overflow: hidden;
}
/* 滑动黑块（选中态）：与「添加股票」按钮同款近黑底白字 */
.filter-radio__thumb {
  position: absolute;
  top: 4rpx;
  bottom: 4rpx;
  left: 4rpx;
  background: var(--ink);
  border-radius: var(--r-pill);
  pointer-events: none;          /* 不拦截点击，事件落到文字项 */
  transition: transform .25s cubic-bezier(.4, 0, .2, 1);  /* 滑动动画 */
  z-index: 0;
}
.filter-radio__item {
  position: relative;            /* 文本层压在滑块之上 */
  z-index: 1;
  flex: 1;
  min-width: 0;
  text-align: center;
  padding: 14rpx 0;
  font-size: var(--fs-body);
  color: var(--ink-2);
  border-radius: var(--r-pill);
  transition: color .2s;
}
.filter-radio__item--on {
  color: var(--primary-fg);      /* 选中：白字（黑底由滑块提供） */
  font-weight: 600;
}

/* ===== 列表滚动区 =====
   底边让开悬浮的「添加股票」按钮：按钮距底 20 + 按钮高 48 + 与按钮间距 16 = 84，再加安全区。
   必须用 margin 而不是 padding：padding 会计入 scroll-view 的滚动内容高度，
   结果只有一只股票也会被撑出可滚动距离（能空拖一段） */
.stock-scroll {
  flex: 1;
  /* height:0 + flex:1 把高度完全交给 flex 分配；
     min-height:0 兜住 flex item 默认的「最小内容尺寸」限制 */
  height: 0;
  min-height: 0;
  margin-top: var(--sp-3);
  margin-bottom: 84px; /* 间距条例外：同上，无安全区时的让位值 */
  margin-bottom: calc(84px + env(safe-area-inset-bottom)); /* 间距条例外：底部按钮让位值，与 JS 的 bottomGap 配套 */
}

.stock-list {
  background: var(--surface);
  border: var(--hairline);
  border-radius: var(--r-card);
  overflow: hidden;
}

/* ===== 自绘左滑行（替代 t-swipe-cell） ===== */
.stock-row {
  position: relative;
  overflow: hidden;
}

/* 主行：位移由 WXML 内联 transform 驱动（拖动中瞬移、松手过渡归位） */
.stock-row-main {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-2);
  padding: var(--sp-3) var(--pad-card);
  background: var(--surface);
  transition: transform 200ms ease;
}

/* 拖动中关掉过渡：否则位移永远慢半拍 */
.stock-row--dragging .stock-row-main {
  transition: none;
}

/* 行与行之间的分隔线：sep 由 JS 按行号算好（WXSS 禁用兄弟选择器）。
   最后一条的分隔线由 .stock-list 的 overflow:hidden + 圆角裁掉 */
.stock-row-main--sep {
  border-top: var(--hairline);
}

.stock-info {
  flex: 1;
  min-width: 0;
}

.stock-name {
  font-size: var(--fs-body);
  font-weight: 500;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stock-code {
  margin-top: var(--sp-1);
  font-size: var(--fs-aux);
  color: var(--ink-3);
}

.price-note {
  flex: none;
  text-align: right;
  width: 200rpx;
}

.p1 {
  font-size: var(--fs-title);
  font-weight: 600;
  white-space: nowrap;
}

.p2 {
  margin-top: var(--sp-1);
  font-size: var(--fs-aux);
  white-space: nowrap;
}

.up {
  color: var(--up);
}

.down {
  color: var(--down);
}

/* 左滑露出的删除区：绝对定位贴在主行之下，宽 64px（与 JS 的 SWIPE_ACTION_W 一致）。
   默认隐藏（opacity:0）：行未滑开时若常驻渲染，transform 取整会让红色
   从卡片边缘漏出 1px 红边；只在滑开/拖动中显示 */
.stock-row-action {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 64px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  background: var(--up);
  opacity: 0;
}

.stock-row--action-on .stock-row-action {
  opacity: 1;
}

.stock-row-action-text {
  font-size: var(--fs-min);
  color: var(--primary-fg); /* 深色底上的浅色文字 */
}

/* ===== 底部「添加股票」 ===== */
.bottom-btn {
  position: absolute;
  left: var(--sp-4);
  right: var(--sp-4);
}

/* 底部主按钮：shadcn 近黑底白字（原主行动蓝已按 DESIGN.md「强调色收口」
   降级为链接/选中态专用，主按钮不再用蓝；重投影一并去除） */
.add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--sp-1);
  height: 96rpx;
  border-radius: var(--r-card);
  background: var(--ink);
  box-shadow: var(--shadow-card);
}

.add-btn-text {
  font-size: var(--fs-body);
  font-weight: 600;
  /* 蓝底按钮上的文字反白（原金色底用深色字，主题切蓝后必须跟着换） */
  color: var(--primary-fg); /* 深色底上的浅色文字 */
}

/* ===== 添加自选表单 ===== */
.add-form {
  padding-bottom: var(--sp-1);
}

.form-field {
  margin-top: var(--sp-3);
}

.form-label {
  margin-bottom: var(--sp-1);
  font-size: var(--fs-aux);
  color: var(--ink-3);
}

.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 var(--sp-3);
  box-sizing: border-box;
  font-size: var(--fs-body);
  color: var(--ink);
  background: var(--surface-2);
  border: var(--hairline);
  border-radius: var(--r-tag);
}

.form-input-placeholder {
  color: var(--ink-3);
  font-size: var(--fs-body);
}

.form-error {
  margin-top: var(--sp-2);
  font-size: var(--fs-aux);
  color: var(--up);
}

/* 代码联想下拉：绝对定位浮在输入框下方，不挤压表单 */
.search-field {
  position: relative;
}

.search-dropdown {
  position: absolute;
  left: 0;
  right: 0;
  top: 100%;
  margin-top: var(--sp-1);
  background: var(--surface);
  border: var(--hairline);
  border-radius: var(--r-tag);
  box-shadow: var(--shadow-pop);
  overflow: hidden;
  z-index: 10;
}

.search-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--sp-2) var(--sp-3);
  border-bottom: var(--hairline);
  min-height: 88rpx;
}

.search-item:last-child {
  border-bottom: none;
}

.search-item-name {
  font-size: var(--fs-body);
  color: var(--ink);
  flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

.search-item-code {
  font-size: var(--fs-aux);
  color: var(--ink-3);
  font-feature-settings: 'tnum';
  flex: none; white-space: nowrap;
}

/* ===== 弹窗里的交易所提示：一行一个交易所 ===== */
.add-note {
  margin-top: var(--sp-4);
  padding-top: var(--sp-3);
  border-top: var(--hairline-dashed);
}

.note-title {
  font-size: var(--fs-aux);
  color: var(--ink-3);
}

.note-row {
  display: flex;
  align-items: baseline;
  margin-top: var(--sp-1);
  font-size: var(--fs-aux);
  line-height: 1.6;
}

/* 标签列固定宽度，代码前缀才能上下对齐 */
.note-label {
  flex: 0 0 96rpx;
  color: var(--ink-2);
}

.note-codes {
  flex: 1;
  color: var(--ink-3);
}
