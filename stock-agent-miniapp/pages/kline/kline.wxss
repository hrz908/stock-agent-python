/* ===== 页面骨架：与设置 / 提醒页同一套（固定页头 + 单块滚动区） ===== */
.page {
  display: flex;
  flex-direction: column;
  height: 100%;
  overflow: hidden;
  background: var(--bg);
  position: relative;
}

.content {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  padding: var(--space-lg) var(--space-xl) 0;
}

/* ===== 搜索框 =====
   联想结果是绝对定位浮层：只盖住下方卡片，不把卡片整体往下推。
   关键是 .search-field 自己建层（position + z-index），否则同层的 scroll-view
   会后绘制、把浮层切掉一半（早前踩过）。K 线图是 SVG 背景图不是 canvas，
   view 可以正常压在它上面，不需要 cover-view 那套 */
.search-field {
  flex: none;
  position: relative;
  z-index: 10;
}

.search-box {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  height: 88rpx;
  padding: 0 var(--space-lg);
  box-sizing: border-box;
  background: var(--surface);
  border: var(--hairline);
  border-radius: var(--radius-sm);
  box-shadow: var(--shadow-sm);
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 100%;
  font-size: var(--font-base);
  color: var(--ink);
}

.search-ph {
  color: var(--ink-3);
  font-size: var(--font-base);
}

/* 清除键：原生 input 没有内建清除，自绘一个（热区 56rpx 足够点中） */
.search-clear {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--radius-round);
}

/* 联想结果：浮层，左对齐搜索框、宽度贴合（左右 0），从搜索框底边向下展开 */
.search-drop {
  position: absolute;
  left: 0;
  right: 0;
  top: 100%;
  margin-top: var(--space-xs);
  z-index: 10;
  background: var(--surface);
  border: var(--hairline);
  border-radius: var(--radius-sm);
  box-shadow: var(--shadow-md);
  overflow: hidden;
}

.search-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-md) var(--space-lg);
  border-bottom: var(--hairline);
}

.search-item:last-child {
  border-bottom: none;
}

.search-item-name {
  font-size: var(--font-base);
  color: var(--ink);
}

/* 下拉里的代码（别名）：全局小号 */
.search-item-code {
  font-size: var(--font-sm);
  color: var(--ink-3);
}

/* ===== 当前股票 =====
   左：名称 + 代码（整体可被压缩出省略号）；右：刷新按钮由 margin-left:auto 顶到最右，
   名称再长也不会把刷新挤出行外 */
.picked {
  flex: none;
  display: flex;
  align-items: center;
  gap: var(--space-md);
  margin-top: var(--space-lg);
}

.picked-id {
  display: flex;
  align-items: baseline;
  gap: var(--space-md);
  min-width: 0;
}

.picked-name {
  min-width: 0;
  font-size: var(--font-base);
  font-weight: 600;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 当前股票代码（名称的别名）：全局小号 */
.picked-code {
  flex: none;
  font-size: var(--font-sm);
  color: var(--ink-3);
}

/* 刷新入口：无底色，图标 + 文字，与自选股页的刷新同一个样子 */
.picked-refresh {
  flex: none;
  display: inline-flex;
  align-items: center;
  gap: var(--space-xs);
  margin-left: auto;
  padding: var(--space-xs);
}

.picked-refresh-text {
  font-size: var(--font-sm);
  color: var(--ink);
}

/* 图标组件渲染成 <text>（行内元素），transform 对行内元素不生效，
   要旋转必须先把图标变成 inline-block */
.picked-refresh-icon {
  display: inline-block;
}

/* 刷新中：图标旋转（与自选股页同一套节奏） */
.picked-refresh--spinning .picked-refresh-icon {
  animation: picked-refresh-spin 800ms linear infinite;
}

@keyframes picked-refresh-spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

/* ===== 五张 K 线卡 =====
   只有这一块滚动：搜索框与联想结果固定在上方，不随卡片滚走 */
.card-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
  margin-top: var(--space-lg);
}

.card-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
  /* 底部留白：最后一张卡不要贴着屏幕底边 */
  padding-bottom: var(--space-2xl);
}
