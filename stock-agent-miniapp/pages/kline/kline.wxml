<!-- 页面结构：自研 navbar + 顶部模糊搜索（带联想下拉）+ 五张固定周期 K 线卡。
     五张卡进页面就存在（空值占位），选中股票后各自换数据，卡片位置不跳。
     搜索下拉绝对定位浮在卡片之上，避免被滚动区裁掉。 -->
<view class="page {{fontScaleClass}}">
  <base-navbar left-arrow="{{true}}" bind:back="goBack" />
  <view class="content">
    <view class="search-field">
      <view class="search-box">
        <base-icon type="SearchOutline" style="font-size:var(--icon-sm);color:var(--text-primary);" />
        <input class="search-input" value="{{keyword}}" placeholder="股票代码 / 名称 / 拼音" placeholder-class="search-ph" bindinput="onSearchInput" />
        <view wx:if="{{keyword}}" class="search-clear" bindtap="onSearchClear">
          <base-icon type="CloseOutline" style="font-size:var(--icon-xs);color:var(--text-primary);" />
        </view>
      </view>
      <!-- 联想结果：选中即关闭下拉并触发五张卡拉数 -->
      <view wx:if="{{results.length > 0}}" class="search-drop">
        <view class="search-item" wx:for="{{results}}" wx:for-item="item" wx:key="code" data-code="{{item.code}}" data-name="{{item.name}}" data-market="{{item.market}}" bindtap="onSelectStock">
          <text class="search-item-name">{{item.name}}</text>
          <text class="search-item-code num">{{item.market}}{{item.code}}</text>
        </view>
      </view>
    </view>
    <!-- 当前股票：没选时不占位，卡片直接接在搜索框下面；刷新按钮靠右 -->
    <view wx:if="{{stock}}" class="picked">
      <view class="picked-id">
        <text class="picked-name">{{stock.name}}</text>
        <text class="picked-code num">{{stock.market}}{{stock.code}}</text>
      </view>
      <view class="picked-refresh {{loading ? 'picked-refresh--spinning' : ''}}" bindtap="onRefresh">
        <base-icon class-name="picked-refresh-icon" type="LoopOutline" style="font-size:var(--icon-xs);color:var(--text-primary);" />
        <text class="picked-refresh-text">刷新</text>
      </view>
    </view>
    <scroll-view class="card-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view class="card-list">
        <kline-card wx:for="{{cards}}" wx:for-item="card" wx:key="key" title="{{card.label}}" subtitle="{{stockLabel}}" placeholder="{{loading ? '加载中…' : (stock ? '暂无数据' : '搜索并选择股票后展示')}}" klines="{{card.klines}}" ma="{{card.ma}}" period-pct="{{card.periodPct}}" amplitude="{{card.amplitude}}" volume-ratio="{{card.volumeRatio}}" support="{{card.support}}" resistance="{{card.resistance}}" />
        <view class="page-disclaimer">K 线数据来自公开行情，仅供参考，不构成任何投资建议。</view>
      </view>
    </scroll-view>
  </view>
  <base-toast id="base-toast" />
</view>