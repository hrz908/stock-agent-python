/* ===== 页面骨架 ===== */
.page {
  display: flex;
  flex-direction: column;
  /* 用 100% 而非 100vh：vh 是固定像素，键盘弹起时重算会与键盘动画不同步导致跳变 */
  height: 100%;
  overflow: hidden;
  background: var(--bg);
  /* 自身作为定位容器：输入栏用 absolute 而非 fixed，
     页面转场动画期间不会因 fixed 元素单独定位而与页面错位 */
  position: relative;
}

/* ===== 对话区 ===== */
/* 高度由 JS 精算并固定为像素值：不随视口变化抖动，也不会被子元素撑开 */
.chat-wrap {
  flex: none;
  width: 100%;
  overflow: hidden;
}

/* 顶栏左侧：打开侧边抽屉的菜单图标。
   尺寸 / 圆角与 navbar 的 .nav-btn 对齐（同一条竖线、88rpx 触摸目标）；
   点按不再有原生「闪一下」的高亮 */
.nav-menu-btn {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--r-nav-btn);
  -webkit-tap-highlight-color: transparent;
}

.chat-scroll {
  height: 100%;
}

/* 水平留白放在滚动内容上，避免贴到屏幕边缘；
   底部再补一档内边距，滚到底时免责声明不至于贴着容器边。
   overflow: hidden 让容器自成 BFC，子元素的 margin 不会溢出到容器外面 */
.chat-inner {
  padding: 0 var(--sp-3) var(--sp-3);
  overflow: hidden;
}

/* ===== 消息间距 =====
   消息之间统一用上边距（不由组件的 margin-bottom 决定）：
   第一条上方是本容器的上边距，最后一条下方彻底为 0。
   AI 回复没有气泡外壳，轮次之间必须留足一整档才分得开 */
.msg {
  margin-top: var(--sp-5);
}

/* ===== 用户提问：右对齐浅底小块 =====
   不用近黑实底：每次提问都是一块黑，会把视线从回答上拽走 */
.msg--user {
  display: flex;
  justify-content: flex-end;
}

.bubble--user {
  max-width: 80%;
  padding: var(--sp-2) var(--sp-3);
  background: var(--surface-2);
  border-radius: var(--r-card) var(--r-card) var(--r-tag) var(--r-card);
}

.bubble-text {
  font-size: var(--fs-body);
  line-height: 1.6;
  color: var(--ink);
  white-space: pre-wrap;
  word-break: break-word;
}

/* ===== AI 回复：不包气泡，挂左侧页边线 =====
   白底页面再套白底描边气泡只是噪音；回答靠留白与页边线定位，
   一屏里「包起来的盒子」只剩金融卡与用户提问，数量不再随字数增长 */
.msg--assistant {
  display: flex;
  justify-content: flex-start;
}

.bubble--assistant {
  max-width: 100%;
  padding: var(--sp-1) 0 var(--sp-1) var(--sp-3);
  background: transparent;
  border: none;
  border-left: 2rpx solid var(--line); /* 例外：页边线是版式标记，不走 --hairline */
  border-radius: 0;
}

/* ===== markdown 版式 =====
   容器开 pre-wrap：换行由 utils/markdown.js 合并进行内文本段 */
.md-h {
  font-weight: 600;
  color: var(--ink);
  line-height: 1.4;
}

.md-h--lg {
  font-size: var(--fs-title);
  margin: var(--sp-2) 0 var(--sp-1);
}

.md-h--sm {
  font-size: var(--fs-body);
  margin: var(--sp-2) 0 var(--sp-1);
}

.md-p {
  font-size: var(--fs-body);
  line-height: 1.7;
  color: var(--ink);
  white-space: pre-wrap;
  word-break: break-word;
}

/* 引用：左竖线 + 次级文字（视觉稿 .quote 规格） */
.md-quote {
  margin: var(--sp-2) 0;
  padding: var(--sp-1) 0 var(--sp-1) var(--sp-2);
  border-left: 4rpx solid var(--line); /* 第8条例外：引用线是 4rpx 强调竖线，不适用 --hairline */
  font-size: var(--fs-aux);
  line-height: 1.7;
  color: var(--ink-2);
  white-space: pre-wrap;
  word-break: break-word;
}

.md-hr {
  height: 0;
  margin: var(--sp-3) 0;
  border-top: var(--hairline);
}

/* 代码块：等宽 + 次级面 */
.md-code {
  margin: var(--sp-2) 0;
  padding: var(--sp-2) var(--sp-3);
  background: var(--surface-2);
  border: var(--hairline);
  border-radius: var(--r-tag);
  overflow: hidden;
}

.md-code-text {
  font-family: Menlo, Consolas, "Liberation Mono", monospace;
  font-size: var(--fs-aux);
  line-height: 1.6;
  color: var(--ink-2);
  white-space: pre;
}

/* 列表：标记 + 内容两段，嵌套层缩进 */
.md-list {
  margin: var(--sp-2) 0;
}

.md-li {
  display: flex;
  align-items: flex-start;
  gap: var(--sp-1);
  margin-top: var(--sp-1);
}

.md-li--sub {
  margin-left: var(--sp-3);
}

.md-li-marker {
  flex: none;
  min-width: var(--sp-3);
  font-size: var(--fs-body);
  line-height: 1.7;
  color: var(--ink-3);
}

.md-li-body {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-body);
  line-height: 1.7;
  color: var(--ink);
  white-space: pre-wrap;
  word-break: break-word;
}

/* 表格：div 行模拟（WXSS 无 table 版式需求，flex 更可控） */
.md-table {
  margin: var(--sp-2) 0;
  border: var(--hairline);
  border-radius: var(--r-tag);
  overflow: hidden;
}

.md-tr {
  display: flex;
}

/* 行间分隔线：sep 由 utils/markdown.js 按行号算好（WXSS 禁兄弟选择器） */
.md-tr--sep {
  border-top: var(--hairline);
}

.md-tr--head {
  background: var(--surface-2);
  border-bottom: var(--hairline);
}

.md-th,
.md-td {
  flex: 1;
  min-width: 0;
  padding: var(--sp-1) var(--sp-2);
  font-size: var(--fs-aux);
  line-height: 1.5;
}

.md-th {
  color: var(--ink-3);
  font-weight: 500;
}

.md-td {
  color: var(--ink-2);
  word-break: break-word;
}

/* 行内样式 */
.md-i {
  white-space: pre-wrap;
}

.md-strong {
  font-weight: 600;
  color: var(--ink);
}

.md-em {
  font-style: italic;
}

.md-del {
  text-decoration: line-through;
  color: var(--ink-3);
}

/* 行内代码：等宽 + 次级面小底 */
.md-code.md-i {
  padding: 0 var(--sp-1);
  border-radius: var(--r-tag);
  background: var(--surface-2);
  font-family: Menlo, Consolas, "Liberation Mono", monospace;
  font-size: 0.9em;
  color: var(--ink);
  white-space: pre-wrap;
}

/* 链接：图表蓝 + 下划线；点击复制（见 onMdLinkTap） */
.md-link {
  color: var(--accent);
  text-decoration: underline;
}

/* ===== 气泡内的金融卡（components/finance/*） ===== */
/* 卡片消息：气泡退让成透明容器，卡片自带 surface 底 / 描边 / 内边距，
   避免「卡中卡」的双层底；宽度拉满一行。
   width:100% 必须显式写：.msg--assistant 是 flex 行容器，flex 子项默认按
   内容收缩（fit-content），卡片的 width:100% 只能参照这个收缩宽，
   结果卡片只有内容宽；显式 100% 才会占满整个消息行 */
.bubble--bare {
  width: 100%;
  max-width: 100%;
  padding: 0;
  background: transparent;
  border: none;
  border-left: none; /* 卡片自带外壳，页边线也要撤掉，否则卡外多一条竖线 */
}

/* .msg-card 已上收到 styles/token.wxss（与卡片画廊测试页共用，避免两边漂移） */

/* 红涨绿跌（国内习惯） */
.up {
  color: var(--up);
}

.down {
  color: var(--down);
}

/* ===== 状态提示（正在思考 / 工具查询 / 重连） =====
   与 AI 回复共用同一条页边线，不单独占一个盒子 */
.status-tip {
  display: flex;
  align-items: center;
  gap: var(--sp-1);
  width: fit-content;
  max-width: 80%;
  margin-top: var(--sp-4);
  padding: var(--sp-1) 0 var(--sp-1) var(--sp-3);
  border-left: 2rpx solid var(--line); /* 例外：页边线是版式标记，不走 --hairline */
}

.status-tip-text {
  font-size: var(--fs-aux);
  color: var(--ink-2);
}

/* 三个跳动小点：代替 loading 图标，错相延迟形成波浪感 */
.status-dots {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: none;
}

.status-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background-color: var(--ink-3);
  animation: status-blink 1.2s infinite ease-in-out;
}

.status-dot:nth-child(2) {
  animation-delay: 0.2s;
}

.status-dot:nth-child(3) {
  animation-delay: 0.4s;
}

/* 思考气泡：代替底部小条，作为 AI 回复位置的占位加载态 */
.thinking-bubble {
  display: flex;
  align-items: center;
  padding: var(--sp-2) 0 var(--sp-2) var(--sp-3);
}

.thinking-dots {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: none;
}

.thinking-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: var(--ink-3);
  animation: status-blink 1.2s infinite ease-in-out;
}

.thinking-dot:nth-child(2) {
  animation-delay: 0.2s;
}

.thinking-dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes status-blink {
  0%, 60%, 100% {
    opacity: 0.35;
    transform: translateY(0);
  }
  30% {
    opacity: 1;
    transform: translateY(-4rpx);
  }
}

/* ===== 首屏引导问题 =====
   只有问候语时出现，点一下等于发送（chat.js onQuickAsk）。
   省掉「我能问什么」这一轮思考，首屏不再是白纸 */
.quick-asks {
  display: flex;
  flex-direction: column;
  gap: var(--sp-2);
  margin-top: var(--sp-4);
}

.quick-asks-title {
  font-size: var(--fs-aux);
  color: var(--ink-3);
}

.quick-ask {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-2);
  min-height: 88rpx;
  padding: 0 var(--sp-3);
  background: transparent;
  border: var(--hairline);
  border-radius: var(--r-pill);
  box-shadow: var(--shadow-card);
}

.quick-ask-text {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-body);
  color: var(--ink);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

/* ===== 免责声明（合规兜底条，所有回答底部固定挂载） =====
   纯文字不占盒子：每屏都在的固定元素，越安静越好 */
.disclaimer {
  margin-top: var(--sp-5);
  font-size: var(--fs-min);
  line-height: 1.7;
  color: var(--ink-3);
}

/* scroll-into-view 锚点：0 高度，仅用于把列表滚到底 */
.chat-anchor {
  height: 0;
}

/* ===== 输入栏 ===== */
/* 绝对定位于页面容器内（等价于 fixed，但会随页面一起参与转场动画） */
.sender-wrap {
  position: absolute;
  left: 0;
  right: 0;
  /* bottom 由页面按键盘高度驱动：卡片上移与对话区收窄共用同一份数据 */
  bottom: 0;
  background: var(--bg);
  transition: bottom 0.25s ease;
  /* 胶囊与屏幕两侧留白；下内边距由内联样式给：键盘弹起时为 0，否则让出安全区 */
  padding: var(--sp-2) var(--sp-3) 0;
  box-sizing: border-box;
}

/* 胶囊本体：一条圆角条，左端模式键、右端发送键，中间是输入区或语音键。
   键盘态与语音态**同一套底色**：切换只换文字与图标，不做整条变色 */
.sender-bar {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  min-height: 96rpx;
  /* 胶囊整体上移一档（--sp-2 = 16rpx = 8px）。
     注意只能加在胶囊「下方」：容器是底部锚定的，加大上方留白（padding-top）
     只会把对话区挤短，胶囊本身不会动 */
  margin-bottom: var(--sp-2);
  padding: var(--sp-1) 12rpx;
  box-sizing: border-box;
  background: var(--surface);
  border: var(--hairline);
  border-radius: var(--r-pill);
  box-shadow: var(--shadow-pop);
}

/* 模式键（语音 / 键盘）：无底灰图标 / 灰字，两态一致，只换内容。
   发送键才是唯一的主按键；热区 88rpx，点按不出现原生高亮 */
.bar-btn {
  position: relative;
  flex: none;
  width: 88rpx;
  height: 88rpx;
  box-sizing: border-box;
  border-radius: 50%;
  /* 与发送键同款圆圈：两个圆钮分列胶囊两端，视觉上对称 */
  border: var(--hairline);
  box-shadow: var(--shadow-card);
  color: var(--ink-2);
  -webkit-tap-highlight-color: transparent;
}

/* 两个图标叠在同一格，靠 opacity 交叉淡入。
   必须绝对定位 + display:block：ant-icon 渲染成行内 text，
   行内元素不吃 transform，居中会偏 */
.bar-btn-mic,
.bar-btn-keyboard {
  position: absolute;
  left: 50%;
  top: 50%;
  display: block;
  transform: translate(-50%, -50%);
  transition: opacity 180ms ease;
}

.bar-btn-mic {
  opacity: 1;
}

.bar-btn-keyboard {
  opacity: 0;
}

.bar-btn--voice .bar-btn-mic {
  opacity: 0;
}

.bar-btn--voice .bar-btn-keyboard {
  opacity: 1;
}

/* ===== 语音输入 ===== */
/* 预输入文字框：点一下语音键后贴在输入栏正上方（sender-wrap 是绝对定位容器，
   bottom:100% 即容器上沿），不占布局高度，也不会把对话区挤短。
   出现时从下往上淡入，避免文字突然糊上来 */
.voice-panel {
  position: absolute;
  left: var(--sp-3);
  right: var(--sp-3);
  bottom: 100%;
  margin-bottom: var(--sp-2);
  padding: 0 var(--sp-3) var(--sp-3);
  background: var(--surface);
  border: var(--hairline);
  border-radius: var(--r-card);
  box-shadow: var(--shadow-pop);
  animation: voice-live-in 160ms ease both;
}

/* 头部：波形 + 说明 + 取消。88rpx 是「取消」的最小热区，
   顺带把这一行撑成面板的标题行 */
.voice-panel-hd {
  display: flex;
  align-items: center;
  gap: var(--sp-1);
  min-height: 88rpx;
}

.voice-panel-tip {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-aux);
  color: var(--ink-2);
}

.voice-panel-cancel {
  flex: none;
  display: flex;
  align-items: center;
  padding-left: var(--sp-3);
  font-size: var(--fs-aux);
  color: var(--ink-3);
}

/* 波形：三根竖条错相跳动。用强调色而不是红/绿——红绿在这里会被读成涨跌 */
.voice-wave {
  flex: none;
  display: flex;
  align-items: center;
  gap: 4rpx;
  height: 28rpx;
}

.voice-wave-bar {
  width: 6rpx;
  height: 10rpx;
  border-radius: 3rpx;
  background: var(--accent);
  animation: voice-wave 900ms ease-in-out infinite;
}

.voice-wave-bar:nth-child(2) {
  animation-delay: 150ms;
}

.voice-wave-bar:nth-child(3) {
  animation-delay: 300ms;
}

@keyframes voice-wave {
  0%, 100% { height: 10rpx; opacity: 0.45; }
  50% { height: 28rpx; opacity: 1; }
}

/* 实时转写：最多三行，超出省略。空串时由 JS 给「请说话…」占位 */
.voice-panel-text {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
  font-size: var(--fs-body);
  line-height: 1.6;
  color: var(--ink);
  word-break: break-word;
}

.voice-panel-text--empty {
  color: var(--ink-3);
}

@keyframes voice-live-in {
  from {
    opacity: 0;
    transform: translateY(8rpx);
  }
  to {
    opacity: 1;
    transform: none;
  }
}

/* 输入区：紧贴模式键右侧，多行时随内容长高（textarea auto-height） */
.bar-field {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  /* 上下留白把单行文字垂直居中；多行时 auto-height 会把胶囊一起撑高 */
  padding: var(--sp-2) 0;
}

.bar-input {
  width: 100%;
  /* 一行高度打底（line-height 44rpx）：auto-height 的空 textarea 高度可能塌成 0，
     没有热区就点不中、placeholder 也看不见。
     最多两行 = 88rpx，超出后 textarea 内部滚动，不再把对话区顶掉 */
  min-height: 44rpx;
  max-height: 88rpx;
  font-size: var(--fs-body);
  line-height: 44rpx;
  color: var(--ink);
}

/* 语音键：和输入区同占中间剩余宽度。两态都在同一条白胶囊里，
   不再需要深色底、绝对定位和那一串 z-index */
.bar-hold {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-body);
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  -webkit-tap-highlight-color: transparent;
}

/* 发送键：不填充，圆圈描边与输入框同款（--hairline），靠墨色图标表达主次 */
.bar-send {
  flex: none;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: transparent;
  border: var(--hairline);
  box-shadow: var(--shadow-card);
  color: var(--ink);
  display: flex;
  align-items: center;
  justify-content: center;
  -webkit-tap-highlight-color: transparent;
  /* 常驻节点，切换时只变描边与字色：给过渡就顺滑，不给就是硬切 */
  transition: color 180ms ease, border-color 180ms ease;
}

/* 语音态：连圆圈也去掉，只留图标。胶囊里没有文字可发，
   这个键的语义变成「收尾并发出」——未在聆听时与左端模式键同灰，
   聆听中才提到正文字色，表示此刻可点 */
.bar-send--plain {
  background: transparent;
  border-color: transparent;
  /* 描边都撤了，投影一起撤，否则图标像浮在半空 */
  box-shadow: none;
  color: var(--ink-2);
}

.bar-send--plain.bar-send--live {
  color: var(--ink);
}

/* 加载态：方块代替发送图标（沿用 chat-sender 的「停止」观感）。
   按键不再有填充，方块随按钮前景色走 */
.bar-send-stop {
  width: 26rpx;
  height: 26rpx;
  border-radius: var(--r-tag);
  background: var(--ink);
}

.bar-send--plain .bar-send-stop {
  background: var(--ink-2);
}

/* 中间区（输入框 / 语音键）不做进场动画：
   这两个节点是 wx:if 互斥的，每次切换都会「销毁 + 重建」，
   挂淡入等于每切一次就从透明淡上来一遍——那正是切换时看到的闪。
   直接换节点、靠上面的图标交叉淡入承担过渡即可 */

/* ===== 侧边抽屉 =====
   竖向三层：头部与导航固定 → 历史对话自己滚（吃掉剩余高度）
   → 「新对话」钉死在底部 */
.drawer-body {
  width: 520rpx;
  height: 100%;
  display: flex;
  flex-direction: column;
  /* 上下内边距由内联样式提供：上方避让状态栏，下方与输入栏共用安全区 */
  padding: 0;
  box-sizing: border-box;
  overflow: hidden;
}

.drawer-head {
  flex: none;
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  padding: var(--sp-3) var(--sp-3) var(--sp-4);
}

.drawer-logo {
  flex: none;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  overflow: hidden;
  background: var(--surface-2);
}

.drawer-title-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: var(--sp-1);
}

.drawer-title {
  font-size: var(--fs-title);
  font-weight: 700;
  color: var(--ink);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

.drawer-sub {
  font-size: var(--fs-aux);
  color: var(--ink-3);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

/* 新对话按键：抽屉底部的主行动点，落在拇指区。
   外盒的内边距 / 描边 / 内容高度全部照抄 .sender-bar（输入栏），
   两边用同一个公式算高度——写死一个 rpx 值会在不同换算下差半像素 */
.drawer-new {
  flex: none;
  /* 下边距与 .sender-bar 相同（--sp-2），配合抽屉底部安全区内边距对齐 */
  margin: var(--sp-3) var(--sp-3) var(--sp-2);
  padding: var(--sp-1) 12rpx;
  box-sizing: border-box;
  background: transparent;
  border: var(--hairline);
  border-radius: var(--r-tag);
  box-shadow: var(--shadow-card);
}

/* 88rpx = .sender-bar 里 .bar-btn 的高度，撑起与输入栏一致的高度 */
.drawer-new-inner {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--sp-2);
}

.drawer-new-text {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--ink);
}

/* 创建中：底色不变，只把整块压暗一档 + 转圈，提示「在忙」而不是「点了没反应」。
   小程序没有 hover 态（按需求取消），禁用期间靠 JS 的 newChatting 闸门兜住 */
.drawer-new--loading {
  opacity: 0.72;
}

/* 转圈：与图标同尺寸（32rpx），描边随按钮前景色（按键已无填充，用墨色） */
.drawer-new-spinner {
  width: 32rpx;
  height: 32rpx;
  box-sizing: border-box;
  border: 4rpx solid var(--ink);
  border-top-color: transparent;
  border-radius: 50%;
  animation: drawer-new-spin 0.8s linear infinite;
}

@keyframes drawer-new-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* 导航：纯行，不再套分组外框。
   图标承担识别，所以连「导航」小标题也省掉了 */
.drawer-nav {
  flex: none;
  padding: 0 var(--sp-3);
}

.drawer-item {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  min-height: 96rpx;
  padding: 0 var(--sp-2);
  border-radius: var(--r-tag);
}

/* 文字吃满剩余宽度，右侧箭头自然贴边 */
.drawer-item-text {
  flex: 1;
  font-size: var(--fs-body);
  color: var(--ink);
  text-align: left;
  min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

/* ===== 历史对话：只有这一块滚 ===== */
.drawer-history {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  padding: 0 var(--sp-3) var(--sp-1);
}

/* 历史区独占「历史对话」标题与底部按钮之间的全部高度：
   内容超出由 scroll-view 自己裁掉（overflow 不外溢），
   滚动条一律不画——enhanced + show-scrollbar=false 管原生层，
   下面这条 webkit 兜底防某些内核仍画出细条 */
.history-scroll {
  flex: 1;
  min-height: 0;
  overflow-x: hidden;
}

.history-scroll::-webkit-scrollbar {
  width: 0;
  height: 0;
  display: none;
}

.drawer-section-title {
  flex: none;
  padding: var(--sp-3) var(--sp-2) var(--sp-2);
  font-size: var(--fs-aux);
  font-weight: 600;
  color: var(--ink-2);
}

/* 会话行：平时无壳，当前会话才套一个方框。
   透明边框常驻占位，选中时只改颜色——加边不加边会让行高与文字左右位移；
   行与行之间留一档间距，选中框才不会和上下行贴在一起 */
.history-item {
  display: flex;
  align-items: center;
  height: 88rpx;
  margin-bottom: var(--sp-2);
  padding: 0 var(--sp-1) 0 var(--sp-2);
  border: 2rpx solid transparent;
  border-radius: var(--r-tag);
}

/* 当前会话：方框 + 投影，与全站「浮起面」同一套 */
.history-item--active {
  border-color: var(--line);
  box-shadow: var(--shadow-card);
}

.history-item-main {
  flex: 1;
  min-width: 0;
}

.history-item-title {
  display: block;
  font-size: var(--fs-body);
  color: var(--ink-2);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

.history-item--active .history-item-title {
  color: var(--ink);
  font-weight: 600;
}

/* 删除入口：88rpx 热区，catchtap 防冒泡（不会误触选中） */
.history-item-del {
  flex: none;
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.history-empty {
  padding: var(--sp-4) 0;
  text-align: center;
  font-size: var(--fs-aux);
  color: var(--ink-3);
}
