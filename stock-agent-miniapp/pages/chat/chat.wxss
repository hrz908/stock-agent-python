/* 聊天页字级：一律跟随设置页的全局字号档位（token.wxss 的 .page.font-scale--*）。
   2026-10-26 决策：原先这里把本页整体放大一档（body 36，且各档另配一套值），
   与全局档位两套并存；现已弃用，回复正文直接用 --font-base，不要再在本页覆盖字号。 */

/* ===== 页面骨架 ===== */
.page {
  display: flex;
  flex-direction: column;
  /* 用 100% 而非 100vh：vh 是固定像素，键盘弹起时重算会与键盘动画不同步导致跳变 */
  height: 100%;
  overflow: hidden;
  background: var(--bg-page);
  /* 自身作为定位容器：输入栏用 absolute 而非 fixed，
     页面转场动画期间不会因 fixed 元素单独定位而与页面错位 */
  position: relative;
}

/* ===== 对话区 ===== */
/* 高度由 JS 精算并固定为像素值：不随视口变化抖动，也不会被子元素撑开 */
.chat-wrap {
  flex: none;
  width: 100%;
  overflow: hidden;
}

/* 顶栏左侧：打开侧边抽屉的菜单图标。
   尺寸 / 圆角与 navbar 的 .nav-btn 对齐（同一条竖线、88rpx 触摸目标）；
   点按不再有原生「闪一下」的高亮 */
.nav-menu-btn {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 0;
  -webkit-tap-highlight-color: transparent;
}

.chat-scroll {
  height: 100%;
}

/* 水平留白放在滚动内容上，避免贴到屏幕边缘；
   底部再补一档内边距，滚到底时免责声明不至于贴着容器边。
   overflow: hidden 让容器自成 BFC，子元素的 margin 不会溢出到容器外面 */
.chat-inner {
  padding: 0 var(--space-lg) var(--space-lg);
  overflow: hidden;
}

/* ===== 消息间距 =====
   消息之间统一用上边距（不由组件的 margin-bottom 决定）：
   第一条上方是本容器的上边距，最后一条下方彻底为 0。
   AI 回复没有气泡外壳，轮次之间必须留足一整档才分得开 */
.msg {
  margin-top: var(--space-lg);
}

/* ===== 用户提问：右对齐浅底小块 =====
   不用近黑实底：每次提问都是一块黑，会把视线从回答上拽走 */
.msg--user {
  display: flex;
  justify-content: flex-end;
}

.bubble--user {
  max-width: 80%;
  padding: var(--space-md) var(--space-lg);
  background: var(--bg-disabled);
  border-radius: var(--radius-md);
}

.bubble-text {
  font-size: var(--font-base);
  line-height: 1.7;
  color: var(--text-primary);
  white-space: pre-wrap;
  word-break: break-word;
}

/* ===== AI 回复：不包气泡，挂左侧页边线 =====
   白底页面再套白底描边气泡只是噪音；回答靠留白与页边线定位，
   一屏里「包起来的盒子」只剩金融卡与用户提问，数量不再随字数增长 */
.msg--assistant {
  display: flex;
  justify-content: flex-start;
}

.bubble--assistant {
  max-width: 100%;
  padding: var(--space-xs) 0 var(--space-xs) var(--space-lg);
  background: transparent;
  border: none;
  border-left: 1rpx solid var(--border); /* 例外：页边线是版式标记，不走 --hairline */
  border-radius: var(--radius-md);
}

/* ===== markdown 版式 =====
   换行只由行内片段（.md-i 的 pre-wrap）承接，块容器保持默认 white-space：
   容器一旦 pre-wrap，WXML 里的模板缩进就会变成空白行（见 chat.wxml 的 mdInline） */
.md-h {
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.4;
}

.md-h--lg {
  font-size: var(--font-lg);
  margin: var(--space-md) 0 var(--space-xs);
}

.md-h--sm {
  font-size: var(--font-base);
  margin: var(--space-md) 0 var(--space-xs);
}

.md-p {
  font-size: var(--font-base);
  line-height: 1.7;
  color: var(--text-primary);
  word-break: break-word;
}

/* 段间距只留一档：换行已由 markdown.js 折叠，块与块之间靠外边距呼吸。
   用 --space-md 而不是 --space-xs：行距放宽后 8rpx 已看不出段与段的分界 */
.md-p + .md-p {
  margin-top: var(--space-md);
}

/* 引用：左竖线 + 次级文字（视觉稿 .quote 规格） */
.md-quote {
  margin: var(--space-md) 0;
  padding: var(--space-xs) 0 var(--space-xs) var(--space-md);
  border-left: 4rpx solid var(--border); /* 第8条例外：引用线是 4rpx 强调竖线，不适用 --hairline */
  font-size: var(--font-sm);
  line-height: 1.7;
  color: var(--text-secondary);
  word-break: break-word;
}

.md-hr {
  height: 0;
  margin: var(--space-lg) 0;
  border-top: var(--hairline);
}

/* 代码块：等宽 + 次级面 */
.md-code {
  margin: var(--space-md) 0;
  padding: var(--space-md) var(--space-lg);
  background: var(--bg-disabled);
  border: var(--hairline);
  border-radius: var(--radius-sm);
  overflow: hidden;
}

.md-code-text {
  font-family: Menlo, Consolas, "Liberation Mono", monospace;
  font-size: var(--font-sm);
  line-height: 1.5;
  color: var(--text-primary);
  white-space: pre;
}

/* 列表：标记 + 内容两段，嵌套层缩进 */
.md-list {
  margin: var(--space-md) 0;
}

.md-li {
  display: flex;
  align-items: flex-start;
  gap: var(--space-xs);
}

/* 条目之间才留间距：首条贴着列表上沿，不额外顶出一档 */
.md-li + .md-li {
  margin-top: var(--space-md);
}

.md-li--sub {
  margin-left: var(--space-lg);
}

.md-li-marker {
  flex: none;
  min-width: var(--space-lg);
  font-size: var(--font-base);
  line-height: 1.7; /* 与 .md-li-body 同值，否则标记与首行文字光学错位 */
  color: var(--text-secondary);
}

.md-li-body {
  flex: 1;
  min-width: 0;
  font-size: var(--font-base);
  line-height: 1.7;
  color: var(--text-primary);
  word-break: break-word;
}

/* 表格：div 行模拟（WXSS 无 table 版式需求，flex 更可控） */
.md-table {
  margin: var(--space-md) 0;
  border: var(--hairline);
  border-radius: var(--radius-sm);
  overflow: hidden;
}

.md-tr {
  display: flex;
}

/* 行间分隔线：sep 由 utils/markdown.js 按行号算好（WXSS 禁兄弟选择器） */
.md-tr--sep {
  border-top: var(--hairline);
}

.md-tr--head {
  background: var(--bg-disabled);
  border-bottom: var(--hairline);
}

.md-th,
.md-td {
  flex: 1;
  min-width: 0;
  padding: var(--space-xs) var(--space-md);
  font-size: var(--font-sm);
  line-height: 1.5;
}

.md-th {
  color: var(--text-secondary);
  font-weight: 400;
}

.md-td {
  color: var(--text-primary);
  word-break: break-word;
}

/* 行内样式 */
.md-i {
  white-space: pre-wrap;
}

.md-strong {
  font-weight: 600;
  color: var(--text-primary);
}

.md-em {
  font-style: italic;
}

.md-del {
  text-decoration: line-through;
  color: var(--text-secondary);
}

/* 行内代码：等宽 + 次级面小底。
   独立类名，不复用块级 .md-code——复用会把块级的外边距与描边一起带进来 */
.md-code-inline {
  padding: 0 var(--space-xs);
  border-radius: var(--radius-sm);
  background: var(--bg-disabled);
  font-family: Menlo, Consolas, "Liberation Mono", monospace;
  font-size: var(--font-sm);   /* 与块级 .md-code-text 同档，跟随字号设置 */
  color: var(--text-primary);
  white-space: pre-wrap;
}

/* 链接：黛青 + 下划线；点击复制（见 onMdLinkTap） */
.md-link {
  /* 强调色收口：链接是 --primary 的合法用法之一 */
  color: var(--primary);
  text-decoration: underline;
}

/* ===== 气泡内的金融卡（components/finance/*） ===== */
/* 卡片消息：气泡退让成透明容器，卡片自带 surface 底 / 描边 / 内边距，
   避免「卡中卡」的双层底；宽度拉满一行。
   width:100% 必须显式写：.msg--assistant 是 flex 行容器，flex 子项默认按
   内容收缩（fit-content），卡片的 width:100% 只能参照这个收缩宽，
   结果卡片只有内容宽；显式 100% 才会占满整个消息行 */
.bubble--bare {
  width: 100%;
  max-width: 100%;
  padding: 0;
  background: transparent;
  border: none;
  border-left: none; /* 卡片自带外壳，页边线也要撤掉，否则卡外多一条竖线 */
}

/* .msg-card 已上收到 styles/token.wxss（与卡片画廊测试页共用，避免两边漂移） */

/* 红涨绿跌（国内习惯） */
.up {
  color: var(--up);
}

.down {
  color: var(--down);
}

/* ===== AI 加载态（等待回复 / 取数 / 长耗时 / 重连） =====
   与 AI 回复共用同一条页边线与左对齐：位置本身就在说「回答会出现这里」，
   不额外造一个盒子，也不占满一行。
   主角是一句话（正文字号 + 主色 + 500），动效只留三个点；
   「这一轮是活的」靠动效表达，不靠彩色底、不靠渐变 */
/* 间距沿用 .bubble--assistant（sp-1 上下 + sp-3 左），这里只加呼吸 */
.ai-load {
  animation: ai-load-breathe 2.4s ease-in-out infinite;
}

.ai-load-hd {
  display: flex;
  align-items: flex-start;
  gap: var(--space-md);
}

/* 三个点与首行文字光学居中：文字行高 54rpx（36 × 1.5）、点高 12rpx，
   上留一档 --space-lg 贴齐首行基线 */
.ai-load-dots {
  display: flex;
  align-items: center;
  gap: var(--space-xs);
  flex: none;
  margin-top: var(--space-lg);
}

.ai-load-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background-color: var(--text-primary);
  animation: ai-load-blink 1.4s infinite ease-in-out;
}

.ai-load-dot:nth-child(2) {
  animation-delay: 0.16s;
}

.ai-load-dot:nth-child(3) {
  animation-delay: 0.32s;
}

.ai-load-copy {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  min-width: 0;
}

.ai-load-text {
  font-size: var(--font-base);
  font-weight: 400;
  line-height: 1.5;
  color: var(--text-primary);
}

/* 补充说明只服务长耗时档：弱一档字号与字色，读不读都不影响理解 */
.ai-load-hint {
  font-size: var(--font-sm);
  line-height: 1.5;
  color: var(--text-hint);
}

/* 三点呼吸：只走透明度与缩放，不做位移——位移会带动整块文字视觉抖动 */
@keyframes ai-load-blink {
  0%, 70%, 100% {
    opacity: 0.18;
    transform: scale(0.78);
  }
  35% {
    opacity: 1;
    transform: scale(1);
  }
}

/* 页边线呼吸：只在中性灰之间走，不做彩色分割线 */
@keyframes ai-load-breathe {
  0%, 100% {
    border-left-color: var(--border);
  }
  50% {
    border-left-color: var(--text-primary);
  }
}

/* ===== 生成中光标 =====
   跟在正文末尾，比另挂一条「生成中」横条更贴近「字还在往外走」这件事 */
.md-caret-row {
  display: flex;
  align-items: center;
  gap: var(--space-xs);
  margin-top: var(--space-xs);
}

.md-caret {
  width: 4rpx;
  height: 36rpx;
  flex: none;
  border-radius: 0;
  background: var(--text-primary);
  animation: md-caret-blink 1s infinite;
}

.md-caret-text {
  font-size: var(--font-sm);
  line-height: 1.5;
  color: var(--text-secondary);
}

@keyframes md-caret-blink {
  0%, 45% {
    opacity: 1;
  }
  50%, 100% {
    opacity: 0.15;
  }
}

/* ===== 历史消息分片入口 =====
   长会话首屏只渲染最近一批，更早的点这里向前补一页（见 chat.js 的 onLoadEarlier） */
.load-earlier {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--icon-touch);
  margin-bottom: var(--space-lg);
  border-radius: var(--radius-sm);
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

/* ===== 首屏引导问题 =====
   空会话时出现，点一下等于发送（chat.js onQuickAsk）。
   省掉「我能问什么」这一轮思考，首屏不再是白纸 */
.quick-asks {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
  margin-top: var(--space-lg);
}

/* 首屏引导区标题：全局小号（与分节标题同档） */
.quick-asks-title {
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

/* 引导问题：次级胶囊（浅灰底、无描边），与主行动点区分 */
.quick-ask {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-md);
  min-height: 80rpx;
  padding: var(--space-md) var(--space-lg);
  background: var(--bg-disabled);
  border-radius: var(--radius-sm);
}

/* 维度标签（盘面 / 资金 / 基本面…）：纯文字 + 一条发丝分隔线，
   不加底色，避免四条建议各带一个色块抢走问句本身的注意力。
   标签统一走全局小号（--font-sm） */
.quick-ask-tag {
  flex: none;
  padding-right: var(--space-md);
  font-size: var(--font-sm);
  line-height: 1.2;
  color: var(--text-secondary);
}

/* 问句最多两行：股票名 + 代码 + 上下文一句话，单行放不下时截断会把问句砍半，
   用户就没法判断点下去会问什么。
   字号与正文同档（--font-base，32rpx）：引导问题也是要读的句子，不再另设小一号 */
.quick-ask-text {
  flex: 1;
  min-width: 0;
  font-size: var(--font-base);
  line-height: 1.4;
  color: var(--text-primary);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* ===== 免责声明（合规兜底条，所有回答底部固定挂载） =====
   纯文字不占盒子：每屏都在的固定元素，越安静越好 */
.disclaimer {
  margin-top: var(--space-lg);
  font-size: var(--font-sm);   /* 全局小号：与标签同档 */
  line-height: 1.7;
  color: var(--text-hint);
}

/* ===== 输入栏 ===== */
/* 绝对定位于页面容器内（等价于 fixed，但会随页面一起参与转场动画） */
.sender-wrap {
  position: absolute;
  left: 0;
  right: 0;
  /* bottom 由页面按键盘高度驱动：卡片上移与对话区收窄共用同一份数据 */
  bottom: 0;
  background: var(--bg-page);
  transition: bottom 0.25s ease;
  /* 输入栏与屏幕两侧留白；下内边距由内联样式给：键盘弹起时为 0，否则让出安全区 */
  padding: var(--space-md) var(--space-lg) 0;
  box-sizing: border-box;
}

/* 输入栏本体：一条 8rpx 圆角条，左端模式键、右端发送键，中间是输入区或语音键。
   键盘态与语音态**同一套底色**：切换只换文字与图标，不做整条变色 */
.sender-bar {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  min-height: 96rpx;
  /* 输入栏整体上移一档（--space-md = 16rpx = 8px）。
     注意只能加在输入栏「下方」：容器是底部锚定的，加大上方留白（padding-top）
     只会把对话区挤短，输入栏本身不会动 */
  margin-bottom: var(--space-md);
  padding: var(--space-xs) var(--space-xs);
  box-sizing: border-box;
  background: var(--bg-card);
  border: var(--hairline);
  border-radius: var(--radius-sm);
}

/* 模式键（语音 / 键盘）：无底灰图标 / 灰字，两态一致，只换内容。
   发送键才是唯一的主按键；热区 88rpx，点按不出现原生高亮。
   不画外圈：输入栏本身已有描边，键内再套一个圆圈会和它抢线 */
.bar-btn {
  position: relative;
  flex: none;
  width: var(--icon-touch);
  height: var(--icon-touch);
  box-sizing: border-box;
  border-radius: 999rpx;
  color: var(--text-primary);
  -webkit-tap-highlight-color: transparent;
}

/* 两个图标叠在同一格，靠 opacity 交叉淡入。
   必须绝对定位 + display:block：图标组件渲染成行内 text，
   行内元素不吃 transform，居中会偏 */
.bar-btn-mic,
.bar-btn-keyboard {
  position: absolute;
  left: 50%;
  top: 50%;
  display: block;
  transform: translate(-50%, -50%);
  transition: opacity 180ms ease;
}

.bar-btn-mic {
  opacity: 1;
}

.bar-btn-keyboard {
  opacity: 0;
}

.bar-btn--voice .bar-btn-mic {
  opacity: 0;
}

.bar-btn--voice .bar-btn-keyboard {
  opacity: 1;
}

/* ===== 语音输入 ===== */
/* 预输入文字框：点一下语音键后贴在输入栏正上方（sender-wrap 是绝对定位容器，
   bottom:100% 即容器上沿），不占布局高度，也不会把对话区挤短。
   出现时从下往上淡入，避免文字突然糊上来 */
.voice-panel {
  position: absolute;
  left: var(--space-lg);
  right: var(--space-lg);
  bottom: 100%;
  margin-bottom: var(--space-md);
  padding: 0 var(--space-lg) var(--space-lg);
  background: var(--bg-card);
  border: var(--hairline);
  border-radius: var(--radius-md);
  animation: voice-live-in 160ms ease both;
  box-shadow: var(--shadow-md);
}

/* 头部：波形 + 说明 + 取消。88rpx 是「取消」的最小热区，
   顺带把这一行撑成面板的标题行 */
.voice-panel-hd {
  display: flex;
  align-items: center;
  gap: var(--space-xs);
  min-height: 88rpx;
}

.voice-panel-tip {
  flex: 1;
  min-width: 0;
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

.voice-panel-cancel {
  flex: none;
  display: flex;
  align-items: center;
  padding-left: var(--space-lg);
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

/* 波形：三根竖条错相跳动。用强调色而不是红/绿——红绿在这里会被读成涨跌 */
.voice-wave {
  flex: none;
  display: flex;
  align-items: center;
  gap: var(--space-xs);
  height: 28rpx;
}

.voice-wave-bar {
  width: var(--space-xs);
  height: var(--space-xs);
  border-radius: 999rpx;
  background: var(--text-primary);
  animation: voice-wave 900ms ease-in-out infinite;
}

.voice-wave-bar:nth-child(2) {
  animation-delay: 150ms;
}

.voice-wave-bar:nth-child(3) {
  animation-delay: 300ms;
}

@keyframes voice-wave {
  0%, 100% { height: var(--space-xs); opacity: 0.45; }
  50% { height: 28rpx; opacity: 1; }
}

/* 实时转写：最多三行，超出省略。空串时由 JS 给「请说话…」占位 */
.voice-panel-text {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
  font-size: var(--font-base);
  line-height: 1.6;
  color: var(--text-primary);
  word-break: break-word;
}

.voice-panel-text--empty {
  color: var(--text-hint);
}

/* 已停录：波形换成静止圆点，一眼区分「还在听」和「已经停了等你发」 */
.voice-hold-dot {
  flex: none;
  width: var(--space-sm);
  height: var(--space-sm);
  border-radius: var(--radius-round);
  background: var(--text-disabled);
}

/* 同传方向：可点的小胶囊，点一下中英互换 */
.voice-panel-lang {
  flex: none;
  padding: var(--space-xxs) var(--space-sm);
  border: var(--hairline);
  border-radius: var(--radius-round);
  font-size: var(--font-xs);
  color: var(--text-secondary);
  white-space: nowrap;
}

/* 播报开关：图标键，开启时提亮到正文字色；关闭态不能点出声 */
.voice-panel-speak {
  flex: none;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-round);
  color: var(--text-disabled);
}

.voice-panel-speak--on {
  color: var(--text-primary);
}

/* 译文：与原文用虚线分开，字号小一档、颜色弱一档，最多三行 */
.voice-panel-dst {
  margin-top: var(--space-sm);
  padding-top: var(--space-sm);
  border-top: var(--hairline-dashed);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
  font-size: var(--font-sm);
  line-height: 1.6;
  color: var(--text-secondary);
  word-break: break-word;
}

.voice-panel-dst-wait {
  color: var(--text-hint);
}

/* 失败提示用警告色：这是「为什么慢」的唯一可见线索（插件限流只表现为变慢） */
.voice-panel-dst-fail {
  color: var(--warning);
}

@keyframes voice-live-in {
  from {
    opacity: 0;
    transform: translateY(8rpx);
  }
  to {
    opacity: 1;
    transform: none;
  }
}

/* 输入区：紧贴模式键右侧，多行时随内容长高（textarea auto-height） */
.bar-field {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  /* 上下留白把单行文字垂直居中；多行时 auto-height 会把输入栏一起撑高 */
  padding: var(--space-md) 0;
}

.bar-input {
  width: 100%;
  /* 一行高度打底（line-height 52rpx，随正文字号放大）：auto-height 的空 textarea
     高度可能塌成 0，没有热区就点不中、placeholder 也看不见。
     最多两行 = 104rpx，超出后 textarea 内部滚动，不再把对话区顶掉 */
  min-height: 52rpx;
  max-height: 104rpx;
  font-size: var(--font-base);
  line-height: 52rpx;
  color: var(--text-primary);
}

/* 占位文案：与输入文字同档。
   原先写在 textarea 的 placeholder-style 行内（36rpx），既不跟「字体大小」设置，
   又比正文大 6rpx；改成 class 与全站其他输入框（.form-input-placeholder）一致 */
.bar-input-placeholder {
  color: var(--text-hint);
  font-size: var(--font-base);
}

/* 语音键：和输入区同占中间剩余宽度。两态都在同一条白底输入栏里，
   不再需要深色底、绝对定位和那一串 z-index。
   三态文案（点击聆听 / 再点发送 / 正在转写…）用全局大号 + 加粗，
   与「新对话」这类主行动点同档，一眼能看出这里可点 */
.bar-hold {
  flex: 1;
  min-width: 0;
  min-height: var(--icon-touch);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-lg);
  font-weight: var(--fw-medium);
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  -webkit-tap-highlight-color: transparent;
}

/* 发送键：纯图标按钮，无底色无描边，靠图标本身表达主次。
   幽灵态（语音模式，无内容可发）退成更淡的图标色 */
.bar-send {
  flex: none;
  width: var(--icon-touch);
  height: var(--icon-touch);
  border-radius: 999rpx;
  background: transparent;
  color: var(--text-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  -webkit-tap-highlight-color: transparent;
  /* 常驻节点，切换时只变字色：给过渡就顺滑，不给就是硬切 */
  transition: color 180ms ease;
}

/* 语音态：输入栏里没有文字可发，这个键的语义变成「收尾并发出」——
   未在聆听时与左端模式键同灰，聆听中才提到正文字色，表示此刻可点 */
.bar-send--plain {
  background: transparent;
  color: var(--text-primary);
}

.bar-send--plain.bar-send--live {
  color: var(--text-primary);
}

/* 加载态：方块代替发送图标（沿用 chat-sender 的「停止」观感）。
   按键不再有填充，方块随按钮前景色走 */
.bar-send-stop {
  width: var(--space-lg);
  height: var(--space-lg);
  border-radius: 999rpx;
  background: var(--text-primary);
}

.bar-send--plain .bar-send-stop {
  background: var(--text-primary);
}

/* 中间区（输入框 / 语音键）不做进场动画：
   这两个节点是 wx:if 互斥的，每次切换都会「销毁 + 重建」，
   挂淡入等于每切一次就从透明淡上来一遍——那正是切换时看到的闪。
   直接换节点、靠上面的图标交叉淡入承担过渡即可 */

/* ===== 侧边抽屉 =====
   竖向三层：头部与导航固定 → 历史对话自己滚（吃掉剩余高度）
   → 「新对话」钉死在底部。
   字级只用全局档位派生的小号 / 标准 / 大号（--font-sm / --font-base / --font-lg），
   不写死 rpx，跟着设置页的字号档位一起缩放：
     小号 = 品牌副标题、导航与历史对话的分节标题
     标准 = 历史会话行
     大号 = 四个跳转按键、「新对话」 */
.drawer-body {
  width: 520rpx;
  height: 100%;
  display: flex;
  flex-direction: column;
  /* 上下内边距由内联样式提供：上方避让状态栏，下方与输入栏共用安全区 */
  padding: 0;
  box-sizing: border-box;
  overflow: hidden;
}

.drawer-head {
  flex: none;
  display: flex;
  align-items: center;
  gap: var(--space-md);
  padding: var(--space-lg) var(--space-lg) var(--space-lg);
}

.drawer-logo {
  flex: none;
  width: 112rpx;   /* 2026-10-26：头像放大一号（原 96） */
  height: 112rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: var(--bg-disabled);
}

.drawer-title-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
}

/* 品牌名：大号（与导航行同档，靠 700 字重压住层级） */
.drawer-title {
  font-size: var(--font-lg);
  font-weight: var(--fw-medium);
  color: var(--text-primary);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

/* 品牌副标题（昵称别名）：小号 */
.drawer-sub {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

/* 新对话按键：抽屉底部的主行动点，落在拇指区。
   外盒的内边距 / 描边 / 内容高度全部照抄 .sender-bar（输入栏），
   两边用同一个公式算高度——写死一个 rpx 值会在不同换算下差半像素 */
.drawer-new {
  flex: none;
  /* 下边距与 .sender-bar 相同（--space-md），配合抽屉底部安全区内边距对齐 */
  margin: var(--space-lg) var(--space-lg) var(--space-md);
  padding: var(--space-xs);
  box-sizing: border-box;
  /* 抽屉里唯一的主动作：无填充、--hairline 描边（按键与输入栏同一套语言） */
  background: transparent;
  border: var(--hairline);
  border-radius: var(--radius-sm);
}

/* 88rpx = .sender-bar 里 .bar-btn 的高度，撑起与输入栏一致的高度 */
.drawer-new-inner {
  min-height: var(--icon-touch);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-md);
}

/* 底部主行动点：大号（与四个跳转按键同档） */
.drawer-new-text {
  font-size: var(--font-lg);
  font-weight: var(--fw-medium);
  color: var(--text-primary);
}

/* 创建中：底色不变，只把整块压暗一档 + 转圈，提示「在忙」而不是「点了没反应」。
   小程序没有 hover 态（按需求取消），禁用期间靠 JS 的 newChatting 闸门兜住 */
.drawer-new--loading {
  opacity: 0.72;
}

/* 转圈：与图标同尺寸（32rpx），描边随按钮前景色（按键已无填充，用墨色） */
.drawer-new-spinner {
  width: 32rpx;
  height: 32rpx;
  box-sizing: border-box;
  border: 4rpx solid var(--text-primary);
  border-top-color: transparent;
  border-radius: 999rpx;
  animation: drawer-new-spin 0.8s linear infinite;
}

@keyframes drawer-new-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* 导航：纯行，不再套分组外框，但补一个与「历史对话」同款的小标题 */
.drawer-nav {
  flex: none;
  padding: 0 var(--space-lg);
}

/* 导航标题复用 .drawer-section-title，只掐掉上间距：
   头部已经留了 sp-4，再叠一层 sp-3 会空出一大块 */
.drawer-nav-title {
  padding-top: 0;
}

/* 四个导航键：底色与抽屉底同一个令牌（base-popup 左抽屉也是 --bg-disabled），
   两块看起来是一整片；不做白卡、不加投影——抽屉里只有历史会话行还是白卡 */
.drawer-item {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  min-height: 96rpx;
  margin-bottom: var(--space-xs);
  padding: 0 var(--space-md);
  background: var(--bg-disabled);
  border-radius: var(--radius-sm);
}

/* 文字吃满剩余宽度，右侧箭头自然贴边。
   大号 + 字重 500：单靠字号或单靠字重都显得要么太轻要么太硬 */
.drawer-item-text {
  flex: 1;
  font-size: var(--font-lg);
  font-weight: 400;
  color: var(--text-primary);
  text-align: left;
  min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

/* ===== 历史对话：只有这一块滚 ===== */
.drawer-history {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  padding: 0 var(--space-lg) var(--space-xs);
}

/* 历史区独占「历史对话」标题与底部按钮之间的全部高度：
   内容超出由 scroll-view 自己裁掉（overflow 不外溢），
   滚动条一律不画——enhanced + show-scrollbar=false 管原生层，
   下面这条 webkit 兜底防某些内核仍画出细条 */
.history-scroll {
  flex: 1;
  min-height: 0;
  overflow-x: hidden;
}

.history-scroll::-webkit-scrollbar {
  width: 0;
  height: 0;
  display: none;
}

/* 分节标题（导航 / 历史对话）：小号 */
.drawer-section-title {
  flex: none;
  padding: var(--space-lg) var(--space-md) var(--space-md);
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--text-secondary);
}

/* 会话行：底色与抽屉底同一片（--bg-disabled），不套白卡、不加边框；
   行与行之间留一档间距，免得几条会话糊成一坨 */
.history-item {
  display: flex;
  align-items: center;
  height: 88rpx;
  margin-bottom: var(--space-md);
  padding: 0 var(--space-xs) 0 var(--space-md);
  background: var(--bg-disabled);
  border-radius: var(--radius-sm);
}

.history-item-main {
  flex: 1;
  min-width: 0;
}

/* 历史会话行：标准（正文一档） */
.history-item-title {
  display: block;
  font-size: var(--font-base);
  color: var(--text-primary);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

/* 当前会话：只靠 600 字重区分（不加底色差、不加竖条、不加描边） */
.history-item--active .history-item-title {
  color: var(--text-primary);
  font-weight: 600;
}

/* 删除入口：88rpx 热区，catchtap 防冒泡（不会误触选中） */
.history-item-del {
  flex: none;
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.history-empty {
  padding: var(--space-lg) 0;
  text-align: center;
  font-size: var(--font-sm);
  color: var(--text-hint);
}

/* ===== 知识库引用来源 =====
   挂在 assistant 气泡底部：一行标题 + 若干条标题文本。
   用 --text-primary 弱化，避免和正文抢注意力；分隔线用 --hairline（1rpx） */
.msg-sources {
  margin-top: var(--space-md);
  padding-top: var(--space-sm);
  border-top: var(--hairline);
}

.msg-sources-title {
  display: block;
  font-size: var(--font-xs);
  line-height: var(--lh-sm);
  letter-spacing: var(--ls-xs);
  color: var(--text-hint);
}

.msg-sources-list {
  margin-top: 4rpx;
  display: flex;
  flex-direction: column;
}

.msg-sources-item {
  font-size: var(--font-xs);
  line-height: var(--lh-base);
  color: var(--text-hint);
}
