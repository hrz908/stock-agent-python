/* ===== 页面骨架 ===== */
.page {
  display: flex;
  flex-direction: column;
  /* 用 100% 而非 100vh：vh 是固定像素，键盘弹起时重算会与键盘动画不同步导致跳变 */
  height: 100%;
  overflow: hidden;
  background: var(--bg);
  /* 自身作为定位容器：输入栏用 absolute 而非 fixed，
     页面转场动画期间不会因 fixed 元素单独定位而与页面错位 */
  position: relative;
}

/* ===== 对话区 ===== */
/* 高度由 JS 精算并固定为像素值：不随视口变化抖动，也不会被子元素撑开 */
.chat-wrap {
  flex: none;
  width: 100%;
  overflow: hidden;
}

/* 顶栏左侧：打开侧边抽屉的菜单图标。
   尺寸 / 圆角与 navbar 的 .nav-btn 对齐（同一条竖线、88rpx 触摸目标）；
   点按不再有原生「闪一下」的高亮 */
.nav-menu-btn {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--r-nav-btn);
  -webkit-tap-highlight-color: transparent;
}

.chat-scroll {
  height: 100%;
}

/* 水平留白放在滚动内容上，避免贴到屏幕边缘；
   底部再补一档内边距，滚到底时免责声明不至于贴着容器边。
   overflow: hidden 让容器自成 BFC，子元素的 margin 不会溢出到容器外面 */
.chat-inner {
  padding: 0 var(--sp-3) var(--sp-3);
  overflow: hidden;
}

/* ===== 消息间距 =====
   消息之间统一用上边距（不由组件的 margin-bottom 决定）：
   第一条上方是本容器的上边距，最后一条下方彻底为 0 */
.msg {
  margin-top: var(--sp-4);
}

/* ===== 用户气泡：右对齐，主行动蓝实底 + 白字（参考图 chat 页） ===== */
.msg--user {
  display: flex;
  justify-content: flex-end;
}

/* 用户气泡：shadcn primary 近黑底（原先用主行动蓝，属大面积强调色，
   违反「强调色只做链接/焦点」的收口规则） */
.bubble--user {
  max-width: 80%;
  padding: var(--sp-2) var(--sp-3);
  background: var(--ink);
  border-radius: var(--r-tag) var(--r-tag) 0 var(--r-tag);
}

/* 蓝底上文字必须反白，否则 var(--ink) 近黑字看不见 */
.bubble--user .bubble-text {
  color: var(--primary-fg); /* 深色底上的浅色文字 */
}

.bubble-text {
  font-size: var(--fs-body);
  line-height: 1.6;
  color: var(--ink);
  white-space: pre-wrap;
  word-break: break-word;
}

/* ===== AI 气泡：左对齐卡片面 ===== */
.msg--assistant {
  display: flex;
  justify-content: flex-start;
}

.bubble--assistant {
  max-width: 92%;
  padding: var(--sp-3) var(--pad-card);
  background: var(--surface);
  border: var(--hairline);
  border-radius: var(--r-tag) var(--r-tag) var(--r-tag) 0;
  /* 浅色主题：白气泡落在浅灰底上靠轻投影浮起来（参考图 chat 页） */
  box-shadow: var(--shadow-card);
}

/* ===== markdown 版式 =====
   容器开 pre-wrap：换行由 utils/markdown.js 合并进行内文本段 */
.md-h {
  font-weight: 600;
  color: var(--ink);
  line-height: 1.4;
}

.md-h--lg {
  font-size: var(--fs-title);
  margin: var(--sp-2) 0 var(--sp-1);
}

.md-h--sm {
  font-size: var(--fs-body);
  margin: var(--sp-2) 0 var(--sp-1);
}

.md-p {
  font-size: var(--fs-body);
  line-height: 1.7;
  color: var(--ink);
  white-space: pre-wrap;
  word-break: break-word;
}

/* 引用：左竖线 + 次级文字（视觉稿 .quote 规格） */
.md-quote {
  margin: var(--sp-2) 0;
  padding: var(--sp-1) 0 var(--sp-1) var(--sp-2);
  border-left: 4rpx solid var(--line); /* 第8条例外：引用线是 4rpx 强调竖线，不适用 --hairline */
  font-size: var(--fs-aux);
  line-height: 1.7;
  color: var(--ink-2);
  white-space: pre-wrap;
  word-break: break-word;
}

.md-hr {
  height: 0;
  margin: var(--sp-3) 0;
  border-top: var(--hairline);
}

/* 代码块：等宽 + 次级面 */
.md-code {
  margin: var(--sp-2) 0;
  padding: var(--sp-2) var(--sp-3);
  background: var(--surface-2);
  border: var(--hairline);
  border-radius: var(--r-tag);
  overflow: hidden;
}

.md-code-text {
  font-family: Menlo, Consolas, "Liberation Mono", monospace;
  font-size: var(--fs-aux);
  line-height: 1.6;
  color: var(--ink-2);
  white-space: pre;
}

/* 列表：标记 + 内容两段，嵌套层缩进 */
.md-list {
  margin: var(--sp-2) 0;
}

.md-li {
  display: flex;
  align-items: flex-start;
  gap: var(--sp-1);
  margin-top: var(--sp-1);
}

.md-li--sub {
  margin-left: var(--sp-3);
}

.md-li-marker {
  flex: none;
  min-width: var(--sp-3);
  font-size: var(--fs-body);
  line-height: 1.7;
  color: var(--ink-3);
}

.md-li-body {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-body);
  line-height: 1.7;
  color: var(--ink);
  white-space: pre-wrap;
  word-break: break-word;
}

/* 表格：div 行模拟（WXSS 无 table 版式需求，flex 更可控） */
.md-table {
  margin: var(--sp-2) 0;
  border: var(--hairline);
  border-radius: var(--r-tag);
  overflow: hidden;
}

.md-tr {
  display: flex;
}

/* 行间分隔线：sep 由 utils/markdown.js 按行号算好（WXSS 禁兄弟选择器） */
.md-tr--sep {
  border-top: var(--hairline);
}

.md-tr--head {
  background: var(--surface-2);
  border-bottom: var(--hairline);
}

.md-th,
.md-td {
  flex: 1;
  min-width: 0;
  padding: var(--sp-1) var(--sp-2);
  font-size: var(--fs-aux);
  line-height: 1.5;
}

.md-th {
  color: var(--ink-3);
  font-weight: 500;
}

.md-td {
  color: var(--ink-2);
  word-break: break-word;
}

/* 行内样式 */
.md-i {
  white-space: pre-wrap;
}

.md-strong {
  font-weight: 600;
  color: var(--ink);
}

.md-em {
  font-style: italic;
}

.md-del {
  text-decoration: line-through;
  color: var(--ink-3);
}

/* 行内代码：等宽 + 次级面小底 */
.md-code.md-i {
  padding: 0 var(--sp-1);
  border-radius: var(--r-tag);
  background: var(--surface-2);
  font-family: Menlo, Consolas, "Liberation Mono", monospace;
  font-size: 0.9em;
  color: var(--ink);
  white-space: pre-wrap;
}

/* 链接：图表蓝 + 下划线；点击复制（见 onMdLinkTap） */
.md-link {
  color: var(--accent);
  text-decoration: underline;
}

/* ===== 气泡内的金融卡（components/finance/*） ===== */
/* 卡片消息：气泡退让成透明容器，卡片自带 surface 底 / 描边 / 内边距，
   避免「卡中卡」的双层底；宽度拉满一行。
   width:100% 必须显式写：.msg--assistant 是 flex 行容器，flex 子项默认按
   内容收缩（fit-content），卡片的 width:100% 只能参照这个收缩宽，
   结果卡片只有内容宽；显式 100% 才会占满整个消息行 */
.bubble--bare {
  width: 100%;
  max-width: 100%;
  padding: 0;
  background: transparent;
  border: none;
}

/* .msg-card 已上收到 styles/token.wxss（与卡片画廊测试页共用，避免两边漂移） */

/* 红涨绿跌（国内习惯） */
.up {
  color: var(--up);
}

.down {
  color: var(--down);
}

/* ===== 状态提示（正在思考 / 工具查询 / 重连） =====
   与 AI 气泡同一套视觉语言：卡片面、左上直角，挂在列表底部 */
.status-tip {
  display: flex;
  align-items: center;
  gap: var(--sp-1);
  width: fit-content;
  max-width: 80%;
  margin-top: var(--sp-4);
  padding: var(--sp-2) var(--sp-3);
  background: var(--surface);
  border: var(--hairline);
  border-radius: 0 var(--r-tag) var(--r-tag) var(--r-tag);
}

.status-tip-text {
  font-size: var(--fs-aux);
  color: var(--ink-2);
}

/* 三个跳动小点：代替 loading 图标，错相延迟形成波浪感 */
.status-dots {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: none;
}

.status-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background-color: var(--ink-3);
  animation: status-blink 1.2s infinite ease-in-out;
}

.status-dot:nth-child(2) {
  animation-delay: 0.2s;
}

.status-dot:nth-child(3) {
  animation-delay: 0.4s;
}

/* 思考气泡：代替底部小条，作为 AI 回复位置的占位加载态 */
.thinking-bubble {
  display: flex;
  align-items: center;
  padding: var(--sp-2) var(--sp-3);
}

.thinking-dots {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: none;
}

.thinking-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: var(--ink-3);
  animation: status-blink 1.2s infinite ease-in-out;
}

.thinking-dot:nth-child(2) {
  animation-delay: 0.2s;
}

.thinking-dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes status-blink {
  0%, 60%, 100% {
    opacity: 0.35;
    transform: translateY(0);
  }
  30% {
    opacity: 1;
    transform: translateY(-4rpx);
  }
}

/* ===== 免责声明（合规兜底条，所有回答底部固定挂载） ===== */
.disclaimer {
  margin-top: var(--sp-4);
  padding: var(--sp-2) var(--sp-3);
  border: var(--hairline);
  border-radius: var(--r-tag);
  background: var(--surface-2);
  font-size: var(--fs-min);
  line-height: 1.7;
  color: var(--ink-3);
}

/* scroll-into-view 锚点：0 高度，仅用于把列表滚到底 */
.chat-anchor {
  height: 0;
}

/* ===== 输入栏 ===== */
/* 绝对定位于页面容器内（等价于 fixed，但会随页面一起参与转场动画） */
.sender-wrap {
  position: absolute;
  left: 0;
  right: 0;
  /* bottom 由页面按键盘高度驱动：卡片上移与对话区收窄共用同一份数据 */
  bottom: 0;
  background: var(--bg);
  transition: bottom 0.25s ease;
  /* 胶囊与屏幕两侧留白；下内边距由内联样式给：键盘弹起时为 0，否则让出安全区 */
  padding: var(--sp-2) var(--sp-3) 0;
  box-sizing: border-box;
}

/* 胶囊本体：一条圆角条，左端模式键、右端发送键，中间是输入区或「按住说话」 */
.sender-bar {
  position: relative;
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  min-height: 96rpx;
  /* 胶囊整体上移一档（--sp-2 = 16rpx = 8px）。
     注意只能加在胶囊「下方」：容器是底部锚定的，加大上方留白（padding-top）
     只会把对话区挤短，胶囊本身不会动 */
  margin-bottom: var(--sp-2);
  padding: var(--sp-1) 12rpx;
  box-sizing: border-box;
  background: var(--surface);
  border: var(--hairline);
  border-radius: var(--r-pill);
  /* 裁剪深色扫入层：scaleX 过程中 ::after 的圆角会被横向压扁、
     不再贴合胶囊弧线，不加这条黑块会从右端圆角外溢出 */
  overflow: hidden;
  box-shadow: var(--shadow-pop);
  /* 深色底不再走整条 background 渐变：发送键被 wx:if 移除的瞬间，
     均匀渐变会让右侧露白「闪一下」。改由 ::after 深色层从右往左扫入 */
  transition: border-color 0.22s ease;
}

/* 语音态深色底：从右侧（发送键原位置）向左扫入填充；
   切回键盘态时向右收回。z-index 0 垫底，内容元素都抬到它之上 */
.sender-bar::after {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  border-radius: var(--r-pill);
  background: var(--ink);
  transform: scaleX(0);
  transform-origin: right center;
  transition: transform 0.3s ease;
  z-index: 0;
  pointer-events: none;
}

.sender-bar--voice::after {
  transform: scaleX(1);
  /* 语音态抬到发送键之上：扫入时直接把它盖住。发送键本身不隐藏、
     不移除、不移动（位置见 .bar-send 语音态的 margin-left:auto），
     只是被这层深色压在下面——「被语音胶囊盖住」是纯绘制层效果 */
  z-index: 2;
}

/* 模式键（语音 / 键盘）：深色圆钮（与发送键同款 --ink），图标反白。
   比组件自带的 64rpx 放大到 88rpx，更好点按；
   点按不再有原生「闪一下」的高亮（去掉 webview tap 高亮） */
.bar-btn {
  flex: none;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--ink);
  color: var(--ink-2);
  display: flex;
  align-items: center;
  justify-content: center;
  -webkit-tap-highlight-color: transparent;
  /* 背景切换不做渐变：从语音退回键盘时深色层还在向右撤，
     若慢慢渐变回黑底，白图标会先露在浅底上闪一下，必须瞬时恢复 */
  transition: background 0s;
}

/* ===== 语音输入 ===== */
/* 实时转写浮层：贴在输入栏正上方（sender-wrap 是绝对定位容器，
   bottom:100% 即容器上沿），不占布局高度；最多三行，超出省略
   浮层刚出现时从下往上淡入，避免文字突然糊上来 */
.voice-live {
  position: absolute;
  left: var(--sp-3);
  right: var(--sp-3);
  bottom: 100%;
  margin-bottom: var(--sp-2);
  padding: var(--sp-2) var(--sp-3);
  background: var(--surface);
  border: var(--hairline);
  border-radius: var(--r-tag);
  box-shadow: var(--shadow-pop);
  pointer-events: none;
  animation: voice-live-in 160ms ease both;
}

.voice-live-text {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
  font-size: var(--fs-body);
  line-height: 1.6;
  color: var(--ink);
  word-break: break-word;
}

@keyframes voice-live-in {
  from {
    opacity: 0;
    transform: translateY(8rpx);
  }
  to {
    opacity: 1;
    transform: none;
  }
}

/* 语音态：胶囊描边随深色底同步 */
.sender-bar--voice {
  border-color: var(--ink);
}

.sender-bar--voice .bar-btn {
  /* 语音态「按住说话」层绝对铺满胶囊，需把模式键抬到它之上，
     否则键盘图标被覆盖、点不中，切不回键盘态。
     z-index 取 3：::after 深色扫入层已是 2（要盖住常驻的发送键），
     模式键必须再高一档，否则会被扫入层压住点不中 */
  position: relative;
  z-index: 3;
  /* 键盘切换键背景透明：胶囊已整体扫成深色，反白图标观感不变，
     去掉圆钮自绘黑底，圆弧不再与胶囊弧线叠出接缝。
     只改语音态：键盘态胶囊是白底，透明会让白图标隐入背景 */
  background: transparent;
  /* 变透明要等深色扫入层铺满再发生（0.28s，与 ::after 同步）：
     扫入从右往左，最后才盖到左端的模式键，提前透明会露白闪一下。
     切回键盘态走上面 .bar-btn 的 0s 无延迟规则，立即恢复黑底 */
  transition: background 0s linear 0.28s;
}

/* 语音态「按住说话」：绝对铺满整个胶囊，「按住说话」四个字
   在胶囊内左右上下精确居中（含左端模式键的全宽口径）。
   注意 height 必须显式置 auto：base 规则的 88rpx 会让
   top/bottom/height 同时非 auto（over-constrained），此时 bottom
   被忽略、层高被钉在 88rpx 锚在顶部，铺不满胶囊全高，
   文字会比真中心高一截——这正是「不居中」的根因 */
.sender-bar--voice .bar-hold {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  height: auto;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  color: var(--primary-fg);
  z-index: 1;
}

/* 输入区：紧贴模式键右侧，多行时随内容长高（textarea auto-height） */
.bar-field {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  /* 上下留白把单行文字垂直居中；多行时 auto-height 会把胶囊一起撑高 */
  padding: var(--sp-2) 0;
  /* 抬到胶囊深色扫入层（::after）之上 */
  position: relative;
  z-index: 1;
}

.bar-input {
  width: 100%;
  /* 一行高度打底（line-height 44rpx）：auto-height 的空 textarea 高度可能塌成 0，
     没有热区就点不中、placeholder 也看不见。
     最多两行 = 88rpx，超出后 textarea 内部滚动，不再把对话区顶掉 */
  min-height: 44rpx;
  max-height: 88rpx;
  font-size: var(--fs-body);
  line-height: 44rpx;
  color: var(--ink);
}

/* 语音态：模式键右侧的「按住说话」长条 */
.bar-hold {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  border-radius: var(--r-pill);
  background: var(--surface-2);
  color: var(--ink);
  font-size: var(--fs-body);
  display: flex;
  align-items: center;
  justify-content: center;
  -webkit-tap-highlight-color: transparent;
}

/* 发送键：恒为主按钮近黑底（无输入内容、正在等回复都不切色，只有按压态的
   hover-class 已被全站取消，所以这里也不再写 --active / --hover） */
.bar-send {
  flex: none;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--ink);
  display: flex;
  align-items: center;
  justify-content: center;
  -webkit-tap-highlight-color: transparent;
  /* 抬到胶囊深色扫入层（::after）之上 */
  position: relative;
  z-index: 1;
}

/* 语音态发送键：位置与键盘态完全一致——键盘态靠输入区 flex:1 把它顶到
   最右；语音态输入区不在场，用 margin-left:auto 把它继续钉在同一右边缘，
   切换前后位置零位移（绝不挪到模式键旁边/语音层左侧）。
   不隐藏、不移除、不改透明度：它只是被从右向左扫入的深色胶囊层
   （::after，语音态 z-index 2）盖在下面；常驻 DOM 也意味着切换时不会
   重放 bar-fade-in 淡入——重放正是白色发送图标「闪一下」的根因 */
.sender-bar--voice .bar-send {
  margin-left: auto;
}

/* 加载态：方块代替发送图标（沿用 chat-sender 的「停止」观感）。
   蓝底上用白色方块，与发送图标同色系 */
.bar-send-stop {
  width: 26rpx;
  height: 26rpx;
  border-radius: var(--r-tag);
  background: var(--surface);
}

/* 键盘 / 语音切换时，进场子元素只做透明度交叉淡入（0.3s，与键盘同速）。
   不带位移：键盘本身正在弹出/收起，元素再自己滑一段会双重运动，
   看起来就是「闪动跳动」；纯淡入与深色扫入层同步收放，观感是一口气 morph 完成。
   注意 bar-send 已常驻 DOM（不随语音态移除），这段淡入只在页面首次加载时
   播一遍，切换时不会重放——重放会让白色发送图标在扫入层退走时闪一下 */
.bar-field,
.bar-hold,
.bar-send {
  animation: bar-fade-in 300ms ease both;
}

@keyframes bar-fade-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

/* ===== 侧边抽屉 ===== */
/* 面板本体由 base-popup 提供（surface 底 + 左滑动画），这里只管内容排版 */
.drawer-body {
  width: 520rpx;
  height: 100%;
  display: flex;
  flex-direction: column;
  gap: var(--sp-3);
  /* padding-top 由内联样式提供（避让状态栏） */
  padding: 0 0 var(--sp-2);
  box-sizing: border-box;
  overflow-y: auto;
}

.drawer-head {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  /* 上下留白加大，让品牌头部整体更突出 */
  padding: var(--sp-3) var(--sp-3);
  /* 品牌头部整体上移一点（负 margin 抵消 drawerTop 里多让出的空间） */
  margin-top: var(--sp-1);
}

.drawer-logo {
  flex: none;
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  overflow: hidden;
  border: var(--hairline);
}

.drawer-title-col {
  display: flex;
  flex-direction: column;
  gap: var(--sp-1);
}

.drawer-title {
  font-size: var(--fs-brand);
  font-weight: 700;
  color: var(--ink);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

.drawer-sub {
  font-size: var(--fs-aux);
  color: var(--ink-3);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

/* 新对话主按钮：导航栏下方的主行动点，shadcn 近黑主按钮——与全局 .btn-primary
   同款（--ink 底 + --primary-fg 字）。token 规范：强调蓝只做链接/选中态/焦点 ring，
   不再用蓝做主按钮；文字色走 token，不写死 #ffffff */
.drawer-new {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--sp-2);
  min-height: 88rpx;
  /* 左右留白与各分区一致；上方间距由抽屉 body 的 flex gap（--sp-3）提供 */
  margin: 0 var(--sp-3);
  background: var(--ink);
  border-radius: var(--r-card);
}

.drawer-new-text {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--primary-fg);
}

/* 创建中：底色不变，只把整块压暗一档 + 转圈，提示「在忙」而不是「点了没反应」。
   小程序没有 hover 态（按需求取消），禁用期间靠 JS 的 newChatting 闸门兜住 */
.drawer-new--loading {
  opacity: 0.72;
}

/* 转圈：与图标同尺寸（32rpx），描边取按钮前景色，在近黑底上才看得见 */
.drawer-new-spinner {
  width: 32rpx;
  height: 32rpx;
  box-sizing: border-box;
  border: 4rpx solid var(--primary-fg);
  border-top-color: transparent;
  border-radius: 50%;
  animation: drawer-new-spin 0.8s linear infinite;
}

@keyframes drawer-new-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.drawer-section {
  padding: 0 var(--sp-3);
}

.drawer-section-title {
  margin-bottom: var(--sp-2);
  font-size: var(--fs-aux);
  font-weight: 600;
  color: var(--ink-2);
}

/* 导航菜单：分组卡片承载 */
.drawer-menu {
  background: var(--surface-2);
  border: var(--hairline);
  border-radius: var(--r-tag);
  overflow: hidden;
}

.drawer-item {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  min-height: 96rpx;
  padding: 0 var(--sp-3);
}

/* 行间分隔线：sep 由 JS 按行号算好（WXSS 禁兄弟选择器） */
.drawer-item--sep {
  border-top: var(--hairline);
}

/* 文字吃满剩余宽度，右侧箭头自然贴边。
   按压态「暗一下」按需求取消，故不再有 --hover 规则 */
.drawer-item-text {
  flex: 1;
  font-size: var(--fs-body);
  color: var(--ink);
  text-align: left;
  min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

/* ===== 历史对话：新对话下方的可滚动容器 ===== */
/* 抽屉 body 本身可滚，这里给列表一个上限高度做内部滚动，
   短屏时外层照常滚，不会把导航区顶出画面 */
.drawer-history {
  display: flex;
  flex-direction: column;
  min-height: 0;
}

.history-scroll {
  max-height: 720rpx;
}

.history-item {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 0 var(--sp-2) 0 var(--sp-3);
  background: var(--surface-2);
  border: var(--hairline);
  border-radius: var(--r-tag);
  margin-bottom: var(--sp-2);
}

/* 选中效果：当前会话——淡蓝底 + 蓝描边 + 蓝标题 */
.history-item--active {
  background: var(--accent-tint);
  border: 2rpx solid var(--accent);
}

.history-item-main {
  flex: 1;
  min-width: 0;
}

.history-item-title {
  display: block;
  font-size: var(--fs-body);
  color: var(--ink);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

.history-item--active .history-item-title {
  color: var(--accent);
  font-weight: 600;
}

/* 删除入口：固定宽热区，catchtap 防冒泡（不会误触选中） */
.history-item-del {
  flex: none;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.history-empty {
  padding: var(--sp-4) 0;
  text-align: center;
  font-size: var(--fs-aux);
  color: var(--ink-3);
}
