<view
  class="page"
  bindtouchstart="onSwipeStart"
  bindtouchmove="onSwipeMove"
  bindtouchend="onSwipeEnd"
  bindtouchcancel="onSwipeEnd"
>
  <!-- 顶部导航栏：自研 navbar（含胶囊安全区）。
       高度 = 状态栏 + 44px 内容区，完全确定，页面直接算无需实测 -->
  <base-navbar title="溜来">
    <!-- 左侧：打开侧边抽屉的菜单图标（汉堡）。
         原本顶栏应有此键，缺失后抽屉只能靠右滑开，这里补回 -->
    <view slot="left" class="nav-menu-btn" aria-label="打开导航抽屉" bindtap="onMenuTap">
      <ant-icon type="UnorderedListOutline" style="font-size:44rpx;color:var(--ink);" />
    </view>
  </base-navbar>

  <!-- 对话区：高度由 JS 精算并固定为像素值，不随视口变化抖动 -->
  <view class="chat-wrap" style="height: {{chatHeight}}px;">
    <scroll-view
      class="chat-scroll"
      scroll-y="{{true}}"
      enhanced="{{true}}"
      show-scrollbar="{{false}}"
      scroll-with-animation="{{scrollAnimated}}"
      scroll-top="{{scrollTop}}"
      bindscroll="onChatScroll"
    >
      <view class="chat-inner">
        <block wx:for="{{messages}}" wx:for-item="msg" wx:key="index">
          <!-- ===== 用户消息（含语音识别结果）：右对齐主色气泡 ===== -->
          <view wx:if="{{msg.role === 'user'}}" class="msg msg--user">
            <view class="bubble bubble--user">
              <text class="bubble-text" selectable="{{true}}">{{msg.content[0].data}}</text>
            </view>
          </view>

          <!-- ===== AI 消息：左对齐卡片气泡 ===== -->
          <view wx:else class="msg msg--assistant">
            <!-- 卡片消息（quote/kline）时气泡退让成透明容器，视觉交给金融卡组件，
                 避免出现「卡中卡」的双层底 -->
            <view class="bubble bubble--assistant {{msg.card ? 'bubble--bare' : ''}}">
              <!-- 占位卡：加载中 / 取数失败。必须排在所有真卡分支之前——
                   占位消息同样带 card 字段（气泡要退让成透明容器），
                   放在后面会被同名的真卡分支抢先匹配，渲染出一张空数据卡。
                   生命周期见 chat.js 的 _pushCardSlot / _placeCard / _failCardSlot -->
              <base-card-status
                wx:if="{{msg.loadState}}"
                card-class="msg-card"
                state="{{msg.loadState}}"
                label="{{msg.loadLabel}}"
                detail="{{msg.loadDetail}}"
              />

              <!-- 行情卡片：金融卡组件（components/finance/quote-card），
                   数据字段在 chat.js 的 quoteCard() 里映射；
                   点卡进卡片画廊（pages/test，静态八卡样式页） -->
              <finance-quote-card
                wx:elif="{{msg.card === 'quote'}}"
                card-class="msg-card"
                bindtap="onQuoteCardTap"
                data-code="{{msg.quote.code}}"
                data-name="{{msg.quote.name}}"
                name="{{msg.quote.name}}"
                code="{{msg.quote.code}}"
                status="{{msg.quote.status}}"
                price="{{msg.quote.price}}"
                change="{{msg.quote.change}}"
                change-pct="{{msg.quote.changePct}}"
                open="{{msg.quote.open}}"
                high="{{msg.quote.high}}"
                low="{{msg.quote.low}}"
                amount="{{msg.quote.amount}}"
                turnover-rate="{{msg.quote.turnoverRate}}"
                total-cap="{{msg.quote.totalCap}}"
                points="{{msg.quote.points}}"
                tags="{{msg.quote.tags}}"
                note="{{msg.quote.note}}"
              />

              <!-- K 线卡片：金融卡组件（components/finance/kline-card） -->
              <finance-kline-card
                wx:elif="{{msg.card === 'kline'}}"
                card-class="msg-card"
                name="{{msg.klineName}}"
                code="{{msg.klineCode}}"
                subtitle="{{msg.klineSub}}"
                periods="{{msg.klinePeriods}}"
                active-period="{{msg.klineActivePeriod}}"
                klines="{{msg.kline}}"
                ma="{{msg.klineMa}}"
                period-pct="{{msg.klinePct}}"
                amplitude="{{msg.klineAmplitude}}"
                volume-ratio="{{msg.klineVolumeRatio}}"
                support="{{msg.klineSupport}}"
                resistance="{{msg.klineResistance}}"
                note="{{msg.klineNote}}"
              />

              <!-- 估值卡片：金融卡组件（components/finance/valuation-card）。
                   历史分位/行业均值当前数据源没有，卡片内显示「--」降级 -->
              <finance-valuation-card
                wx:elif="{{msg.card === 'valuation'}}"
                card-class="msg-card"
                pe-ttm="{{msg.valuation.peTtm}}"
                pe-static="{{msg.valuation.peStatic}}"
                pb="{{msg.valuation.pb}}"
                ps="{{msg.valuation.ps}}"
                peg="{{msg.valuation.peg}}"
                dividend-yield="{{msg.valuation.dividendYield}}"
                total-cap="{{msg.valuation.totalCap}}"
                note="{{msg.valuation.note}}"
              />

              <!-- 资金流向卡片：金融卡组件（components/finance/fundflow-card）。
                   命中龙虎榜时 payload 带 lhb 席位区块，chat.js 已换算成元口径 -->
              <finance-fundflow-card
                wx:elif="{{msg.card === 'fundflow'}}"
                card-class="msg-card"
                main-net="{{msg.fundflow.mainNet}}"
                main-net-pct="{{msg.fundflow.mainNetPct}}"
                tiers="{{msg.fundflow.tiers}}"
                north-pct="{{msg.fundflow.northPct}}"
                north-change-pct="{{msg.fundflow.northChangePct}}"
                streak-days="{{msg.fundflow.streakDays}}"
                days5="{{msg.fundflow.days5}}"
                lhb="{{msg.fundflow.lhb}}"
                note="{{msg.fundflow.note}}"
              />

              <!-- 财报速览卡片：金融卡组件（components/finance/report-card）。
                   一致预期数据源没有，不出「超预期」标签 -->
              <finance-report-card
                wx:elif="{{msg.card === 'report'}}"
                card-class="msg-card"
                period-label="{{msg.report.periodLabel}}"
                revenue="{{msg.report.revenue}}"
                net-profit="{{msg.report.netProfit}}"
                cash-flow="{{msg.report.cashFlow}}"
                gross-margin="{{msg.report.grossMargin}}"
                net-margin="{{msg.report.netMargin}}"
                roe="{{msg.report.roe}}"
                eps="{{msg.report.eps}}"
                beat="{{msg.report.beat}}"
                note="{{msg.report.note}}"
              />

              <!-- 研报观点卡片：金融卡组件（components/finance/research-card） -->
              <finance-research-card
                wx:elif="{{msg.card === 'research'}}"
                card-class="msg-card"
                org="{{msg.research.org}}"
                rating="{{msg.research.rating}}"
                target-price="{{msg.research.targetPrice}}"
                publish-date="{{msg.research.publishDate}}"
                report-type="{{msg.research.reportType}}"
                summary="{{msg.research.summary}}"
                forecast-dir="{{msg.research.forecastDir}}"
                upside="{{msg.research.upside}}"
                source-name="{{msg.research.sourceName}}"
                source-url="{{msg.research.sourceUrl}}"
              />

              <!-- 公司事件卡片：金融卡组件（components/finance/event-card） -->
              <finance-event-card
                wx:elif="{{msg.card === 'event'}}"
                card-class="msg-card"
                events="{{msg.event.events}}"
                range="{{msg.event.range}}"
                note="{{msg.event.note}}"
              />

              <!-- 同业对比卡片：金融卡组件（components/finance/compare-card） -->
              <finance-compare-card
                wx:elif="{{msg.card === 'compare'}}"
                card-class="msg-card"
                items="{{msg.compare.items}}"
                note="{{msg.compare.note}}"
              />

              <!-- 纯文本回答：markdown 块渲染（见页面底部 md-* 模板与样式） -->
              <block wx:else>
                <block wx:for="{{msg.blocks}}" wx:for-item="b" wx:key="index">
                  <view wx:if="{{b.tag === 'h'}}" class="md-h {{b.depth <= 2 ? 'md-h--lg' : 'md-h--sm'}}">
                    <template is="mdInline" data="{{inlines: b.inlines}}" />
                  </view>
                  <view wx:if="{{b.tag === 'p'}}" class="md-p">
                    <template is="mdInline" data="{{inlines: b.inlines}}" />
                  </view>
                  <view wx:if="{{b.tag === 'quote'}}" class="md-quote">
                    <template is="mdInline" data="{{inlines: b.inlines}}" />
                  </view>
                  <view wx:if="{{b.tag === 'code'}}" class="md-code">
                    <text class="md-code-text" selectable="{{true}}">{{b.text}}</text>
                  </view>
                  <view wx:if="{{b.tag === 'hr'}}" class="md-hr" />
                  <view wx:if="{{b.tag === 'ul' || b.tag === 'ol'}}" class="md-list">
                    <view class="md-li {{item.depth ? 'md-li--sub' : ''}}" wx:for="{{b.items}}" wx:for-item="item" wx:key="index">
                      <text class="md-li-marker num">{{b.tag === 'ol' ? index + 1 + '.' : (item.depth ? '◦' : '•')}}</text>
                      <view class="md-li-body">
                        <template is="mdInline" data="{{inlines: item.inlines}}" />
                      </view>
                    </view>
                  </view>
                  <view wx:if="{{b.tag === 'table'}}" class="md-table">
                    <view class="md-tr md-tr--head">
                      <view class="md-th" wx:for="{{b.head}}" wx:for-item="c" wx:key="index">
                        <template is="mdInline" data="{{inlines: c}}" />
                      </view>
                    </view>
                    <view class="md-tr {{ri > 0 ? 'md-tr--sep' : ''}}" wx:for="{{b.rows}}" wx:for-item="r" wx:for-index="ri" wx:key="index">
                      <view class="md-td" wx:for="{{r}}" wx:for-item="c" wx:key="index">
                        <template is="mdInline" data="{{inlines: c}}" />
                      </view>
                    </view>
                  </view>
                </block>
              </block>
            </view>
          </view>
        </block>

        <!-- 思考气泡：发送后到首个 token 到达前显示，占位在 AI 回复该出现的左侧 -->
        <view wx:if="{{thinking}}" class="msg msg--assistant">
          <view class="bubble bubble--assistant thinking-bubble">
            <view class="thinking-dots">
              <view class="thinking-dot"></view>
              <view class="thinking-dot"></view>
              <view class="thinking-dot"></view>
            </view>
          </view>
        </view>

        <!-- 状态提示：工具查询 / 重连时显示（思考气泡已覆盖「等待回答」阶段） -->
        <view wx:if="{{statusText}}" class="status-tip">
          <view class="status-dots">
            <view class="status-dot"></view>
            <view class="status-dot"></view>
            <view class="status-dot"></view>
          </view>
          <text class="status-tip-text">{{statusText}}</text>
        </view>

        <!-- 合规兜底：所有回答底部固定挂载免责声明（金融产品红线） -->
        <view class="disclaimer">以上内容由 AI 基于公开数据整理，仅供信息参考，不构成任何投资建议。市场有风险，决策需谨慎。</view>

        <!-- 底部锚点：0 高度，仅作为列表内容的稳定结尾 -->
        <view id="chat-bottom" class="chat-anchor"></view>
      </view>
    </scroll-view>
  </view>

  <!-- 输入栏：页面自绘的一条胶囊，左端模式键（语音 / 键盘），右端是发送键。
       手势起点标记用 bind 而不是 catch：catch 会让子元素的点击全部失效，
       这里改成「起点在输入栏」的信号，由 onSwipeStart 判断后锁掉抽屉手势 -->
  <view
    class="sender-wrap"
    style="padding-bottom: {{senderPadBottom}}px; bottom: {{keyboardOffset}}px;"
    bindtouchstart="onSenderTouchStart"
  >
    <!-- 实时转写浮层：按住说话时悬浮在输入栏上方，边说边出字。
         绝对定位（bottom:100%），不参与布局，不会挤压对话区 -->
    <view wx:if="{{voiceText}}" class="voice-live">
      <view class="voice-live-text">{{voiceText}}</view>
    </view>

    <view class="sender-bar {{voiceMode ? 'sender-bar--voice' : ''}}">
      <!-- 模式键：键盘态显示语音图标，语音态显示键盘图标。
           无 hover-class：需求要求点它不要有「暗一下」的按压特效 -->
      <view
        class="bar-btn"
        aria-label="{{voiceMode ? '切换到键盘输入' : '切换到语音输入'}}"
        bindtap="onToggleInputMode"
      >
        <!-- antd 图标集没有键盘图标：键盘态用「编辑/输入」图标，语音态用「麦克风」图标 -->
        <ant-icon
          type="{{voiceMode ? 'EditSOutline' : 'AudioOutline'}}"
          style="font-size:44rpx;color:#FFFFFF;"
        />
      </view>

      <!-- 键盘态：输入区紧贴模式键右侧，整块可点（主动聚焦） -->
      <view wx:if="{{!voiceMode}}" class="bar-field" bindtap="onTapInputField">
        <textarea
          class="bar-input"
          value="{{input}}"
          focus="{{inputFocus}}"
          placeholder="问点什么…"
          placeholder-style="color: #9AA1AC; font-size: 30rpx;"
          auto-height="{{true}}"
          adjust-position="{{false}}"
          cursor-spacing="24"
          confirm-type="send"
          show-confirm-bar="{{false}}"
          maxlength="-1"
          bindinput="onInput"
          bindconfirm="onSend"
          bindfocus="onInputFocus"
          bindblur="onInputBlur"
          bindkeyboardheightchange="onKeyboardHeightChange"
        ></textarea>
      </view>

      <!-- 语音态：胶囊整宽中央的「按住说话」（以含模式键的全宽居中），上滑可取消。
           按住即录，识别由微信同声传译插件完成，边说边出字（浮层见上方 .voice-live）；
           松手后终稿自动填进输入框，等用户确认后发送。
           不是开关式 toggle，按下不加灰阶/缩放反馈，观感与手机键盘一致。
           这里可以用 catch：本节点没有需要点击的子元素 -->
      <view
        wx:else
        class="bar-hold"
        catchtouchstart="onRecordStart"
        catchtouchmove="onRecordMove"
        catchtouchend="onRecordEnd"
        catchtouchcancel="onRecordEnd"
      >{{recordTip}}</view>

      <!-- 发送键：恒为主按钮近黑底白字（无输入内容、等待回复时都不切色）。
           常驻 DOM、不隐藏、不移动：键盘态靠输入区 flex:1 顶到最右，
           语音态用 margin-left:auto 钉在同一右边缘（切换前后位置一致），
           并被从右向左扫入的深色胶囊层（::after）直接盖住，形成
           「发送键被语音胶囊盖住」的视觉效果（见 chat.wxss 的 z 轴层级） -->
      <view class="bar-send" aria-label="发送" bindtap="onSend">
        <view wx:if="{{sending}}" class="bar-send-stop"></view>
        <ant-icon wx:else type="SendOutline" style="font-size:44rpx;color:#FFFFFF;" />
      </view>
    </view>
  </view>

  <!-- 侧边抽屉：自研 base-popup left 模式。
       点遮罩 / 左滑都能关；收起动画结束（leaved）后才跳转，避免动画被新页面掐断 -->
  <base-popup
    visible="{{drawerOpen}}"
    mode="left"
    bind:mask="onDrawerMask"
    bind:leaved="onDrawerLeaved"
  >
    <view class="drawer-body" style="padding-top: {{drawerTop}}px;">
      <!-- 品牌头部 -->
      <view class="drawer-head">
        <image class="drawer-logo" src="/assets/logo-bull.jpg" mode="aspectFill" />
        <view class="drawer-title-col">
          <view class="drawer-title">溜来</view>
          <view class="drawer-sub">AI 溜来</view>
        </view>
      </view>

      <!-- 导航菜单：分组卡片承载，行间分隔线由 JS 按行号算好 -->
      <view class="drawer-section">
        <view class="drawer-section-title">导航</view>
        <view class="drawer-menu">
          <view
            class="drawer-item {{m.sep ? 'drawer-item--sep' : ''}}"
            wx:for="{{menus}}"
            wx:for-item="m"
            wx:key="key"
            data-menu="{{m.key}}"
            bindtap="onMenuSelect"
          >
            <text class="drawer-item-text">{{m.label}}</text>
            <ant-icon type="RightOutline" style="font-size:28rpx;color:var(--ink-3);" />
          </view>
        </view>
      </view>

      <!-- 新对话：导航栏下方的主行动点（shadcn 近黑主按钮 + 白色前景）。
           先注册一条新 session（立即进入历史列表），注册期间按钮转圈并挡住连点，
           成功后再压栈全新的对话页实例；旧对话留在栈里可返回 -->
      <view
        class="drawer-new {{newChatting ? 'drawer-new--loading' : ''}}"
        aria-label="开始新对话"
        bindtap="onNewChat"
      >
        <ant-icon wx:if="{{!newChatting}}" type="ChatAddOutline" style="font-size:32rpx;color:var(--primary-fg);" />
        <view wx:else class="drawer-new-spinner" />
        <text class="drawer-new-text">{{newChatting ? '创建中…' : '新对话'}}</text>
      </view>

      <!-- 历史对话：可滚动容器。当前会话高亮（选中效果），
           每行右侧删除入口（catchtap 防止冒泡触发选中） -->
      <view class="drawer-section drawer-history">
        <view class="drawer-section-title">历史对话</view>
        <scroll-view
          class="history-scroll"
          scroll-y="{{true}}"
          enhanced="{{true}}"
          show-scrollbar="{{false}}"
        >
          <view
            wx:for="{{sessions}}"
            wx:key="session_id"
            class="history-item {{item.active ? 'history-item--active' : ''}}"
          >
            <view class="history-item-main" data-sid="{{item.session_id}}" bindtap="onSessionSelect">
              <text class="history-item-title">{{item.title}}</text>
            </view>
            <view class="history-item-del" data-sid="{{item.session_id}}" catchtap="onSessionDelete">
              <ant-icon type="DeleteOutline" style="font-size:28rpx;color:var(--ink-3);" />
            </view>
          </view>
          <view wx:if="{{!sessions.length}}" class="history-empty">暂无历史对话</view>
        </scroll-view>
      </view>
    </view>
  </base-popup>

  <base-toast id="base-toast" />
</view>

<!-- ===== markdown 行内片段模板 =====
     结构由 utils/markdown.js 生成：带样式标记的扁平文本段。
     链接点击统一走 onMdLinkTap（复制链接，不用 webview 直接打开外部站点） -->
<template name="mdInline">
  <block wx:for="{{inlines}}" wx:for-item="i" wx:key="index">
    <text
      wx:if="{{i.t !== 'br'}}"
      class="md-i {{i.strong ? 'md-strong' : ''}} {{i.em ? 'md-em' : ''}} {{i.code ? 'md-code' : ''}} {{i.del ? 'md-del' : ''}} {{i.href ? 'md-link' : ''}}"
      data-href="{{i.href}}"
      bindtap="onMdLinkTap"
    >{{i.text}}</text>
  </block>
</template>
