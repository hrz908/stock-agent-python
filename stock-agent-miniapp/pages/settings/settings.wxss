/* ===== 页面骨架 ===== */
.page {
  display: flex;
  flex-direction: column;
  height: 100%;
  overflow: hidden;
  background: var(--bg);
  position: relative;
}

.content {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  /* 顶部留白统一到各页一致（--sp-3） */
  padding: var(--sp-3) var(--sp-4) 0;
}

/* ===== 个人信息卡 =====
   行式布局：本页唯一可点的一行，居中大卡既费纵向空间，又看不出可点 */
.profile-card {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  padding: var(--sp-3) var(--sp-3) var(--sp-3) var(--sp-4);
  background: var(--surface);
  border: var(--hairline);
  border-radius: var(--r-card);
  box-shadow: var(--shadow-card);
}

.profile-avatar {
  flex: none;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  overflow: hidden;
  background: var(--surface-2);
}

.profile-avatar--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  border: var(--hairline);
}

.profile-info {
  flex: 1;
  min-width: 0;
  text-align: left;
}

.profile-nickname {
  font-size: var(--fs-title);
  font-weight: 600;
  color: var(--ink);
  text-align: left;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-desc {
  margin-top: var(--sp-1);
  font-size: var(--fs-aux);
  color: var(--ink-3);
  text-align: left;
}

/* ===== 底部操作区 ===== */
.bottom-btn {
  position: absolute;
  left: var(--sp-4);
  right: var(--sp-4);
}

/* 底部按钮：无填充、胶囊轮廓，描边与输入框同款（--hairline） */
.footer-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: var(--r-pill);
  font-size: var(--fs-body);
  font-weight: 600;
  background: transparent;
  color: var(--ink);
  border: var(--hairline);
  box-shadow: var(--shadow-card);
}

/* 危险操作：只靠红字表达，描边与输入框一致 */
.footer-btn--danger {
  color: var(--danger);
}

.footer-hint {
  margin-top: var(--sp-2);
  text-align: center;
  font-size: var(--fs-min);
  color: var(--ink-3);
}

/* 注销入口：次级文字链，不用危险色实底——不跟「退出登录」抢主次，
   但必须在页面上可发现（合规要求账号可删除） */
.footer-link {
  margin-top: var(--sp-4);
  padding: var(--sp-2) 0;
  text-align: center;
  font-size: var(--fs-aux);
  color: var(--ink-3);
  text-decoration: underline;
}

/* 次级入口行（隐私说明）：与个人信息卡同一套浮起面，但更轻，
   不带箭头以外的装饰，避免与「编辑资料」抢注意力 */
.link-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  margin-top: var(--sp-3);
  padding: 0 var(--sp-3);
  background: var(--surface);
  border: var(--hairline);
  border-radius: var(--r-card);
  box-shadow: var(--shadow-card);
}

.link-row-text {
  font-size: var(--fs-body);
  color: var(--ink-2);
}

/* ===== 编辑资料弹窗 ===== */
.edit-form {
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 原生 button 清掉默认样式：无边框无底色，尺寸自负。
   button 的默认样式各端差异大，必须显式清（含 ::after 边框） */
.avatar-picker {
  margin: 0;
  padding: 0;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: transparent;
  line-height: 1;
}

/* 原生 button 自带的 ::after 边框：WXSS 禁写双冒号，用单冒号 */
.avatar-picker:after {
  border: none;
}

.edit-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: var(--surface-2);
  border: var(--hairline);
}

/* 空头像：与个人资料页的空头像同一套（次级面底 + user 图标） */
.edit-avatar--empty {
  display: flex;
  align-items: center;
  justify-content: center;
}

.edit-field {
  width: 100%;
  margin-top: var(--sp-4);
}

.edit-input {
  width: 100%;
  height: 88rpx;
  padding: 0 var(--sp-3);
  box-sizing: border-box;
  text-align: center;
  font-size: var(--fs-body);
  color: var(--ink);
  background: transparent;
  border: var(--hairline);
  border-radius: var(--r-pill);
  box-shadow: var(--shadow-card);
}

.edit-input-placeholder {
  color: var(--ink-3);
  font-size: var(--fs-body);
}

/* 超长提示行：红色（涨跌语义里的「警告」位），仅超长时出现 */
.edit-tip {
  margin-top: var(--sp-1);
  font-size: var(--fs-aux);
  color: var(--danger);
  text-align: center;
}

.nickname-action {
  display: flex;
  justify-content: center;
  margin-top: var(--sp-3);
}

.nickname-link {
  padding: var(--sp-1) var(--sp-3);
  font-size: var(--fs-aux);
  color: var(--accent);
  border-radius: var(--r-tag);
  display: flex; align-items: center; justify-content: center; min-height: 88rpx;
}


