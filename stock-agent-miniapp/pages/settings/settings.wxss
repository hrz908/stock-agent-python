/* ===== 页面骨架 ===== */
.page {
  display: flex;
  flex-direction: column;
  height: 100%;
  overflow: hidden;
  background: var(--bg);
  position: relative;
}

.content {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  /* 顶部留白统一到各页一致（--space-lg） */
  padding: var(--space-lg) var(--space-lg) 0;
}

/* ===== 个人信息卡 =====
   行式布局：本页唯一可点的一行，居中大卡既费纵向空间，又看不出可点 */
.profile-card {
  display: flex;
  align-items: center;
  gap: var(--space-lg);
  padding: var(--space-lg) var(--space-lg) var(--space-lg) var(--space-lg);
  background: var(--surface);
  border: var(--hairline);
  border-radius: var(--radius-md);
}

.profile-avatar {
  flex: none;
  width: 128rpx;   /* 2026-10-26：头像再放大一号（原 112） */
  height: 128rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: var(--surface-2);
}

.profile-avatar--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  border: var(--hairline);
}

.profile-info {
  flex: 1;
  min-width: 0;
  text-align: left;
}

.profile-nickname {
  font-size: var(--font-lg);   /* 昵称：大号 */
  font-weight: var(--fw-medium);
  color: var(--ink);
  text-align: left;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-desc {
  margin-top: var(--space-xs);
  font-size: var(--font-sm);   /* 编辑头像与昵称：小号 */
  color: var(--ink-3);
  text-align: left;
}

/* ===== 底部操作区 ===== */
.bottom-btn {
  position: absolute;
  left: var(--space-2xl);
  right: var(--space-2xl);
}

/* 底部按钮：无填充、8rpx 圆角，描边与输入框同款（--hairline） */
.footer-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--icon-touch);
  padding: 16rpx 32rpx;
  border-radius: var(--radius-sm);
  font-size: var(--font-lg);
  font-weight: var(--fw-medium);
  line-height: var(--lh-base);
  background: var(--color-bg-card);
  color: var(--color-error);
}

/* 危险操作：只靠红字表达，描边与输入框一致 */
.footer-btn--danger {
  color: var(--danger);
}

.footer-hint {
  margin-top: var(--space-md);
  text-align: center;
  font-size: var(--font-sm);   /* 退出后会自动登录的提示：小号 */
  color: var(--ink-3);
}

/* 注销入口：次级文字链，不用危险色实底——不跟「退出登录」抢主次，
   但必须在页面上可发现（合规要求账号可删除） */
.footer-link {
  margin-top: var(--space-lg);
  padding: var(--space-md) 0;
  text-align: center;
  font-size: var(--font-sm);   /* 注销账号：小号 */
  color: var(--ink-3);
  text-decoration: underline;
}

/* ===== 直角框体（本页复用） =====
   字体大小段控与隐私说明入口共用同一套外形：白面 + --hairline + 12rpx 圆角，
   96rpx 等高、四角直角（border-radius: 0，不跟随 --radius-lg / --radius-sm）。
   两块上下叠放，除内部分布外不允许各自改描边 / 投影 / 高度。 */
.panel-flat {
  height: 96rpx;
  background: var(--surface);
  border: var(--hairline);
  border-radius: var(--radius-md);
}

/* ===== 字体大小（全局档位） =====
   段式单选：选中靠字重与字色，不铺底块。
   三档（标准/大/超大）每项 flex:1：等宽且占满整个框体高度，文字统一标准号 */
.font-scale {
  margin-top: var(--space-lg);
}

.font-scale-title {
  padding: 0 var(--space-xs);
  font-size: var(--font-sm);   /* 「字体大小」标签：小号 */
  font-weight: 600;
  color: var(--ink-2);
}

.font-scale-radio {
  display: flex;
  margin-top: var(--space-md);
}

.font-scale-radio__item {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-base);
  color: var(--ink-2);
  transition: color .2s;
}

.font-scale-radio__item--on {
  color: var(--ink);
  font-weight: 600;
}

/* 次级入口行（隐私说明）：框体同字体大小段控（.panel-flat），
   内部分布为左右两端，不带箭头以外的装饰，避免与「编辑资料」抢注意力 */
.link-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--space-lg);
  padding: 0 var(--space-lg);
}

.link-row-text {
  font-size: var(--font-base);
  color: var(--ink-2);
}

/* ===== 编辑资料弹窗 ===== */
.edit-form {
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 原生 button 清掉默认样式：无边框无底色，尺寸自负。
   button 的默认样式各端差异大，必须显式清（含 ::after 边框） */
.avatar-picker {
  margin: 0;
  padding: 0;
  width: 160rpx;
  height: 160rpx;
  border-radius: 999rpx;
  background: transparent;
  line-height: var(--lh-base);
}

/* 原生 button 自带的 ::after 边框：WXSS 禁写双冒号，用单冒号 */
.avatar-picker:after {
  border: none;
}

.edit-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 999rpx;
  background: var(--surface-2);
  border: var(--hairline);
}

/* 空头像：与个人资料页的空头像同一套（次级面底 + user 图标） */
.edit-avatar--empty {
  display: flex;
  align-items: center;
  justify-content: center;
}

.edit-field {
  width: 100%;
  margin-top: var(--space-lg);
}

.edit-input {
  width: 100%;
  height: 88rpx;
  padding: 0 var(--space-md);
  box-sizing: border-box;
  text-align: center;
  font-size: var(--font-base);
  color: var(--ink);
  background: transparent;
  border: var(--hairline);
  border-radius: var(--radius-sm);
}

.edit-input-placeholder {
  color: var(--ink-3);
  font-size: var(--font-base);
}

/* 超长提示行：红色（涨跌语义里的「警告」位），仅超长时出现 */
.edit-tip {
  margin-top: var(--space-xs);
  font-size: var(--font-sm);
  color: var(--danger);
  text-align: center;
}

.nickname-action {
  display: flex;
  justify-content: center;
  margin-top: var(--space-lg);
}

.nickname-link {
  padding: var(--space-xs) var(--space-lg);
  font-size: var(--font-sm);
  color: var(--ink);
  border-radius: var(--radius-md);
  display: flex; align-items: center; justify-content: center; min-height: 88rpx;
}


