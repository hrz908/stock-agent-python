<!-- 页面骨架：自研 navbar + 自绘卡片（替代 TDesign cell-group 体系）。
     浅色专业金融视觉：--surface 卡片 / --line 描边 / --ink 文字层级。 -->
<view class="page {{fontScaleClass}}">
  <base-navbar left-arrow="{{true}}" bind:back="goBack" />

  <view class="content">
    <!-- 个人信息：整块可点，打开编辑资料弹窗。
         不用头像组件：没图时就是一块次级面底色 + user 图标，比组件内置小圆干净 -->
    <view class="profile-card" bindtap="onProfileTap">
      <image wx:if="{{avatarSrc}}" class="profile-avatar" src="{{avatarSrc}}" mode="aspectFill" />
      <view wx:else class="profile-avatar profile-avatar--empty">
        <base-icon type="UserOutline" style="font-size:var(--icon-xl);color:var(--ink-3);" />
      </view>
      <view class="profile-info">
        <view class="profile-nickname">{{nickname}}</view>
        <view class="profile-desc">编辑头像与昵称</view>
      </view>
      <!-- 右侧箭头：整行可点，没有箭头时看不出这是一行入口 -->
      <base-icon type="RightOutline" style="font-size:var(--icon-sm);color:var(--ink-3);" />
    </view>

    <!-- 字体大小：全局档位（三档：标准 / 大 / 超大），选择后写入本地缓存，
         所有页面根节点的 font-scale--* 类在 onShow 时同步，
         字号变量随 custom property 向下生效 -->
    <view class="font-scale">
      <view class="font-scale-title">字体大小</view>
      <view class="font-scale-radio panel-flat">
        <view
          wx:for="{{fontScaleOptions}}"
          wx:key="key"
          class="font-scale-radio__item {{fontScale === item.key ? 'font-scale-radio__item--on' : ''}}"
          data-key="{{item.key}}"
          bindtap="onFontScaleTap"
        >{{item.label}}</view>
      </view>
    </view>

    <!-- 隐私说明入口：合规要求「可查阅、可撤回、可删除」，
         说明页的文案与真实数据链路保持一致（见 pages/privacy） -->
    <view class="link-row panel-flat" bindtap="onOpenPrivacy">
      <text class="link-row-text">隐私说明</text>
      <base-icon type="RightOutline" style="font-size:var(--icon-xs);color:var(--ink-3);" />
    </view>

    <!-- 消息推送卡片按需求整块移除（偏好设置组随之消失，pushEnabled 相关
         逻辑在 settings.js 同步删掉），页面只留「个人资料 + 退出登录」 -->
  </view>

  <!-- 底部操作区：absolute 定位随页面转场移动，bottom 由安全区算出 -->
  <view class="bottom-btn" style="bottom: {{bottomGap}}px;">
    <view class="footer-btn footer-btn--danger" bindtap="onLogout">退出登录</view>
    <view class="footer-hint">退出后下次打开小程序会自动登录</view>
    <!-- 账号注销是合规入口，必须是可发现的文字入口，不能藏在弹窗里 -->
    <view class="footer-link" bindtap="onDeleteAccount">{{deletingAccount ? '正在注销…' : '注销账号'}}</view>
  </view>

  <!-- 编辑资料弹窗：base-popup center 模式，纯淡入（内含原生 input） -->
  <base-popup
    visible="{{profileVisible}}"
    mode="center"
    title="编辑资料"
    confirm-text="保存"
    cancel-text="取消"
    bind:confirm="saveProfile"
    bind:cancel="cancelEdit"
  >
    <view slot="content" class="edit-form">
      <!-- 换头像入口：必须用原生 button 的 open-type="chooseAvatar"（面板里才有
           「使用微信头像」）；自定义组件不一定能透出 chooseavatar 事件。
           原生 button 的默认样式由 .avatar-picker 清掉 -->
      <button
        class="avatar-picker"
        open-type="chooseAvatar"
        bind:chooseavatar="onChooseWechatAvatar"
      >
        <image wx:if="{{editAvatarSrc}}" class="edit-avatar" src="{{editAvatarSrc}}" mode="aspectFill" />
        <view wx:else class="edit-avatar edit-avatar--empty">
          <base-icon type="UserOutline" style="font-size:var(--icon-xl);color:var(--ink-3);" />
        </view>
      </button>

      <view class="edit-field">
        <!-- type 平时是 text，只有点了下方「使用微信昵称」才切成 nickname——
             否则每次聚焦输入框都会弹出微信昵称候选栏，属于打扰。
             focus 必须镜像「真实焦点」（focus 事件置 true、blur 置 false）：
             把已聚焦输入框的 focus 下发成 false 会让微信立刻收键盘，
             症状是「删除一个字符键盘就收起」；要主动收键盘用 wx.hideKeyboard()。 -->
        <input
          class="edit-input"
          type="{{nicknamePicking ? 'nickname' : 'text'}}"
          value="{{editNickname}}"
          placeholder="请输入昵称"
          placeholder-class="edit-input-placeholder"
          focus="{{nicknameFocus}}"
          hold-keyboard="{{true}}"
          bindinput="onEditNickname"
          bindchange="onEditNickname"
          bindblur="onNicknameBlur"
          bindfocus="onNicknameFocus"
          bindnicknamereview="onNicknameReview"
        />

        <!-- 超长提示行：空串不渲染（原 t-input tips 的位置，改为自绘） -->
        <view wx:if="{{nicknameTip}}" class="edit-tip">{{nicknameTip}}</view>

        <view class="nickname-action">
          <view class="nickname-link" bindtap="fillWechatNickname">
            使用微信昵称
          </view>
        </view>
      </view>
    </view>
  </base-popup>

  <!-- 退出登录二次确认：危险色确认按钮 -->
  <base-popup
    visible="{{logoutVisible}}"
    mode="center"
    title="退出登录"
    desc="确定退出当前账号？本地缓存将保留"
    confirm-text="退出登录"
    cancel-text="取消"
    confirm-danger="{{true}}"
    bind:confirm="onLogoutConfirm"
    bind:cancel="onLogoutCancel"
    bind:mask="onLogoutCancel"
  />

  <!-- 注销账号确认：措辞必须写清不可恢复，且说明删除范围 -->
  <base-popup
    visible="{{deleteAccountVisible}}"
    mode="center"
    title="注销账号"
    desc="注销后，你的自选股、提醒规则、对话记录与个人资料将被删除且无法恢复。确定继续吗？"
    confirm-text="确认注销"
    cancel-text="取消"
    confirm-danger="{{true}}"
    bind:confirm="confirmDeleteAccount"
    bind:cancel="cancelDeleteAccount"
    bind:mask="cancelDeleteAccount"
  />

  <base-toast id="base-toast" />
</view>
