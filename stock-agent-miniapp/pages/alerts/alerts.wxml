<!-- 页面结构：自研 navbar + 自绘概览宫格 + 自绘提醒卡 + base-popup 表单。
     选择器用微信原生 picker（mode="selector"）：客户端原生渲染的半屏滚轮，
     触发区是自绘行，视觉完全可控（执行指南 4.3） -->
<view class="page">
  <base-navbar title="提醒" left-arrow="{{true}}" bind:back="goBack" />

  <view class="content">
    <!-- 概览宫格：两格（全部提醒 / 今日触发），自绘替代 t-grid -->
    <view class="overview">
      <!-- 文字在左、数字在右（左右对齐），文字加大加粗 -->
      <view class="overview-cell" wx:for="{{stats}}" wx:for-item="s" wx:key="key">
        <view class="g-label">{{s.label}}</view>
        <view class="g-num num">{{s.num}}</view>
      </view>
    </view>

    <!-- 分组标题放在滚动区外：滚动时它固定不动 -->
    <view class="group-title">价格与涨幅提醒</view>

    <!-- 提醒列表：只有这一个容器内部滚动，底边停在「新增提醒」按钮上方 -->
    <scroll-view class="list-scroll" scroll-y enhanced="{{true}}" show-scrollbar="{{false}}">
      <view wx:if="{{alerts.length > 0}}" class="alert-list">
        <!-- 每条提醒一张卡片：头部（股票 + 编辑）→ 大号阈值（+ 删除）→ 条件描述 -->
        <view class="alert-card" wx:for="{{alerts}}" wx:for-item="item" wx:key="id">
          <view class="alert-card-head">
            <view class="alert-card-name">{{item.name}}<text class="alert-card-code num">{{item.code}}</text></view>
            <!-- 删除：头部右上角纯文字（已移除垃圾桶图标），二次确认后删除 -->
            <view class="alert-card-delbtn" data-id="{{item.id}}" catchtap="onDelete">删除</view>
          </view>

          <view class="alert-card-price">
            <ant-icon type="{{item.trendIcon}}" style="font-size:56rpx;color:{{item.trendColor}};" />
            <text class="alert-card-price-text num" style="color: {{item.trendColor}};">{{item.priceText}}</text>
            <!-- 编辑：价格行内右对齐，打开编辑弹窗 -->
            <view class="alert-card-editbtn" data-id="{{item.id}}" catchtap="onEdit">编辑</view>
          </view>

          <view class="alert-card-desc">{{item.desc}}</view>
        </view>
      </view>

      <!-- 空态 -->
      <base-empty wx:else icon="BellOutline" text="暂无提醒" />
    </scroll-view>
  </view>

  <!-- 底部操作区 -->
  <view class="bottom-btn" style="bottom: {{bottomGap}}px;">
    <view class="add-btn" bindtap="onAdd">
      <ant-icon type="AddOutline" style="font-size:36rpx;color:#FFFFFF;" />
      <text class="add-btn-text">新增提醒</text>
    </view>
  </view>

  <base-toast id="base-toast" />

  <!-- 删除确认（自研弹层，危险色确认） -->
  <base-popup
    visible="{{deleteVisible}}"
    mode="center"
    title="删除提醒"
    desc="{{deleteDesc}}"
    confirm-text="删除"
    cancel-text="取消"
    confirm-danger="{{true}}"
    bind:confirm="confirmDelete"
    bind:cancel="cancelDelete"
    bind:mask="cancelDelete"
  />

  <!-- ========== 新增/编辑提醒弹窗（base-popup center 承载表单） ========== -->
  <base-popup
    visible="{{popupVisible}}"
    mode="center"
    title="{{editingId ? '编辑提醒' : '新增提醒'}}"
    confirm-text="{{editingId ? '保存修改' : '确认添加'}}"
    cancel-text="取消"
    bind:confirm="onPopupConfirm"
    bind:cancel="onPopupCancel"
    bind:mask="onPopupCancel"
  >
    <view slot="content" class="alert-form">
      <!-- ===== 区域 1：选股 =====
           编辑模式股票固定不可换（后端不支持改提醒的股票代码），
           只显示只读已选行；新增模式才有搜索框与可清除的已选行 -->
      <block wx:if="{{!editingId}}">
      <view class="search-field">
        <view class="form-label">选择股票</view>
        <view class="input-wrap">
          <input
            class="form-input"
            value="{{searchKeyword}}"
            placeholder="股票代码/名称/拼音"
            placeholder-class="form-input-placeholder"
            bindinput="onSearchInput"
          />
          <!-- 清除按钮：原生 input 没有内建清除，自绘一个 -->
          <view wx:if="{{searchKeyword}}" class="input-clear" bindtap="onSearchClear">
            <ant-icon type="CloseOutline" style="font-size:24rpx;color:var(--ink-3);" />
          </view>
        </view>
        <!-- 下拉联想结果 -->
        <view class="search-dropdown" wx:if="{{searchResults.length > 0}}">
          <view
            class="search-item"
            wx:for="{{searchResults}}"
            wx:for-item="item"
            wx:key="code"
            data-code="{{item.code}}"
            data-name="{{item.name}}"
            data-market="{{item.market}}"
            bindtap="onSelectStock"
          >
            <text class="search-item-name">{{item.name}}</text>
            <text class="search-item-code num">{{item.market}}{{item.code}}</text>
          </view>
        </view>
      </view>

      <!-- 已选中股票：点右侧 x 清除重新选 -->
      <view wx:if="{{selectedStock}}" class="selected-stock" bindtap="onClearStock">
        <text class="selected-stock-text num">{{selectedStock.name}} ({{selectedStock.market}}{{selectedStock.code}})</text>
        <ant-icon type="CloseOutline" style="font-size:32rpx;color:var(--ink-3);" />
      </view>
      </block>

      <!-- 编辑模式：股票只读展示，不可更换 -->
      <view wx:if="{{editingId}}" class="selected-stock">
        <text class="selected-stock-text num">{{selectedStock.name}} ({{selectedStock.code}})</text>
      </view>

      <!-- ===== 区域 2：触发条件 =====
           原生 picker（mode="selector"）：触发区就是这行自绘内容，
           点击后由客户端弹出半屏滚轮，视觉完全可控。
           注意 bindchange 传回的 detail.value 是「数组索引」不是业务值，
           映射逻辑见 alerts.js 的 onConditionChange（执行指南 4.3 坑 1） -->
      <view class="form-section">
        <picker
          class="option-picker"
          mode="selector"
          range="{{conditionOptions}}"
          range-key="label"
          value="{{conditionIndex}}"
          bindchange="onConditionChange"
        >
          <view class="option-row">
            <text class="option-label">触发条件</text>
            <view class="option-value">
              <text class="option-value-text">{{conditionText}}</text>
              <ant-icon type="RightOutline" style="font-size:28rpx;color:var(--ink-3);" />
            </view>
          </view>
        </picker>
      </view>

      <!-- ===== 区域 3：阈值（单位跟在输入框尾部） ===== -->
      <view class="form-section">
        <view class="form-label">阈值</view>
        <view class="input-wrap">
          <input
            class="form-input"
            type="digit"
            value="{{threshold}}"
            placeholder="{{thresholdPlaceholder}}"
            placeholder-class="form-input-placeholder"
            bindinput="onThresholdInput"
            bindblur="onThresholdBlur"
          />
          <text class="input-unit num">{{thresholdUnit}}</text>
        </view>
      </view>

      <!-- 成交量类额外显示基准选择：同样用原生 picker。
           range 是静态数组、不随其它列联动，因此不存在「更新 range 后
           重置后续列索引」的问题（执行指南 4.3 坑 2）；本页也没有
           选项级置灰需求（坑 3） -->
      <view wx:if="{{conditionType === 'volume'}}" class="form-section">
        <picker
          class="option-picker"
          mode="selector"
          range="{{volumeBaseOptions}}"
          range-key="label"
          value="{{volumeBaseIndex}}"
          bindchange="onVolumeBaseChange"
        >
          <view class="option-row">
            <text class="option-label">基准周期</text>
            <view class="option-value">
              <text class="option-value-text">{{volumeBaseText}}</text>
              <ant-icon type="RightOutline" style="font-size:28rpx;color:var(--ink-3);" />
            </view>
          </view>
        </picker>
      </view>

      <!-- 检查频率 -->
      <view class="form-section">
        <picker
          class="option-picker"
          mode="selector"
          range="{{frequencyOptions}}"
          range-key="label"
          value="{{frequencyIndex}}"
          bindchange="onFrequencyChange"
        >
          <view class="option-row">
            <text class="option-label">检查频率</text>
            <view class="option-value">
              <text class="option-value-text">{{frequencyText}}</text>
              <ant-icon type="RightOutline" style="font-size:28rpx;color:var(--ink-3);" />
            </view>
          </view>
        </picker>
      </view>
    </view>
  </base-popup>
</view>
