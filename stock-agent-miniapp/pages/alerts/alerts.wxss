/* ===== 页面骨架 ===== */
.page {
  display: flex;
  flex-direction: column;
  height: 100%;
  overflow: hidden;
  background: var(--bg);
  position: relative;
}

.content {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  padding: 0 var(--space-xl);
}

/* ===== 概览宫格 =====
   两格共用一张卡：并排两个框会让「全部 / 今日触发」看起来像两个独立模块 */
.overview {
  flex: none;
  display: flex;
  background: var(--surface);
  border: var(--hairline);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}

/* 单格：标签在上、数字在下，数字明显压过标签 */
.overview-cell {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  padding: var(--space-lg) var(--space-lg);
}

/* 格间竖分割线：class 由 wxml 按行号算（WXSS 禁兄弟选择器） */
.overview-cell--sep {
  border-left: var(--hairline);
}

.g-num {
  font-size: var(--font-lg);   /* 宫格数字：大号 */
  font-weight: 600;
  line-height: 1.1;
  color: var(--ink);
}

.g-label {
  font-size: var(--font-base);   /* 全部提醒 / 今日触发：普通 */
  color: var(--ink-2);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

/* ===== 分组标题 ===== */
.group-title {
  flex: none;
  margin: var(--space-xl) 0 var(--space-md);
  font-size: var(--font-base);   /* 价格与涨幅提醒：普通 */
  font-weight: 600;
  color: var(--ink-2);
}

/* ===== 列表滚动区 =====
   底边让开悬浮的「新增提醒」按钮：按钮距底 20 + 按钮高 48 + 与按钮间距 16 = 84，再加安全区。
   必须用 margin 而不是 padding：padding 会计入 scroll-view 的滚动内容高度，
   结果只有一条提醒也会被撑出可滚动距离（能空拖一段） */
.list-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
  margin-bottom: var(--space-2xl);
  margin-bottom: calc(84px + env(safe-area-inset-bottom)); /* 间距条例外：底部按钮让位值，与 JS 的 bottomGap 配套；calc+env 是安全区唯一合法非 rpx 写法 */
}

.alert-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
}

/* ===== 提醒卡 =====
   顶部不留内边距：头部热区比行高略高，否则名字上方会空出一截。
   overflow 裁掉子元素溢出，编辑/删除的 88rpx 热区不会顶到卡片外面 */
.alert-card {
  padding: 0 var(--space-lg) var(--space-lg);
  background: var(--surface);
  border: var(--hairline);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}

.alert-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-md);
}

.alert-card-name {
  font-size: var(--font-base);
  font-weight: 600;
  color: var(--ink);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

/* 名称后的代码（别名）：全局小号 */
.alert-card-code {
  margin-left: var(--space-md);
  font-size: var(--font-sm);
  font-weight: 400;
  color: var(--ink-3);
}

/* 头部右侧的两个文字入口：编辑在左、删除在右 */
.alert-card-actions {
  display: flex;
  align-items: center;
  flex: none;
  gap: var(--space-lg);
}

/* 文字按键的统一热区：24rpx 字撑不出 88rpx，靠 min-height 补。
   热区保持 88rpx（44px），上下各 -12rpx 的负边距把行高收到 64rpx，
   点击范围不变、第一行变紧凑 */
.alert-card-editbtn {
  display: flex;
  align-items: center;
  flex: none;
  min-height: 88rpx;
  margin: calc(-1 * var(--space-sm)) 0;
  font-size: var(--font-sm);
  color: var(--ink-2);
}

/* 阈值行：等宽 + 涨跌色。字号降到 hero 档，行高随图标一起收，
   不再用 display 64 把卡片撑长；仍是卡内最大的数字 */
.alert-card-price {
  display: flex;
  align-items: center;
  gap: var(--space-md);
}

/* 删除入口：头部最外侧纯文字，危险红；与编辑键同样负边距收行高 */
.alert-card-delbtn {
  display: flex;
  align-items: center;
  flex: none;
  min-height: 88rpx;
  margin: calc(-1 * var(--space-sm)) 0;
  font-size: var(--font-sm);
  color: var(--danger);
}

.alert-card-price-text {
  font-size: var(--font-xl);
  font-weight: 600;
  line-height: 1.15;
}

/* 第三行：左条件、右检查频率，两端对齐。
   原来两项挤在一句里用「·」连接，频率跟着条件长度飘，看不出是一组固定信息 */
.alert-card-desc {
  margin-top: var(--space-xs);
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-lg);
  font-size: var(--font-sm);
  color: var(--ink-2);
  line-height: 1.4;
}

.alert-card-cond {
  flex: 1;
  min-width: 0;
}

.alert-card-freq {
  flex: none;
  color: var(--ink-3);
  white-space: nowrap;
}

/* ===== 底部「新增提醒」 ===== */
.bottom-btn {
  position: absolute;
  left: var(--space-xl);
  right: var(--space-xl);
}

/* 底部主按钮：无填充，描边与输入框同款（--hairline），主次靠字色与字重 */
.add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-xs);
  height: 96rpx;
  border-radius: var(--radius-sm);
  background: transparent;
  border: var(--hairline);
  box-shadow: var(--shadow-sm);
}

.add-btn-text {
  font-size: var(--font-lg);   /* 底部主行动点：全局大号 */
  font-weight: 600;
  color: var(--ink);
}

/* ===== 新增提醒表单 ===== */
.form-section {
  margin-top: var(--space-xl);
}

.form-label {
  margin-bottom: var(--space-xs);
  font-size: var(--font-sm);
  color: var(--ink-3);
}

/* 输入行：输入框 + 尾部单位 / 清除按钮 */
.input-wrap {
  position: relative;
}

.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 var(--space-lg);
  box-sizing: border-box;
  font-size: var(--font-base);
  color: var(--ink);
  background: transparent;
  border: var(--hairline);
  border-radius: var(--radius-sm);
  box-shadow: var(--shadow-sm);
}

/* 带尾部单位时给右侧留位 */
.input-unit {
  position: absolute;
  right: var(--space-lg);
  top: 50%;
  transform: translateY(-50%);
  font-size: var(--font-sm);
  color: var(--ink-3);
  pointer-events: none;
}

.input-clear {
  position: absolute;
  right: var(--space-md);
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--radius-round);
}

.form-input-placeholder {
  color: var(--ink-3);
  font-size: var(--font-base);
}

/* 已选股票行（可点，同按键规格） */
.selected-stock {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-md);
  min-height: 88rpx;
  margin-top: var(--space-lg);
  padding: var(--space-md) var(--space-lg);
  background: transparent;
  border: var(--hairline);
  border-radius: var(--radius-sm);
  box-shadow: var(--shadow-sm);
}

.selected-stock-text {
  font-size: var(--font-sm);
  color: var(--ink);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

/* 带标题的选择器行（可点，同按键规格） */
.option-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-md);
  min-height: 96rpx;
  padding: var(--space-md) var(--space-lg);
  background: transparent;
  border: var(--hairline);
  border-radius: var(--radius-sm);
  box-shadow: var(--shadow-sm);
}

/* 原生 picker 触发区（按压态按需求取消，不再有 --hover 变暗） */
.option-picker {
  display: block;
  width: 100%;
}

.option-picker.option-row--hover .option-row {
  border-color: var(--line);
}

.option-label {
  font-size: var(--font-base);
  color: var(--ink);
}

.option-value {
  display: flex;
  align-items: center;
  gap: var(--space-xs);
  flex: none;
}

.option-value-text {
  font-size: var(--font-sm);
  color: var(--ink-2);
}

/* ===== 代码联想下拉 ===== */
.search-field {
  position: relative;
}

.search-dropdown {
  position: absolute;
  left: 0;
  right: 0;
  top: 100%;
  margin-top: var(--space-xs);
  background: var(--surface);
  border: var(--hairline);
  border-radius: var(--radius-sm);
  box-shadow: var(--shadow-md);
  overflow: hidden;
  z-index: 10;
}

.search-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-md) var(--space-lg);
  border-bottom: var(--hairline);
}

.search-item:last-child {
  border-bottom: none;
}

.search-item-name {
  font-size: var(--font-base);
  color: var(--ink);
}

/* 下拉里的代码（别名）：全局小号 */
.search-item-code {
  font-size: var(--font-sm);
  color: var(--ink-3);
}
