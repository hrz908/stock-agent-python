/* ===== 页面骨架 ===== */
.page {
  display: flex;
  flex-direction: column;
  height: 100%;
  overflow: hidden;
  background: var(--bg);
  position: relative;
}

.content {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  padding: 0 var(--sp-4);
}

/* ===== 概览宫格（替代 t-grid card 主题） ===== */
.overview {
  flex: none;
  display: flex;
  gap: var(--gap-grid);
}

/* 单格内部左右对齐：文字靠左、数字靠右 */
.overview-cell {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-2);
  padding: var(--sp-3) var(--pad-card);
  background: var(--surface);
  border: var(--hairline);
  border-radius: var(--r-card);
}

.g-num {
  flex: none;
  font-size: var(--fs-hero);
  font-weight: 400;
  line-height: 1.1;
  color: var(--ink);
  text-align: right;
}

/* 标签文字：加大一档（caption -> body），不加粗 */
.g-label {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-body);
  font-weight: 400;
  color: var(--ink);
  text-align: left;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

/* ===== 分组标题 ===== */
.group-title {
  flex: none;
  margin: var(--sp-4) 0 var(--sp-2);
  font-size: var(--fs-aux);
  font-weight: 600;
  color: var(--ink-2);
}

/* ===== 列表滚动区 =====
   底边让开悬浮的「新增提醒」按钮：按钮距底 20 + 按钮高 48 + 与按钮间距 16 = 84，再加安全区。
   必须用 margin 而不是 padding：padding 会计入 scroll-view 的滚动内容高度，
   结果只有一条提醒也会被撑出可滚动距离（能空拖一段） */
.list-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
  margin-bottom: var(--sp-5);
  margin-bottom: calc(84px + env(safe-area-inset-bottom)); /* 间距条例外：底部按钮让位值，与 JS 的 bottomGap 配套；calc+env 是安全区唯一合法非 rpx 写法 */
}

.alert-list {
  display: flex;
  flex-direction: column;
  gap: var(--gap-grid);
}

/* ===== 提醒卡 ===== */
.alert-card {
  padding: var(--sp-3);
  background: var(--surface);
  border: var(--hairline);
  border-radius: var(--r-card);
  min-height: 80rpx;
}

.alert-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--sp-2);
}

.alert-card-name {
  font-size: var(--fs-body);
  font-weight: 600;
  color: var(--ink);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

.alert-card-code {
  margin-left: var(--sp-2);
  font-size: var(--fs-aux);
  font-weight: 400;
  color: var(--ink-3);
}

/* 编辑入口：价格行内右对齐的纯文字按键（打开编辑弹窗） */
.alert-card-editbtn {
  flex: none;
  margin-left: auto;
  padding: var(--sp-1) 0 var(--sp-1) var(--sp-3);
  font-size: var(--fs-aux);
  color: var(--ink-2);
}

/* 大号阈值：价格级字号，等宽 + 涨跌色；行尾放删除按键 */
.alert-card-price {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  margin-top: var(--sp-2);
}

/* 删除入口：头部右上角纯文字（已移除垃圾桶图标），危险红 */
.alert-card-delbtn {
  flex: none;
  padding: var(--sp-1) 0 var(--sp-1) var(--sp-3);
  font-size: var(--fs-aux);
  color: var(--danger);
}

.alert-card-price-text {
  font-size: var(--fs-hero);
  font-weight: 700;
  line-height: 1.1;
}

.alert-card-desc {
  margin-top: var(--sp-1);
  font-size: var(--fs-aux);
  color: var(--ink-2);
  line-height: 1.4;
  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden;
}

/* ===== 底部「新增提醒」 ===== */
.bottom-btn {
  position: absolute;
  left: var(--sp-4);
  right: var(--sp-4);
}

/* 底部主按钮：shadcn 近黑底白字（原主行动蓝已按 DESIGN.md「强调色收口」
   降级为链接/选中态专用，主按钮不再用蓝；重投影一并去除） */
.add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--sp-1);
  height: 96rpx;
  border-radius: var(--r-card);
  background: var(--ink);
  box-shadow: var(--shadow-card);
}

.add-btn-text {
  font-size: var(--fs-body);
  font-weight: 600;
  /* 蓝底按钮上的文字反白（原金色底用深色字，主题切蓝后必须跟着换） */
  color: var(--primary-fg); /* 深色底上的浅色文字 */
}

/* ===== 新增提醒表单 ===== */
.form-section {
  margin-top: var(--sp-4);
}

.form-label {
  margin-bottom: var(--sp-1);
  font-size: var(--fs-aux);
  color: var(--ink-3);
}

/* 输入行：输入框 + 尾部单位 / 清除按钮 */
.input-wrap {
  position: relative;
}

.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 var(--sp-3);
  box-sizing: border-box;
  font-size: var(--fs-body);
  color: var(--ink);
  background: var(--surface-2);
  border: var(--hairline);
  border-radius: var(--r-tag);
}

/* 带尾部单位时给右侧留位 */
.input-unit {
  position: absolute;
  right: var(--sp-3);
  top: 50%;
  transform: translateY(-50%);
  font-size: var(--fs-aux);
  color: var(--ink-3);
  pointer-events: none;
}

.input-clear {
  position: absolute;
  right: var(--sp-2);
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
}

.form-input-placeholder {
  color: var(--ink-3);
  font-size: var(--fs-body);
}

/* 已选股票行 */
.selected-stock {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-2);
  margin-top: var(--sp-3);
  padding: var(--sp-2) var(--sp-3);
  background: var(--surface-2);
  border: var(--hairline);
  border-radius: var(--r-tag);
}

.selected-stock-text {
  font-size: var(--fs-aux);
  color: var(--ink);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

/* 带标题的选择器行（替代 t-cell + arrow） */
.option-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sp-2);
  min-height: 96rpx;
  padding: var(--sp-2) var(--sp-3);
  background: var(--surface-2);
  border: var(--hairline);
  border-radius: var(--r-tag);
}

/* 原生 picker 触发区（按压态按需求取消，不再有 --hover 变暗） */
.option-picker {
  display: block;
  width: 100%;
}

.option-picker.option-row--hover .option-row {
  border-color: var(--line);
}

.option-label {
  font-size: var(--fs-body);
  color: var(--ink);
}

.option-value {
  display: flex;
  align-items: center;
  gap: var(--sp-1);
  flex: none;
}

.option-value-text {
  font-size: var(--fs-aux);
  color: var(--ink-2);
}

/* ===== 代码联想下拉 ===== */
.search-field {
  position: relative;
}

.search-dropdown {
  position: absolute;
  left: 0;
  right: 0;
  top: 100%;
  margin-top: var(--sp-1);
  background: var(--surface);
  border: var(--hairline);
  border-radius: var(--r-tag);
  box-shadow: var(--shadow-pop);
  overflow: hidden;
  z-index: 10;
}

.search-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--sp-2) var(--sp-3);
  border-bottom: var(--hairline);
}

.search-item:last-child {
  border-bottom: none;
}

.search-item-name {
  font-size: var(--fs-body);
  color: var(--ink);
}

.search-item-code {
  font-size: var(--fs-aux);
  color: var(--ink-3);
}
