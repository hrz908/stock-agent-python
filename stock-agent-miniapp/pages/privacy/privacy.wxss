/* 隐私说明：纯文字长页，靠字号与间距分层级，不加卡片外框。
   底部留安全区，避免最后一行贴住 iPhone 的横条 */
.page {
  display: flex;
  flex-direction: column;
  height: 100%;
  overflow: hidden;
  background: var(--bg-page);
  position: relative;
}

.body {
  flex: 1;
  min-height: 0;
}

.inner {
  padding: var(--space-lg) var(--space-lg) calc(var(--space-lg) + env(safe-area-inset-bottom));
}

.meta {
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

.sec {
  margin-top: var(--space-lg);
}

.h {
  font-size: var(--font-base);
  font-weight: 600;
  line-height: 1.5;
  color: var(--text-primary);
}

.p {
  margin-top: var(--space-md);
  font-size: var(--font-base);     /* 隐私说明正文：标准 */
  line-height: 1.8;
  color: var(--text-primary);
  word-break: break-word;
}

/* 待补充项要显眼：这是上线前必须清掉的占位，不能当成普通正文混过去 */
.p--todo {
  color: var(--warning);
}

.tail {
  margin-top: var(--space-lg);
  font-size: var(--font-sm);
  line-height: 1.7;
  color: var(--text-hint);
}
