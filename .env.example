# 本地开发环境变量模板：cp .env.example .env 后按需填值
#
# - 真实 .env 被 git 忽略，固定放仓库根（`scripts/dev.sh dev` 只认这里；
#   服务端 load_config 还兼容旧的 src/gateway/.env 与 server/.env，但别再用）
# - 生产用 deploy/.env.production.example，键更全（rerank / 池上限 / ashare 采集等）
# - 这里留空的项都是"不填也能起来，但对应功能不可用"

ENV=dev

# ===== 必填：登录与问答 =====
# 签名密钥；dev 下不给也能起（prod 会拒绝启动）
JWT_SECRET=local-dev-secret-32bytes
# 问答必需：缺了对话会返回 error 事件（行情/自选/提醒不受影响）
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
SMALL_MODEL=deepseek-ai/DeepSeek-V4.1-Flash

# ===== 依赖地址（与 deploy/compose/dev.yml 的端口映射一致）=====
DSN=postgres://postgres:postgres@localhost:5432/stock_agent?sslmode=disable
REDIS_ADDR=127.0.0.1:6379

# ===== 向量（agent 检索与 ingest 写库必须同模型同维度）=====
ONLINE_EMBED_MODEL=Qwen/Qwen3-Embedding-4B
OFFLINE_EMBED_MODEL=Qwen/Qwen3-Embedding-4B
EMBED_DIM=1536

# ===== 小程序登录（都不填时 dev 退化为演示账号；prod 拒绝启动）=====
WECHAT_APPID=
WECHAT_SECRET=

# ===== 提醒推送（三项齐全才生效，否则只落站内）=====
WECOM_CORP_ID=
WECOM_SECRET=
WECOM_AGENT_ID=
WECOM_WEBHOOK=
